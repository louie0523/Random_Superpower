      m_Items: []
  - m_Id: 5452611497603073
    m_Localized: "Queima o alvo por {d0} segundos, causando {v0}% da sua sa\xFAde
      m\xE1xima como dano fixo a cada segundo e reduzindo sua velocidade de ataque
      em {v1}%."
    m_Metadata:
      m_Items: []
  - m_Id: 5452611497603074
    m_Localized: envenenamento
    m_Metadata:
      m_Items: []
  - m_Id: 5452611497603075
    m_Localized: "Envenena o alvo por {d0} segundos, causando {v0}% da vida m\xE1xima
      de dano por segundo por ac\xFAmulo. (M\xE1ximo de {s0} ac\xFAmulos)"
    m_Metadata:
      m_Items: []
  - m_Id: 5452611497603076
    m_Localized: corte
    m_Metadata:
      m_Items: []
  - m_Id: 5452611497603077
    m_Localized: "Todos os efeitos de cura recebidos pelo alvo s\xE3o reduzidos em
      {v0}% por {d0} segundos."
    m_Metadata:
      m_Items: []
  - m_Id: 5452611497603078
    m_Localized: "trov\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 5452611497603079
    m_Localized: "Ao acertar, h\xE1 uma chance de {c0}% de que o alvo fique atordoado
      por {d0} segundos."
    m_Metadata:
      m_Items: []
  - m_Id: 5452611497603080
    m_Localized: "Linhagem sangu\xEDnea"
    m_Metadata:
      m_Items: []
  - m_Id: 5452611497603081
    m_Localized: "Voc\xEA n\xE3o pode drenar roubo de vida com esta arma. Em vez
      disso, ela causa dano adicional igual a {v0}% do valor de drenagem."
