  - m_Id: 15224945322340415
    m_Localized: "\u0422\u0435\u043D\u044C\u044E \u0441\u043B\u0435\u0434\u0443\u0435\u0442
      \u0422\u0435\u043D\u0435\u0432\u043E\u0439 \u0421\u0442\u0440\u0430\u043D\u043D\u0438\u043A.\n\n\u0412\u043D\u0435
      \u0431\u043E\u044F \u043D\u0430\u043A\u0430\u043F\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      <b>\u0422\u044C\u043C\u0430</b> \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      {b:DarkChargeTime:all} \u0441\u0435\u043A\u0443\u043D\u0434.\n\n\u041F\u0440\u0438
      \u0430\u0442\u0430\u043A\u0435 \u0432\u0440\u0430\u0433\u0430, \u0435\u0441\u043B\u0438
      <b>\u0422\u044C\u043C\u0430</b> \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u0430,
      \u043E\u0441\u043B\u0435\u043F\u0438\u0442\u0435 \u0446\u0435\u043B\u044C \u043D\u0430
      {b:BlindTime:all} \u0441\u0435\u043A\u0443\u043D\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340416
    m_Localized: "\u0422\u0435\u043D\u0435\u0432\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435"
