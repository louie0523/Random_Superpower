  Icon: {fileID: 21300000, guid: 5955f04a04b11bb40807727f4886fd0a, type: 3}
  Flavor: "\uB2F9\uC2E0\uC740 \uC624\uB798\uC804 \uC0AC\uB9DD\uD558\uC600\uC9C0\uB9CC,
    \uBAA8\uC885\uC758 \uC774\uC720\uB85C \uB418\uB3CC\uC544\uC628 \uC790 \uC785\uB2C8\uB2E4.\n\uC8FD\uC74C\uC758
    \uAE30\uC0AC\uB294 \uBD80\uC5EC\uB41C '\uC774\uB984'\uC5D0 \uB530\uB77C \uB2A5\uB825\uC774
    \uBCC0\uD569\uB2C8\uB2E4.\n\uADF8\uC800 \uB18D\uBBFC\uC774\uC600\uC744\uC9C0\uB3C4,
    \uC704\uB300\uD55C \uC790\uC600\uC744 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
  Passives:
  - Name: "\uB9DD\uB839"
    Icon: {fileID: 0}
    Description: "\uBB34\uC791\uC704\uB85C '\uC774\uB984' \uD558\uB098\uAC00 \uBD80\uC5EC\uB429\uB2C8\uB2E4.\n'\uC774\uB984'\uC5D0
      \uB530\uB77C \uCD94\uAC00 \uB2A5\uB825\uCE58 \uBC0F \uC2A4\uD0AC\uC758 \uD6A8\uACFC\uAC00
      \uBCC0\uD654\uD569\uB2C8\uB2E4.\n\uD604\uC7AC \uC774\uB984 : {x:nametag}"
