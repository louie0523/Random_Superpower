    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534710
    m_Localized: Jadikan targetnya sebagai 'kawan seperjuangan'.
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534722
    m_Localized: Napas Akhir
    m_Metadata:
      m_Items: []
  - m_Id: 15311903037960192
    m_Localized: William
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903232
    m_Localized: daerah
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903233
    m_Localized: Thomas
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903234
    m_Localized: Henry
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903235
    m_Localized: Robert
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903236
    m_Localized: Serigala
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903237
    m_Localized: Hakon
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903238
    m_Localized: Eric
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903239
    m_Localized: Arthur
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903240
    m_Localized: "<b>Pedang Suci yang Terjalin</b> \u2014 {b:ArthurTrueRatio:pct}%
      dari kerusakan mengabaikan armor."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903241
    m_Localized: "<b>Charge</b> \u2014 Kecepatan pengisian daya meningkat, dan musuh
      yang terkena akan terkena efek setrum selama {b:ArthurStun} detik."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903242
    m_Localized: "<b>Seonghwi</b> \u2014 Menimbulkan kerusakan tambahan sebesar {dmg:ArthurBlastCoef}
      dalam radius ledakan."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903243
    m_Localized: Roland
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903244
    m_Localized: "<b>Durandal</b> \u2014 Kekuatan meningkat sebesar {b:RolandBonusPct}%
      dan memberikan kerusakan tambahan yang setara dengan {b:RolandMissingPct}%
      dari kesehatan target yang hilang."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903245
    m_Localized: "<b>Lompat</b> \u2014 Tekan lagi saat menunggangi hewan untuk melompat
      alih-alih berlari, mendorong mundur musuh dalam radius {b:RolandPushRadius}m
      dan memulihkan {b:RolandHealMissingPct}% dari kesehatan Anda yang hilang."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903246
    m_Localized: "<b>Penghakiman</b> \u2014 Kerusakan frontal meningkat sebesar {b:RolandFinisherCoef}%
      dari Kekuatan Serangan, dan musuh yang terkena akan terkena efek setrum selama
      {b:RolandStun} detik."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903247
    m_Localized: Bernhard
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097536
    m_Localized: "<b>Final</b> \u2014 Kekuatan meningkat sebesar {b:BernhardBonusPct}%,
      dan target yang terkena menjadi Luka Parah {b:BernhardWoundPct}% selama {b:BernhardWoundTime}
      detik."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097537
    m_Localized: "<b>Serangan Hantu</b> \u2014 Tekan lagi saat menunggangi untuk
      menyerang dalam wujud Hantu, meningkatkan kekuatan serangan sebesar {b:BernhardChargePct}%."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097538
    m_Localized: "<b>Api Maut</b> \u2014 Menimbulkan luka bakar hebat pada musuh
      yang terkena ledakan, mengurangi {b:DeathFlameTime}% dari kesehatan maksimal
      mereka setiap detik selama {b:DeathFlamePct} detik."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097539
    m_Localized: petani
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097540
    m_Localized: "<b>Tanaman</b> \u2014 Pulihkan {b:FarmHealPct}% dari kerusakan
      yang ditimbulkan"
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097541
    m_Localized: "<b>Penunggang Kuda Tidak Terampil</b> \u2014 Peningkatan kecepatan
      gerakan -{b:Penalti Tidak Terampil}"
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097542
    m_Localized: mata duitan
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097543
    m_Localized: "<b>Pertanian</b> \u2014 Memulihkan {b:FarmHealPct}% dari kerusakan
      yang ditimbulkan\n<b>Indra Tempur</b> \u2014 Tak lama kemudian, tebas lagi
      dengan kekuatan {b:SecondMul:pct}%"
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097544
    m_Localized: "<b>Penunggang Kuda Tidak Terampil</b> \u2014 Peningkatan kecepatan
      gerakan -{b:Penalti Tidak Terampil}"
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097545
    m_Localized: Bernama
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097546
    m_Localized: "<b>Pertanian</b> \u2014 Memulihkan {b:FarmHealPct}% dari kerusakan
      yang ditimbulkan\n<b>Indra Tempur</b> \u2014 Tak lama kemudian, tebas lagi
      dengan kekuatan {b:SecondMul:pct}%"
    m_Metadata:
      m_Items: []
