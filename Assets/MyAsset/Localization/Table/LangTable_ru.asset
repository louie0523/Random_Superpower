  - m_Id: 15224945322340376
    m_Localized: "\u041F\u0440\u0438\u0431\u043B\u0438\u0437\u044C\u0442\u0435 \u043F\u0440\u0438\u0446\u0435\u043B
      \u043D\u0430 {b:AimTimeout} \u0441\u0435\u043A\u0443\u043D\u0434 \u0438 \u0437\u0430\u043C\u0435\u0434\u043B\u0438\u0442\u0435
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F.\n\n\u0412\u043C\u0435\u0441\u0442\u043E
      \u044D\u0442\u043E\u0433\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B \u043D\u0430\u043D\u0435\u0441\u0435\u0442
      {b:AimBonusPct:all}% \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u0443\u0440\u043E\u043D\u0430 \u043F\u0440\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438
      \u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442
      \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0443\u0434\u0430\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340378
    m_Localized: "\u041F\u0435\u0440\u0435\u0439\u0434\u0438\u0442\u0435 \u0432 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435
      \xAB\u0420\u0430\u0441\u043F\u044B\u043B\u0435\u043D\u0438\u0435\xBB \u043D\u0430
      12 \u0441\u0435\u043A\u0443\u043D\u0434, \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044F
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0430\u0442\u0430\u043A\u0438
      \u043D\u0430 {b:UltAtkSpeedPct:all}% \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u044F
      20% \u0432\u0430\u043C\u043F\u0438\u0440\u0438\u0437\u043C\u0430. \u0412 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      \u044D\u0442\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043F\u0440\u0438
      \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0435 \u0438\u0437 \u043E\u0440\u0443\u0436\u0438\u044F
      \u0440\u0430\u0437\u0431\u0440\u043E\u0441 \u043F\u0443\u043B\u044C \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 30%, \u0432\u043C\u0435\u0441\u0442\u043E \u0442\u043E\u0433\u043E
      \u0447\u0442\u043E\u0431\u044B \u0440\u0438\u043A\u043E\u0448\u0435\u0442\u0438\u0442\u044C
      {b:UltRicochets:all} \u0440\u0430\u0437 \u043E\u0442 \u0441\u0442\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340379
