    m_Localized: "\u6301\u7E8C{b:UltDuration}\u79D2\uFF0C\u4F60\u7684\u8EAB\u9AD4\u5C07\u88AB\u706B\u7130\u5305\u88F9\uFF0C\u9032\u5165\u300C\u706B\u7130\u5F8C\u88D4\u300D\u72C0\u614B\u3002\n\n\u8FD1\u6230\u653B\u64CA\u547D\u4E2D\u4F60\u7684\u6575\u4EBA\u6703\u53D7\u5230\u707C\u71D2\u6548\u679C\uFF0C\u6240\u6709\u7269\u54C1\u6548\u679C\u63D0\u534725%\u3002\u6B64\u5916\uFF0C\u6BCF\u7576\u4F60\u7684\u751F\u547D\u503C\u4E0B\u964D15%\u6642\uFF08\u4F8B\u598285%\u300170%\u300155%\u7B49\uFF09\uFF0C\u300C\u7194\u7210\u300D\u7684\u51B7\u537B\u6642\u9593\u90FD\u6703\u91CD\u7F6E\u3002"
