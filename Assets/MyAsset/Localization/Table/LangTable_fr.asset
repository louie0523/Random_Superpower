    m_Localized: "Appuyez une nouvelle fois pour r\xE9initialiser"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560567
    m_Localized: "Notions de base du syst\xE8me"
    m_Metadata:
      m_Items: []
