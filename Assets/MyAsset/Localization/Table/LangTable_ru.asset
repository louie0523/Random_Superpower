  - m_Id: 15224945322340417
    m_Localized: "\u0410\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442 \u0422\u0435\u043D\u0435\u0432\u043E\u0435
      \u041E\u0440\u0443\u0436\u0438\u0435 \u043D\u0430 {b:WeaponDuration:all} \u0441\u0435\u043A\u0443\u043D\u0434.\n\n\u041F\u0440\u0438
      \u0430\u0442\u0430\u043A\u0435 \u044D\u0442\u0438\u043C \u043E\u0440\u0443\u0436\u0438\u0435\u043C
      \u0432\u0430\u0448\u0430 \u0438\u043B\u043B\u044E\u0437\u0438\u044F \u0430\u0442\u0430\u043A\u0443\u0435\u0442
      \u0432 \u0442\u043E\u043C \u0436\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438
      \u0442\u0435\u043C \u0436\u0435 \u043E\u0440\u0443\u0436\u0438\u0435\u043C
      \u043F\u043E\u0441\u043B\u0435 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438, \u043D\u0430\u043D\u043E\u0441\u044F
      {b:EchoPct:all}% \u043E\u0442 \u0432\u0430\u0448\u0435\u0439 \u0431\u0430\u0437\u043E\u0432\u043E\u0439
      \u0441\u0438\u043B\u044B \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435
      \u0443\u0440\u043E\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340418
    m_Localized: "\u0412\u0440\u0430\u0433\u0438, \u043F\u043E\u043B\u0443\u0447\u0438\u0432\u0448\u0438\u0435
      \u0443\u0440\u043E\u043D \u043E\u0442 \u0422\u0435\u043D\u0435\u0432\u043E\u0433\u043E
      \u043E\u0440\u0443\u0436\u0438\u044F, \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u044E\u0442\u0441\u044F
      \u043D\u0430 10% \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 1 \u0441\u0435\u043A\u0443\u043D\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340423
    m_Localized: "\u0412\u0440\u0430\u0433, \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0439
      <b>\u0442\u0435\u043D\u0435\u0432\u043E\u0439 \u0440\u0443\u043A\u043E\u0439</b>
      \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 {b:HandImmune:all} \u0441\u0435\u043A\u0443\u043D\u0434,
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0441\u0432\u044F\u0437\u0430\u043D
      \u0434\u0440\u0443\u0433\u043E\u0439 <b>\u0442\u0435\u043D\u0435\u0432\u043E\u0439
      \u0440\u0443\u043A\u043E\u0439</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340424
    m_Localized: "\u041F\u043E\u043B\u043D\u0430\u044F \u0442\u0435\u043C\u043D\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340425
    m_Localized: "\u041E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0443\u044E
      \u043E\u0431\u043B\u0430\u0441\u0442\u044C \u043A\u0430\u043A <b>\u0422\u0435\u043D\u0435\u0432\u0443\u044E
      \u0437\u043E\u043D\u0443</b>, \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u044F \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0438 \u0432\u0440\u0430\u0433\u043E\u0432
      \u0432\u043D\u0443\u0442\u0440\u0438 \u0437\u043E\u043D\u044B, \u0437\u0430
      \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C \u0432\u0430\u0441
      \u0441\u0430\u043C\u0438\u0445.\n\n\u0412\u0440\u0430\u0433\u0438 \u0437\u0430
      \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u043C\u0438 \u0422\u0435\u043D\u0435\u0432\u043E\u0439
      \u0437\u043E\u043D\u044B \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u0432\u0438\u0434\u0435\u0442\u044C
      \u0432\u043D\u0443\u0442\u0440\u0438.\n\n\u0412\u043D\u0443\u0442\u0440\u0438
      \u0422\u0435\u043D\u0435\u0432\u043E\u0439 \u0437\u043E\u043D\u044B \u0432\u0440\u0435\u043C\u044F
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \xAB\u0422\u0435\u043D\u0435\u0432\u043E\u0435
      \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435\xBB \u0443
      \u0422\u0435\u043D\u0435\u0432\u044B\u0445 \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0440\u0430\u0432\u043D\u044B\u043C
      {b:ZoneMoveCooldown:all} \u0441\u0435\u043A\u0443\u043D\u0434\u0430\u043C,
      \u0430 \u0438\u0445 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 {b:ZoneMoveSpeedPct:all}%."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340427
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440 \u043E\u0440\u0443\u0436\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340428
    m_Localized: "\u0412\u044B \u2014 \u041C\u0430\u0441\u0442\u0435\u0440 \u041E\u0440\u0443\u0436\u0438\u044F.\n\n\u0412
      \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u0434\u0440\u0443\u0433\u0438\u0445
      \u0438\u0433\u0440\u043E\u043A\u043E\u0432, \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u043D\u043E\u0441\u0438\u0442\u044C \u0434\u043E 8 \u0435\u0434\u0438\u043D\u0438\u0446
      \u043E\u0440\u0443\u0436\u0438\u044F.\n\n\u0414\u0430\u0436\u0435 \u043A\u043E\u0433\u0434\u0430
      \u0432\u044B \u043D\u0435 \u0434\u0435\u0440\u0436\u0438\u0442\u0435 \u043E\u0440\u0443\u0436\u0438\u0435
      \u0432 \u0440\u0443\u043A\u0430\u0445, \u043E\u043D\u043E \u043F\u0430\u0440\u0438\u0442
      \u0440\u044F\u0434\u043E\u043C \u0441 \u0432\u0430\u043C\u0438 \u0438 \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442
      \u0432 \u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340429
    m_Localized: "\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435 \u041C\u0443\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340430
    m_Localized: "\u041C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043E\u0440\u0443\u0436\u0438\u044F,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u043D\u043E\u0441\u0438\u0442\u044C \u0441 \u0441\u043E\u0431\u043E\u0439,
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0434\u043E {b:SlotCount:all}."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340431
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440 \u043E\u0440\u0443\u0436\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340432
    m_Localized: "\u041E\u0440\u0443\u0436\u0438\u0435, \u043A\u0440\u043E\u043C\u0435
      \u0442\u043E\u0433\u043E, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u044B
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0435,
      \u043F\u0430\u0440\u0438\u0442 \u0440\u044F\u0434\u043E\u043C \u0441 \u0432\u0430\u043C\u0438.\n\n\u0412\u043E
      \u0432\u0440\u0435\u043C\u044F \u0431\u043E\u044F \u0430\u0442\u0430\u043A\u0443\u0439\u0442\u0435
      \u0432 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
      \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u043D\u043E\u0433\u043E \u0432\u0430\u043C\u0438
      \u0432\u0440\u0430\u0433\u0430 \u043A\u0430\u0436\u0434\u044B\u0435 {b:OrbitInterval:all}
      \u0441\u0435\u043A\u0443\u043D\u0434, \u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u0430\u0442\u0430\u043A\u0438
      \u043E\u0440\u0443\u0436\u0438\u044F, \u043D\u0430\u043D\u043E\u0441\u044F
      \u0443\u0440\u043E\u043D, \u0440\u0430\u0432\u043D\u044B\u0439 {b:OrbitCoef:all}
      + {b:WeaponAtkPct:all}% \u043E\u0442 \u0443\u0440\u043E\u043D\u0430 \u043E\u0440\u0443\u0436\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340434
    m_Localized: "\u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u043E\u043D\u0435\u0440"
