  - m_Id: 15224945322340392
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0441\u043C\u0435\u0440\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340393
    m_Localized: "\u0412\u043E\u043E\u0440\u0443\u0436\u0438\u0432\u0448\u0438\u0441\u044C
      \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044B\u043C \u043C\u0435\u0447\u043E\u043C
      \u0442\u0435\u043C\u043D\u043E\u0439 \u043C\u0430\u0433\u0438\u0438, \u043D\u0430\u043D\u0435\u0441\u0438\u0442\u0435
      \u0443\u0434\u0430\u0440 \u0432\u043D\u0438\u0437, \u043F\u0440\u0438\u0447\u0438\u043D\u0438\u0432
      \u0432\u0440\u0430\u0433\u0430\u043C \u043F\u0435\u0440\u0435\u0434 \u0441\u043E\u0431\u043E\u0439
      {dmg:FinisherCoef+FinisherFlat} \u0443\u0440\u043E\u043D\u0430 \u043E\u0440\u0443\u0436\u0438\u0435\u043C,
      \u0438 \u0441\u043F\u0440\u043E\u0432\u043E\u0446\u0438\u0440\u0443\u0439\u0442\u0435
      \u0432\u0437\u0440\u044B\u0432 \u0442\u0435\u043C\u043D\u043E\u0439 \u043C\u0430\u0433\u0438\u0438
      \u043F\u0435\u0440\u0435\u0434 \u0441\u043E\u0431\u043E\u0439, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0430\u043D\u0435\u0441\u0442\u0438 \u043C\u043E\u0449\u043D\u044B\u0439
      \u0443\u0440\u043E\u043D \u044F\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340394
    m_Localized: '{x:ult}'
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340396
    m_Localized: "\u0422\u044B \u0433\u043E\u043B\u043E\u0434\u0435\u043D.\n\n\u0418
      \u0443 \u0442\u0435\u0431\u044F \u0436\u0435\u043B\u0443\u0434\u043E\u043A,
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B\u0439 \u043F\u0440\u043E\u0433\u043B\u043E\u0442\u0438\u0442\u044C
      \u0447\u0442\u043E \u0443\u0433\u043E\u0434\u043D\u043E.\n\n\u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C
      \u043F\u0440\u043E\u0433\u043B\u043E\u0442\u0438\u0442\u044C \u0447\u0442\u043E
      \u0443\u0433\u043E\u0434\u043D\u043E \u0438 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044C\u0441\u044F
      \u0432 \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340397
    m_Localized: "\u043F\u0438\u0449\u0435\u0432\u0430\u0440\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340399
    m_Localized: "\u0421\u044A\u0435\u0448\u044C\u0442\u0435 \u043E\u0440\u0443\u0436\u0438\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C {b:AbsorbRatio:pct}% \u043E\u0442
      \u0432\u0430\u0448\u0438\u0445 \u043E\u0447\u043A\u043E\u0432 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439.\n\n{x:digest}\n\n{x:absorbed}\n\n{x:specials}"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340400
    m_Localized: "\u0412\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435
      \u0431\u043E\u043D\u0443\u0441, \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u043C\u044B\u0439
      \u043A\u0430\u043A: \u0411\u0430\u0437\u043E\u0432\u044B\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
      \u043E\u0440\u0443\u0436\u0438\u044F \xD7 \u041A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442
      \u043F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u0438\u044F {b:\u041A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442
      \u043F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u0438\u044F*100:\u0432\u0441\u0435}%
      \xD7 \u041C\u043D\u043E\u0436\u0438\u0442\u0435\u043B\u044C \u0440\u0430\u043D\u0433\u0430.\n\n\u0412\u044B
      \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u0434\u043E {b:\u041A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442
      \u043F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u0438\u044F*100:\u0432\u0441\u0435}%
      \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432 \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u044F,
      \u0430 \u0443\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u0435
      \u043E\u0441\u043E\u0431\u043E\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F
      \u0434\u0430\u0435\u0442 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0439
      \u043E\u0441\u043E\u0431\u044B\u0439 \u044D\u0444\u0444\u0435\u043A\u0442.\n\n\u0412\u0440\u0435\u043C\u044F
      \u043F\u0435\u0440\u0435\u0432\u0430\u0440\u0438\u0432\u0430\u043D\u0438\u044F
      \u0441\u043E\u043A\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0434\u043E
      {b:\u041C\u043D\u043E\u0436\u0438\u0442\u0435\u043B\u044C \u043F\u0435\u0440\u0435\u0432\u0430\u0440\u0438\u0432\u0430\u043D\u0438\u044F*100}%
      \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442
      \u0443\u0440\u043E\u0432\u043D\u044F \u043D\u0430\u0432\u044B\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340402
    m_Localized: "\u0423\u043A\u0443\u0441\u0438\u0442\u0435 \u0432\u043F\u0435\u0440\u0435\u0434,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u043D\u0435\u0441\u0442\u0438 {dmg:DevourCoef+DevourFlat}
      \u0443\u0440\u043E\u043D\u0430. \u0415\u0441\u043B\u0438 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u043D\u0430\u044F
      \u0446\u0435\u043B\u044C \u0443\u043C\u0440\u0435\u0442 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      1 \u0441\u0435\u043A\u0443\u043D\u0434\u044B, \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435
      \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0434\u0443\u0448\u0438 \u0438 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435\u0441\u044C
      \u043A \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044E \u0443\u043C\u0435\u043D\u0438\u044F
      <b>\u0412\u044B\u043F\u043B\u044E\u043D\u0443\u0442\u044C</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340404
    m_Localized: "\u0432\u044B\u043F\u043B\u0435\u0432\u044B\u0432\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340405
    m_Localized: "\u0414\u043E\u0441\u0442\u0443\u043F\u043D\u043E \u043F\u043E\u0441\u043B\u0435
      \u043D\u0435\u0434\u0430\u0432\u043D\u0435\u0433\u043E \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430
      \u0432\u0440\u0430\u0433\u0430 \u0438\u043B\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
      \u043E\u0440\u0443\u0436\u0438\u044F \u0441 \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u043C
      \xAB\u0427\u0440\u0435\u0432\u043E\u0443\u0433\u043E\u0434\u0438\u0435\xBB.
      \u0412\u044B\u043F\u043B\u0435\u0432\u044B\u0432\u0430\u0435\u0442 \u0440\u0432\u043E\u0442\u0443
      \u0432\u043F\u0435\u0440\u0435\u0434, \u043D\u0430\u043D\u043E\u0441\u044F
      \u0443\u0440\u043E\u043D \u0432 \u0440\u0430\u0437\u043C\u0435\u0440\u0435
      {dmg:SpitCoef+SpitFlat}."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340406
    m_Localized: "\u0411\u0430\u0437\u043E\u0432\u044B\u0439 \u0443\u0440\u043E\u043D
      \u0440\u0430\u0432\u0435\u043D {dmg:SpitCoef+SpitFlat} \u0438 \u043D\u0430\u043D\u043E\u0441\u0438\u0442
      \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0443\u0440\u043E\u043D, \u0440\u0430\u0432\u043D\u044B\u0439 {b:InheritKillAtkPct}%
      \u043E\u0442 \u0441\u0438\u043B\u044B \u0430\u0442\u0430\u043A\u0438 \u0446\u0435\u043B\u0438,
      \u0435\u0441\u043B\u0438 \u0446\u0435\u043B\u044C \u2014 \u0438\u0433\u0440\u043E\u043A,
      \u0438\u043B\u0438 {b:InheritWeaponAtkPct}%, \u0435\u0441\u043B\u0438 \u0446\u0435\u043B\u044C
      \u2014 \u043E\u0440\u0443\u0436\u0438\u0435.\n\n\u041C\u043E\u0436\u0435\u0442
      \u0437\u0430\u0432\u0438\u0441\u0435\u0442\u044C \u043E\u0442 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0445
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439 \u0432\u0440\u0430\u0433\u043E\u0432
      \u0438\u043B\u0438 \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u0439
      \u043E\u0440\u0443\u0436\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340407
    m_Localized: "\u0423\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u0435
      \u0432\u0440\u0435\u0434\u043D\u044B\u0445 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340408
    m_Localized: "\u0421\u043E\u0436\u0433\u0438\u0442\u0435 \u043E\u0440\u0443\u0436\u0438\u0435,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0434\u0435\u0440\u0436\u0438\u0442\u0435
      \u0432 \u0440\u0443\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340409
    m_Localized: "\u0433\u043E\u043B\u043E\u0434\u0430\u044E\u0449\u0438\u0439 \u043C\u043E\u043D\u0441\u0442\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340410
    m_Localized: "\u0412\u044B\u043F\u0443\u0441\u0442\u0438\u0442\u0435 {b:MonsterCount:all}
      \u0433\u043E\u043B\u043E\u0434\u043D\u044B\u0445 \u0437\u0432\u0435\u0440\u0435\u0439,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0431\u0443\u0434\u0443\u0442 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      \u043A\u0443\u0441\u0430\u0442\u044C \u0432\u0440\u0430\u0433\u043E\u0432 \u0432
      \u0440\u0430\u0434\u0438\u0443\u0441\u0435 {b:MonsterRadius:all} \u043C \u0432
      \u0442\u0435\u0447\u0435\u043D\u0438\u0435 {b:UltDuration:all} \u0441\u0435\u043A\u0443\u043D\u0434,
      \u043D\u0430\u043D\u043E\u0441\u044F \u0443\u0434\u0430\u0440 \xAB\u041E\u0431\u0436\u043E\u0440\u0441\u0442\u0432\u043E\xBB
      \u0441 \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u043C {b:MonsterPowerMul*100}%.\n\n\u0415\u0441\u043B\u0438
      \u0432\u044B \u0443\u0431\u044C\u0435\u0442\u0435 \u0438\u0433\u0440\u043E\u043A\u0430
      \u0443\u0434\u0430\u0440\u043E\u043C \xAB\u041E\u0431\u0436\u043E\u0440\u0441\u0442\u0432\u043E\xBB,
      \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u044D\u0444\u0444\u0435\u043A\u0442\u0430
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u0441\u044F \u043D\u0430 {b:UltKillExtend}
      \u0441\u0435\u043A\u0443\u043D\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340411
    m_Localized: "\u041C\u043E\u043D\u0441\u0442\u0440 \u0438\u043C\u0435\u0435\u0442
      3-\u0441\u0435\u043A\u0443\u043D\u0434\u043D\u0443\u044E \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0443
      \u0430\u0442\u0430\u043A\u0438 \u043D\u0430 \u043A\u0430\u0436\u0434\u0443\u044E
      \u0446\u0435\u043B\u044C \u0438 \u043D\u0430\u043D\u043E\u0441\u0438\u0442
      {b:MonsterLowHpBonus:all}% \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u0443\u0440\u043E\u043D\u0430 \u0446\u0435\u043B\u044F\u043C \u0441 30% \u0438\u043B\u0438
      \u043C\u0435\u043D\u0435\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F.\n\n\u0412
      \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
      \u044D\u0444\u0444\u0435\u043A\u0442\u0430 \u0441\u0438\u043B\u0430 \u0430\u0442\u0430\u043A\u0438,
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0430\u0442\u0430\u043A\u0438
      \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340412
    m_Localized: "\u0428\u0438\u0434\u043E\u0443 \u0423\u043E\u043A\u0435\u0440"
