      \u0441\u0435\u043A\u0443\u043D\u0434 \u043A \u0432\u0440\u0435\u043C\u0435\u043D\u0438
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      \u0432\u0441\u0435\u0445 \u043E\u0431\u044B\u0447\u043D\u044B\u0445 \u043D\u0430\u0432\u044B\u043A\u043E\u0432
      (\u043A\u0440\u043E\u043C\u0435 \u0443\u043B\u044C\u0442\u0438\u043C\u0430\u0442\u0438\u0432\u043D\u044B\u0445
      \u0438 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0445 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439)
      \u0434\u043B\u044F \u0432\u0441\u0435\u0445 \u0432\u0440\u0430\u0433\u043E\u0432
      \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435 {b:OneCardRadius:all} \u043C
      \u043E\u0442 \u043D\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340454
    m_Localized: "\u0418\u0437\u043C\u0435\u043D\u044F\u0435\u0442 \u0432\u0440\u0435\u043C\u044F
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0445
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439, \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0438\u0445\u0441\u044F
      \u0432 \u0434\u0430\u043D\u043D\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0435,
      \u043D\u0430 \u0432\u0440\u0435\u043C\u044F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      \u043D\u0430\u0432\u044B\u043A\u0430 \u0437\u0430\u043C\u0435\u0449\u0430\u044E\u0449\u0435\u0439
      \u043A\u0430\u0440\u0442\u044B, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442
      \u0432\u0440\u0435\u043C\u044F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      \u044D\u0442\u043E\u0439 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0439
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340455
    m_Localized: "\u0441\u044E\u0440\u043F\u0440\u0438\u0437-\u043F\u043E\u0434\u0430\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340456
    m_Localized: "\u041F\u0440\u0438\u0437\u044B\u0432\u0430\u0435\u0442 \u0438\u0434\u0435\u043D\u0442\u0438\u0447\u043D\u043E\u0433\u043E
      \u0441\u0435\u0431\u0435 \u043A\u043B\u043E\u043D\u0430 \u0441\u043E \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u043C\u0438
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044F\u043C\u0438
      \u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0431\u0443\u0434\u0435\u0442 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      \u0432\u043F\u0435\u0440\u0451\u0434 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      {b:CloneDuration:all} \u0441\u0435\u043A\u0443\u043D\u0434.\n\n\u041F\u043E
      \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E \u043A\u043B\u043E\u043D
      \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0437\u0430 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u043C
      \u0432\u0440\u0430\u0433\u043E\u043C.\n\n\u041A\u043E\u0433\u0434\u0430 \u043A\u043B\u043E\u043D
      \u043F\u043E\u0433\u0438\u0431\u0430\u0435\u0442 \u0438\u043B\u0438 \u0432\u044B
      \u0441\u043D\u043E\u0432\u0430 \u043D\u0430\u0436\u0438\u043C\u0430\u0435\u0442\u0435
      \u043A\u043B\u0430\u0432\u0438\u0448\u0443 \u0443\u043B\u044C\u0442\u0438\u043C\u0435\u0439\u0442\u0430,
      \u043E\u043D \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
      \u043D\u0430\u043D\u043E\u0441\u044F {b:CloneBlastMul*100:all}% \u0443\u0440\u043E\u043D\u0430
      \u043E\u0442 \u0432\u0437\u0440\u044B\u0432\u0430 Joker Draw \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u043C
      \u0432\u0440\u0430\u0433\u0430\u043C.\n\n\u041A\u043B\u043E\u043D \u0430\u0442\u0430\u043A\u0443\u0435\u0442
      \u0432\u0440\u0430\u0433\u043E\u0432 \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435
      10 \u043C \u0441\u0432\u043E\u0438\u043C \u0442\u0435\u043A\u0443\u0449\u0438\u043C
      \u043E\u0440\u0443\u0436\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
