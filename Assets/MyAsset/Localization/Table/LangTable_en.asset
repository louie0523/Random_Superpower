    m_Localized: William
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903232
    m_Localized: zone
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903233
    m_Localized: Thomas
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903234
    m_Localized: henry
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903235
    m_Localized: Robert
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903236
    m_Localized: Wolf
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903237
    m_Localized: Hakon
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903238
    m_Localized: Eric
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903239
    m_Localized: Arthur
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903240
    m_Localized: "<b>Entangled Holy Sword</b> \u2014 {b:ArthurTrueRatio:pct}% of
      damage ignores armor."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903241
    m_Localized: "<b>Charge</b> \u2014 Charge speed increases, and enemies hit are
      stunned for {b:ArthurStun} seconds."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903242
    m_Localized: "<b>Seonghwi</b> \u2014 Deals {dmg:ArthurBlastCoef} additional damage
      in the explosion radius."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903243
    m_Localized: Roland
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903244
    m_Localized: "<b>Durandal</b> \u2014 Power increases by {b:RolandBonusPct}% and
      deals additional damage equal to {b:RolandMissingPct}% of the target's missing
      health."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903245
    m_Localized: "<b>Leap</b> \u2014 Press again while mounted to jump instead of
      dashing, knocking back enemies within {b:RolandPushRadius}m and restoring {b:RolandHealMissingPct}%
      of your missing health."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903246
    m_Localized: "<b>Judgment</b> \u2014 Frontal damage increases by {b:RolandFinisherCoef}%
      of Attack Power, and enemies hit are stunned for {b:RolandStun} seconds."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903247
    m_Localized: Bernhard
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097536
    m_Localized: "<b>Final</b> \u2014 Power increases by {b:BernhardBonusPct}%, and
      targets hit become Deep Wound {b:BernhardWoundPct}% for {b:BernhardWoundTime}
      seconds."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097537
    m_Localized: "<b>Wraith Charge</b> \u2014 Press again while mounted to charge
      in Ghost form, increasing the charge's power by {b:BernhardChargePct}%."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097538
    m_Localized: "<b>Death Flames</b> \u2014 Inflicts massive burn on enemies hit
      by the explosion, dealing {b:DeathFlameTime}% of their maximum health every
      second for {b:DeathFlamePct} seconds."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097539
    m_Localized: farmers
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097540
    m_Localized: "<b>Crop</b> \u2014 Recover {b:FarmHealPct}% of damage dealt"
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097541
    m_Localized: "<b>Unskilled Horseman</b> \u2014 Increased movement speed -{b:UnskilledPenalty}"
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097542
    m_Localized: mercenary
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097543
    m_Localized: "<b>Farm</b> \u2014 Recovers {b:FarmHealPct}% of damage dealt\n<b>Combat
      Sense</b> \u2014 Shortly after, slash again with {b:SecondMul:pct}% power"
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097544
    m_Localized: "<b>Unskilled Horseman</b> \u2014 Increased movement speed -{b:UnskilledPenalty}"
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097545
    m_Localized: Named
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097546
    m_Localized: "<b>Farm</b> \u2014 Recovers {b:FarmHealPct}% of damage dealt\n<b>Combat
      Sense</b> \u2014 Shortly after, slash again with {b:SecondMul:pct}% power"
    m_Metadata:
