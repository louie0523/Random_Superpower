      m_Items: []
  - m_Id: 3001745419120640
    m_Localized: "F\xE4higkeit"
    m_Metadata:
      m_Items: []
  - m_Id: 3001745490423808
    m_Localized: Besonders
    m_Metadata:
      m_Items: []
  - m_Id: 3001745490423809
    m_Localized: Max {0}
    m_Metadata:
      m_Items: []
  - m_Id: 3001745490423810
    m_Localized: Q / E / R / Ultimativ
    m_Metadata:
      m_Items: []
  - m_Id: 3001745490423811
    m_Localized: Meister des One-Shots
    m_Metadata:
      m_Items: []
  - m_Id: 3001745490423812
    m_Localized: "Du bist ein Meister des Einzelschlags.\n\nAls Nahkampfwaffen-Klasse
      fegst du mit der m\xE4chtigen Spezialf\xE4higkeit \u201EEinzelschlag\u201C
      durch deine Feinde."
    m_Metadata:
      m_Items: []
  - m_Id: 3004699647782912
    m_Localized: Schlag
    m_Metadata:
      m_Items: []
  - m_Id: 3004699710697472
    m_Localized: Schlag
    m_Metadata:
      m_Items: []
  - m_Id: 3004699710697473
    m_Localized: "Bei einem Standardangriff mit einer Nahkampfwaffe st\xFCrmst du
      vorw\xE4rts und f\xFChrst dabei schnelle Hiebe aus.\n\nDer Schaden von Standardangriffen
      mit Nahkampfwaffen erh\xF6ht sich um 400 %.\n\nNach einem Angriff musst du
      die \u201EEin-Schuss\u201C-Anzeige auff\xFCllen, um erneut angreifen zu k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 3004699710697474
    m_Localized: "Die \u201EOne-Shot\u201C-Anzeige f\xFCllt sich mit 3 % pro Sekunde
      beim Bewegen und mit 5 %, wenn ein Gegner mit einem Standardangriff getroffen
      wird."
    m_Metadata:
      m_Items: []
  - m_Id: 3004699710697475
    m_Localized: "schnelle F\xFC\xDFe"
    m_Metadata:
      m_Items: []
  - m_Id: 3004699714891776
    m_Localized: "Die Bewegungsgeschwindigkeit erh\xF6ht sich um 1."
    m_Metadata:
      m_Items: []
  - m_Id: 3004699714891778
    m_Localized: Atmen Sie tief durch
    m_Metadata:
      m_Items: []
  - m_Id: 3004699714891779
    m_Localized: "F\xFCllt die One-Hit-Anzeige sofort um 50 % auf."
    m_Metadata:
      m_Items: []
  - m_Id: 3004699714891780
    m_Localized: Meister des One-Shots
    m_Metadata:
      m_Items: []
  - m_Id: 3004699714891781
    m_Localized: "Bei Aktivierung dieser F\xE4higkeit befindest du dich 8 Sekunden
      lang im Zustand \u201EMeister des Sofort-Kills\u201C.\n\nDie durch Bewegung
      und Treffer mit Standardangriffen gewonnene Sofort-Kill-Anzeige wird um 300
      % erh\xF6ht.\n\nIm Zustand \u201EMeister des Sofort-Kills\u201C f\xFCllt jeder
      Treffer mit Sofort-Kill die Sofort-Kill-Anzeige sofort auf 100 %."
    m_Metadata:
      m_Items: []
  - m_Id: 3004699714891782
    m_Localized: "Die Bewegungsgeschwindigkeit erh\xF6ht sich w\xE4hrend der Dauer
      um 2."
    m_Metadata:
      m_Items: []
  - m_Id: 4030871831687168
    m_Localized: "N\xE4he"
    m_Metadata:
      m_Items: []
  - m_Id: 4030871894601728
    m_Localized: Bezaubernd
    m_Metadata:
      m_Items: []
  - m_Id: 4030871894601729
    m_Localized: Kann nicht verzaubert werden
    m_Metadata:
      m_Items: []
  - m_Id: 4030871894601730
    m_Localized: "R\xFCstung"
    m_Metadata:
      m_Items: []
  - m_Id: 4030871894601731
    m_Localized: Werfen
    m_Metadata:
      m_Items: []
  - m_Id: 4030871894601732
    m_Localized: Schuhe
    m_Metadata:
      m_Items: []
  - m_Id: 4030871894601733
    m_Localized: "Beide H\xE4nde"
    m_Metadata:
      m_Items: []
  - m_Id: 4030871894601734
    m_Localized: Schwere
    m_Metadata:
      m_Items: []
  - m_Id: 4031231723941888
    m_Localized: Basic
    m_Metadata:
      m_Items: []
  - m_Id: 4071974098284544
    m_Localized: Verzaubern
    m_Metadata:
      m_Items: []
  - m_Id: 4071974161199104
    m_Localized: Keine Verzauberungen angewendet.
    m_Metadata:
      m_Items: []
  - m_Id: 5221716563963904
    m_Localized: Fertigkeitspunkte {0}
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072768
    m_Localized: Level {0} / {1}
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072769
    m_Localized: "Kaufe +1 Fertigkeitspunkt \u2014 Du kannst jede beliebige Fertigkeit
      im F\xE4higkeiten-Panel (F1) verbessern."
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072770
    m_Localized: Entfernt alle aktuellen Waffenverzauberungen (Seele +{0} pro Stufe)
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072771
    m_Localized: Besondere Verzauberung
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072772
    m_Localized: "W\xE4hle Spezialverzauberung"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072773
    m_Localized: Wechsel zu normaler Verzauberung
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072774
    m_Localized: "W\xE4hle eine besondere Verzauberung"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072775
    m_Localized: '{0} {1} ({2} Sekunden) beim Treffer'
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072776
    m_Localized: "Verursacht bei einem Treffer zus\xE4tzlichen Schaden in H\xF6he
      von {0}% der maximalen Gesundheit des Ziels."
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072777
    m_Localized: Anstatt Leben abzusaugen, werden {0}% der abgesaugten Menge in Schaden
      umgewandelt.
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072778
    m_Localized: Bezeichnung
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072779
    m_Localized: "N\xE4chste Verzauberungsbezeichnung"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072780
    m_Localized: Besondere Verzauberung
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072781
    m_Localized: Normale Verzauberung
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267075
    m_Localized: "blo\xDFe H\xE4nde"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267076
    m_Localized: "Damit ist alles m\xF6glich!"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267077
    m_Localized: Dolch
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267078
    m_Localized: Es ist ein sehr einfaches Schwert.
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267079
    m_Localized: Holzbogen
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267080
    m_Localized: Es ist ausreichend.
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267081
    m_Localized: Gehstock aus Holz
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267082
    m_Localized: Wie gruselig!
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267083
    m_Localized: AK47
    m_Metadata:
      m_Items: []
  - m_Id: 5221716639461376
    m_Localized: "Mit dieser einen Sache h\xE4tte auch meine Gro\xDFmutter zur Legende
      werden k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 5227191309283328
    m_Localized: verlangsamen
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837760
    m_Localized: "Verlangsamt die Bewegungsgeschwindigkeit des Ziels um {v0}% f\xFCr
      {d0} Sekunden."
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837761
    m_Localized: brennen
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837762
    m_Localized: "Verursacht beim Ziel f\xFCr {d0} Sekunden <color=orange>Verbrennung</color>,
      wodurch jede Sekunde ein fixer Schaden in H\xF6he von {v0}% der maximalen Gesundheit
      verursacht wird."
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837763
    m_Localized: Statue
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837764
    m_Localized: "Belegt das Ziel mit dem <color=sky>Frost</color>-Effekt f\xFCr
      {d0} Sekunden und verringert dessen Angriffsgeschwindigkeit um {v1}%."
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837765
    m_Localized: Urteil
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837766
    m_Localized: "Beim Treffer wird zus\xE4tzlicher <b>fixer Schaden in H\xF6he von
      {v0}% der maximalen Trefferpunkte des Ziels</b> verursacht."
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837767
    m_Localized: "V\xF6llerei"
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837768
    m_Localized: Stellt {v0}% des durch die Waffe verursachten Schadens wieder her.
    m_Metadata:
      m_Items: []
  - m_Id: 5448237727723520
    m_Localized: Vergiftung
    m_Metadata:
