  m_Name: "\uC250\uB3C4\uC6B0 \uC6CC\uCEE4"
  m_EditorClassIdentifier: Assembly-CSharp::AbilityData
  Id: 6006
  DisplayName: "\uC26C\uB3C4\uC6B0 \uC6CC\uCEE4"
  Kind: 0
  Tier: 0
  Tags: 
  ExclusiveShopItems: []
  Icon: {fileID: 0}
  Flavor: "\uB2F9\uC2E0\uC740 \uC5B8\uC81C\uB098 \uADF8\uB9BC\uC790\uC640 \uD568\uAED8
    \uD589\uB3D9\uD569\uB2C8\uB2E4.\n\uADF8\uB9BC\uC790\uB97C \uD65C\uC6A9\uD558\uC5EC
    \uACF5\uACA9\uC801\uC73C\uB85C, \uB54C\uB860 \uAE30\uB3D9\uC801\uC73C\uB85C,
    \uADF8\uB9AC\uACE0 \uADF8\uB9BC\uC790\uB97C \uD3BC\uCCD0 \uC601\uC5ED\uC744 \uC9C0\uBC30\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  Passives:
  - Name: "\uADF8\uB9BC\uC790"
    Icon: {fileID: 0}
    Description: "\uADF8\uB9BC\uC790\uAC00 \uC250\uB3C4\uC6B0 \uC6CC\uCEE4\uB97C
      \uB530\uB77C\uB2E4\uB2D9\uB2C8\uB2E4.\n\uC804\uD22C\uC911\uC774 \uC544\uB2D0\uB54C\uB9C8\uB2E4
      <b>\uC554\uD751</b>\uC744 {b:DarkChargeTime:all}\uCD08\uC5D0 \uAC78\uCCD0 \uCDA9\uC804\uD569\uB2C8\uB2E4.\n\uC801
      \uACF5\uACA9\uC2DC <b>\uC554\uD751</b>\uC774 \uCDA9\uC804\uB418\uC5B4\uC788\uB2E4\uBA74,
      \uB300\uC0C1\uC758 \uC2DC\uC57C\uB97C {b:BlindTime:all}\uCD08\uAC04 \uC554\uC804\uC2DC\uD0B5\uB2C8\uB2E4."
    DetailedInfo: 
    Tip: 
    DevNote: 
    MaxLevel: 3
    Vars: []
    Effects: []
  Skills:
  - Name: "\uADF8\uB9BC\uC790 \uBB34\uAE30"
    Icon: {fileID: 0}
    Description: "{b:WeaponDuration:all}\uCD08\uAC04 \uADF8\uB9BC\uC790 \uBB34\uAE30\uB97C
      \uD65C\uC131\uD654\uD569\uB2C8\uB2E4. \n\uBB34\uAE30\uB85C \uACF5\uACA9\uC2DC
      \uC790\uC2E0\uC758 \uD658\uC601\uC774 \uC7A0\uC2DC\uB4A4 \uAC19\uC740 \uBB34\uAE30\uB85C
      \uAC19\uC740 \uBC29\uD5A5\uC744 \uACF5\uACA9\uD558\uC5EC \uAE30\uC874 \uC704\uB825\uC758
      {b:EchoPct:all}%\uC758 \uD53C\uD574\uB97C \uAC00\uD569\uB2C8\uB2E4.\n"
    DetailedInfo: "\uADF8\uB9BC\uC790 \uBB34\uAE30\uB85C \uD53C\uD574\uB97C \uC785\uC740
      \uC801\uC740 1\uCD08\uAC04 \uB454\uD654 10%\uB97C \uD6A8\uACFC\uAC00 \uC801\uC6A9\uB429\uB2C8\uB2E4."
