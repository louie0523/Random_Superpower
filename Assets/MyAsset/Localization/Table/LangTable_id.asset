  - m_Id: 15224945326534671
    m_Localized: Bertingkah imut
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534672
    m_Localized: Menggunakan kelucuan mematikan untuk mengurangi kerusakan yang ditimbulkan
      oleh target sebesar 50% selama 8 detik.
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534673
    m_Localized: Bertingkah imut
