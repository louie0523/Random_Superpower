  - Name: "\uC544\uC11C"
    Tier: 2
    Named: 1
    Weight: 30
    Stats:
    - Stat: 0
      Type: 1
      Value: 25
    - Stat: 1
      Type: 1
      Value: 15
    - Stat: 3
      Type: 0
      Value: 5
    MountOverride: {fileID: 0}
    Texts:
    - Key: slash
      Text: "<b>\uB4A4\uC5BD\uD78C \uC131\uAC80</b> \u2014 \uD53C\uD574\uC758 {b:ArthurTrueRatio:pct}%\uAC00
        \uBC29\uC5B4\uB825\uC744 \uBB34\uC2DC"
    - Key: mount
      Text: "<b>\uC9C4\uACA9</b> \u2014 \uC55E\uC73C\uB85C {b:ChargeDistance}m \uB3CC\uC9C4,
        \uC9C0\uB098\uAC04 \uC801\uC5D0\uAC8C {dmg:ChargeCoef} \uD53C\uD574 + \uBC00\uCCD0\uB0B4\uACE0
        {b:ArthurStun}\uCD08 \uAE30\uC808"
    - Key: ult
      Text: "<b>\uB4A4\uC5BD\uD78C \uC131\uD718</b> \u2014 \uD3ED\uBC1C \uBC94\uC704\uC5D0
        {dmg:ArthurBlastCoef} \uCD94\uAC00 \uD53C\uD574"
  - Name: "\uB864\uB780\uB4DC"
    Tier: 2
    Named: 2
    Weight: 30
    Stats:
    - Stat: 0
      Type: 1
      Value: 30
    - Stat: 1
      Type: 1
      Value: 10
    - Stat: 3
      Type: 0
      Value: 5
    MountOverride: {fileID: 0}
    Texts:
    - Key: slash
      Text: "<b>\uB4A4\uB791\uB2EC</b> \u2014 \uC704\uB825 +{b:RolandBonusPct}%,
        \uB300\uC0C1\uC774 \uC783\uC740 \uCCB4\uB825\uC758 {b:RolandMissingPct}%
        \uCD94\uAC00 \uD53C\uD574"
    - Key: mount
      Text: "<b>\uB3C4\uC57D</b> \u2014 \uB6F0\uC5B4\uC62C\uB77C \uC8FC\uC704 {b:RolandPushRadius}m\uC758
        \uC801\uC744 \uBC00\uCCD0\uB0B4\uACE0 \uC783\uC740 \uCCB4\uB825\uC758 {b:RolandHealMissingPct}%
        \uD68C\uBCF5"
    - Key: ult
      Text: "<b>\uC2EC\uD310</b> \u2014 \uC804\uBC29 \uD53C\uD574\uAC00 \uACF5\uACA9\uB825\uC758
        {b:RolandFinisherCoef}%\uB85C \uC99D\uAC00, {b:RolandStun}\uCD08 \uAE30\uC808"
  - Name: "\uBCA0\uB978\uD558\uB974\uD2B8"
    Tier: 2
    Named: 3
    Weight: 30
    Stats:
    - Stat: 0
      Type: 1
      Value: 20
    - Stat: 1
      Type: 1
      Value: 30
    - Stat: 3
      Type: 0
      Value: 7
    MountOverride: {fileID: 0}
    Texts:
    - Key: slash
      Text: "<b>\uC8FD\uC74C\uC758 \uD5A5\uAE30</b> \u2014 \uC704\uB825 +{b:BernhardBonusPct}%,
        {b:BernhardWoundTime}\uCD08\uAC04 \uAE4A\uC740 \uC0C1\uCC98 {b:BernhardWoundPct}%"
    - Key: mount
      Text: "<b>\uBA85\uACC4\uC758 \uB9D0</b> \u2014 \uACE0\uC2A4\uD2B8 \uC0C1\uD0DC\uB85C
        {b:ChargeDistance}m \uB3CC\uC9C4, \uC9C0\uB098\uAC04 \uC801\uC5D0\uAC8C {dmg:ChargeCoef}
        \uD53C\uD574"
    - Key: ult
      Text: "<b>\uC8FD\uC74C\uC758 \uBD88\uAE38</b> \u2014 \uD3ED\uBC1C\uC5D0 \uB9DE\uC740
        \uC801\uC774 {b:DeathFlameTime}\uCD08\uAC04 \uB9E4\uCD08 \uCD5C\uB300 \uCCB4\uB825\uC758
        {b:DeathFlamePct}% \uD654\uC0C1"
  Tiers:
  - Tier: 0
    Label: "\uB18D\uBBFC"
