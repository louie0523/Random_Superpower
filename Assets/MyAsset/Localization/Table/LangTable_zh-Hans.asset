    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340399
    m_Localized: "\u541E\u98DF\u6B66\u5668\u53EF\u6C38\u4E45\u83B7\u5F97 {b:AbsorbRatio:pct}%
      \u7684\u80FD\u529B\u70B9\u6570\u3002\n\n{x:digest}\n\n{x:absorbed}\n\n{x:specials}"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340400
    m_Localized: "\u4F60\u7684\u589E\u76CA\u57FA\u4E8E\u6B66\u5668\u57FA\u7840\u5C5E\u6027
      \xD7 \u5438\u6536\u7387 {b:AbsorbRatio*100:all}% \xD7 \u7B49\u7EA7\u500D\u7387\u3002\n\n\u4F60\u6700\u591A\u53EF\u4EE5\u83B7\u5F97
      {b:AbsorbEnchants*100:all}% \u7684\u9644\u9B54\u6548\u679C\uFF0C\u6D88\u8017\u7279\u6B8A\u6B66\u5668\u4F1A\u83B7\u5F97\u6C38\u4E45\u7279\u6B8A\u6548\u679C\u3002\n\n\u6D88\u5316\u65F6\u95F4\u6700\u591A\u53EF\u51CF\u5C11
      {b:DigestMul*100}%\uFF0C\u5177\u4F53\u6570\u503C\u53D6\u51B3\u4E8E\u6280\u80FD\u7B49\u7EA7\u3002"
    m_Metadata:
      m_Items: []
