  - m_Id: 15224945322340361
    m_Localized: "\u0438\u0437\u0432\u0435\u0440\u0436\u0435\u043D\u0438\u0435 \u0434\u043E\u043C\u0435\u043D\u043D\u043E\u0439
      \u043F\u0435\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340362
    m_Localized: "\u0412\u0437\u0440\u044B\u0432\u0430\u0435\u0442 \u043B\u0430\u0432\u0443
      \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435 {b:FurnaceRadius} \u043C
      \u043E\u0442 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0435\u0439 \u0441\u0440\u0435\u0434\u044B,
      \u043D\u0430\u043D\u043E\u0441\u044F {dmg:FurnaceCoef+FurnaceFlat} \u0443\u0440\u043E\u043D\u0430.\n\n\u0427\u0435\u043C
      \u043D\u0438\u0436\u0435 \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F,
      \u0442\u0435\u043C \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u044D\u0444\u0444\u0435\u043A\u0442, \u0434\u043E {b:FurnaceMaxMul} \u0440\u0430\u0437,
      \u0438 \u0438\u043C\u0435\u0435\u0442 {b:BurnChance:pct}% \u0448\u0430\u043D\u0441
      \u043D\u0430\u043D\u0435\u0441\u0442\u0438 \u043E\u0436\u043E\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340363
    m_Localized: "\u041C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F
      \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442\u0441\u044F
      \u043F\u0440\u0438 \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0438 \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u0438
      \u0434\u043E 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340364
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u043A\u0438 \u043E\u0433\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340365
    m_Localized: "\u0412 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 {b:UltDuration}
      \u0441\u0435\u043A\u0443\u043D\u0434 \u0432\u0430\u0448\u0435 \u0442\u0435\u043B\u043E
      \u043E\u043A\u0443\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043E\u0433\u043D\u0435\u043C,
      \u0438 \u0432\u044B \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u0435
      \u0432 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \xAB\u041F\u043E\u0442\u043E\u043C\u043E\u043A
      \u043E\u0433\u043D\u044F\xBB.\n\n\u0412\u0440\u0430\u0433\u0438, \u0430\u0442\u0430\u043A\u0443\u044E\u0449\u0438\u0435
      \u0432\u0430\u0441 \u0432 \u0431\u043B\u0438\u0436\u043D\u0435\u043C \u0431\u043E\u044E,
      \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u044D\u0444\u0444\u0435\u043A\u0442
      \xAB\u041E\u0436\u043E\u0433\xBB, \u0430 \u0432\u0441\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u044B
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u043D\u0430 25%. \u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E,
      \u0432\u0440\u0435\u043C\u044F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      \xAB\u041F\u0435\u0447\u0438\xBB \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437, \u043A\u043E\u0433\u0434\u0430
      \u0432\u0430\u0448\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u043F\u0430\u0434\u0430\u0435\u0442
      \u043D\u0430 15%, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u043D\u0430
      85%, 70%, 55% \u0438 \u0442. \u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340366
    m_Localized: "\u0423 \u043F\u043E\u0442\u043E\u043C\u043A\u043E\u0432 \u043E\u0433\u043D\u044F
      \u043F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u0435 \u043A\u0430\u043C\u043D\u0435\u0439
      \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u044F \u0438\u0437-\u0437\u0430
      \u043D\u0430\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u044F
      \u0441\u043D\u0438\u0436\u0430\u0435\u0442\u0441\u044F \u0432\u0434\u0432\u043E\u0435."
    m_Metadata:
      m_Items: []
