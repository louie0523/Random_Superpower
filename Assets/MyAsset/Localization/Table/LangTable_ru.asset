      m_Items: []
  - m_Id: 15224945322340436
    m_Localized: "\u043A\u043E\u043C\u0430\u043D\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340437
    m_Localized: "\u0412 \u0440\u0435\u0436\u0438\u043C\u0435 \xAB\u041C\u0430\u0441\u0442\u0435\u0440
      \u043E\u0440\u0443\u0436\u0438\u044F\xBB \u043F\u0430\u0440\u044F\u0449\u0438\u0435
      \u043E\u0440\u0443\u0434\u0438\u044F \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0434\u0432\u0438\u0436\u0443\u0442\u0441\u044F \u0432 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438,
      \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043E\u043D\u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B,
      \u043D\u0430\u043D\u043E\u0441\u044F \u0443\u0440\u043E\u043D, \u0440\u0430\u0432\u043D\u044B\u0439
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0443 \u043E\u0440\u0443\u0434\u0438\u0439
      X {dmg:CommandCoef}."
