  - m_Id: 15224945322340356
    m_Localized: "\u041B\u0438\u043C\u0438\u0442 \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u0439
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0434\u043E 100.\n\n\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0443\u043A\u0430\u0437\u0430\u0442\u044C
      \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u044F, \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0432
      \u0414\u0443\u0448\u0443."
