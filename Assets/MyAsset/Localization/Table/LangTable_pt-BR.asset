      m_Items: []
  - m_Id: 5221716563963904
    m_Localized: Pontos de Habilidade {0}
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072768
    m_Localized: "N\xEDvel {0} / {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072769
    m_Localized: "Adquira +1 Ponto de Habilidade \u2014 Voc\xEA pode aprimorar qualquer
      habilidade que desejar no Painel de Habilidades (F1)."
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072770
    m_Localized: "Remove todos os encantamentos de arma atuais (Alma +{0} por n\xEDvel)"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072771
    m_Localized: Encantamento Especial
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072772
