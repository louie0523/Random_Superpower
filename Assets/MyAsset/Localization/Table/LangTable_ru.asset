      m_Items: []
  - m_Id: 15217183922171932
    m_Localized: "\u041D\u0430\u0432\u044B\u043A \u2014 \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u0438 \u043E\u0442\u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171933
    m_Localized: "\u0415\u0441\u043B\u0438 \u0432\u044B \u0435\u0433\u043E \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u0435,
      \u043E\u043D \u043D\u0430\u0447\u043D\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0432 \u043C\u043E\u043C\u0435\u043D\u0442 \u043D\u0430\u0436\u0430\u0442\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171934
    m_Localized: "\u0420\u044B\u0432\u043E\u043A \u2014 \u0412 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438,
      \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0432\u044B \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171935
    m_Localized: "\u0415\u0441\u043B\u0438 \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C,
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
      \u0432 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      (\u044D\u0442\u043E \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u043A \u0440\u044B\u0432\u043A\u0443
      \u0432 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F)."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171936
    m_Localized: "\u041F\u043E\u0434\u0431\u0438\u0440\u0430\u0442\u044C \u043E\u0440\u0443\u0436\u0438\u0435
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438"
    m_Metadata:
      m_Items: []
