    m_Localized: Coller
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560556
    m_Localized: "Il n'y a pas de code de r\xE9ticule dans le presse-papiers."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560557
    m_Localized: "R\xE9initialiser par d\xE9faut"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560558
    m_Localized: "Appliquez la m\xEAme m\xE9thode aux autres armes."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560559
    m_Localized: Aucune restriction
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560560
