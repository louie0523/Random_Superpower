    m_Localized: "\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u043C\u044B\u0445
      \u043A\u0430\u043C\u043D\u0435\u0439 \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u044F
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 {b:StoneGain:all} \u0440\u0430\u0437."
