      m_Items: []
  - m_Id: 5221716635267081
    m_Localized: "bast\xF3n de madera"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267082
    m_Localized: "\xA1Qu\xE9 miedo!"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267083
    m_Localized: AK47
    m_Metadata:
      m_Items: []
  - m_Id: 5221716639461376
    m_Localized: "Con tan solo esto, mi abuela tambi\xE9n podr\xEDa haberse convertido
