    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440 \u043E\u0433\u043D\u0435\u0441\u0442\u0440\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u043E\u0440\u0443\u0436\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340372
    m_Localized: "\u041F\u0440\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438
      \u043E\u0433\u043D\u0435\u0441\u0442\u0440\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u043E\u0440\u0443\u0436\u0438\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      \u0430\u0442\u0430\u043A\u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 {0}%, \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      \u2014 \u043D\u0430 {1}, \u0430 \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0443\u0440\u043E\u043D \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 {2}%.\n\n\u041E\u0440\u0443\u0436\u0438\u0435\u043C \u043F\u043E
      \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \xAB\u0413\u043B\u043E\u043A\xBB."
    m_Metadata:
      m_Items: []
