  - m_Id: 15217183930560554
    m_Localized: "Copiar c\xF3digo al portapapeles"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560555
    m_Localized: Pasta
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560556
    m_Localized: "No hay ning\xFAn c\xF3digo de mira en el portapapeles."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560557
    m_Localized: Restablecer a valores predeterminados
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560558
    m_Localized: Haz lo mismo con otras armas.
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560559
    m_Localized: Sin restricciones
    m_Metadata:
      m_Items: []
