  - m_Id: 15328368021581846
    m_Localized: Zum Auferstehungspunkt
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581847
    m_Localized: "Teammatch (Nur Einstellungen \u2013 Teamaufteilung sp\xE4ter)"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581848
    m_Localized: "Versteckraum (Teilnahme nur mit Code m\xF6glich)"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581849
    m_Localized: "Altar \u2014 N Nebenalt\xE4re \u2192 Zentralaltar"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581850
    m_Localized: "Kosten f\xFCr den Nebenaltar"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581851
    m_Localized: Kosten des Zentralaltars
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581852
    m_Localized: "Nach der Aktivierung aller Nebenalt\xE4re wird der zentrale Altar"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581853
    m_Localized: Erforderlicher Unteraltar
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581854
    m_Localized: Zentrale Kanalzeit
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581855
    m_Localized: "Wenn die Anzahl der Unteralt\xE4re auf der Karte geringer ist als
      die erforderliche Anzahl, \xF6ffne sie einfach alle."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581856
    m_Localized: van
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581857
