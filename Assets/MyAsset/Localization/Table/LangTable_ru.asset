  - m_Id: 3004699714891781
    m_Localized: "\u041F\u0440\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438
      \u0432\u044B \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u0435 \u0432
      \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \xAB\u041C\u0430\u0441\u0442\u0435\u0440
      \u043E\u0434\u043D\u043E\u0433\u043E \u0443\u0434\u0430\u0440\u0430\xBB \u043D\u0430
      8 \u0441\u0435\u043A\u0443\u043D\u0434.\n\n\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u044D\u043D\u0435\u0440\u0433\u0438\u0438, \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u043C\u043E\u0439
      \u043E\u0442 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0439 \u0438 \u0431\u0430\u0437\u043E\u0432\u044B\u0445
      \u0430\u0442\u0430\u043A, \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0434\u043E 300%.\n\n\u0412 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438
      \xAB\u041C\u0430\u0441\u0442\u0435\u0440 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0443\u0434\u0430\u0440\u0430\xBB \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435
      \u0441 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C
      \xAB\u041E\u0434\u043D\u043E\u0433\u043E \u0443\u0434\u0430\u0440\u0430\xBB
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442
      \u0448\u043A\u0430\u043B\u0443 \xAB\u041E\u0434\u043D\u043E\u0433\u043E \u0443\u0434\u0430\u0440\u0430\xBB
      \u0434\u043E 100%."
