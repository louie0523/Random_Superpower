  m_Name: "\uBB34\uAD6C\uC758 \uB2EC\uC778"
  m_EditorClassIdentifier: Assembly-CSharp::AbilityData
  Id: 6007
  DisplayName: "\uBB34\uAD6C\uC758 \uB2EC\uC778"
  Kind: 0
  Tier: 0
  Tags: 
  ExclusiveShopItems: []
  Icon: {fileID: 0}
  Flavor: "\uB2F9\uC2E0\uC740 \uBB34\uAD6C\uC758 \uB2EC\uC778\uC785\uB2C8\uB2E4.\n\uB2E4\uB978
    \uD50C\uB808\uC774\uC5B4\uC640 \uB2E4\uB974\uAC8C \uCD5C\uB300 8\uAC1C\uC758
    \uBB34\uAE30\uB97C \uC18C\uC9C0\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uBB34\uAE30\uB4E4\uC740
    \uB4E4\uACE0 \uC788\uC9C0 \uC54A\uB354\uB77C\uB3C4, \uB2F9\uC2E0\uC758 \uACC1\uC744
    \uB5A0\uB2E4\uB2C8\uBA70 \uC804\uD22C\uD569\uB2C8\uB2E4."
  Passives:
  - Name: "\uBB34\uAD6C \uC800\uC7A5"
    Icon: {fileID: 0}
    Description: "\uCD5C\uB300 \uC18C\uC9C0\uD560 \uC218 \uC788\uB294 \uBB34\uAD6C\uC758
      \uC218\uAC00 {b:SlotCount:all} \uAE4C\uC9C0 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    DetailedInfo: 
    Tip: 
    DevNote: 
    MaxLevel: 3
    Vars: []
    Effects: []
  - Name: "\uBB34\uAD6C\uC758 \uB2EC\uC778"
    Icon: {fileID: 0}
    Description: "\uD604\uC7AC \uC7A5\uCC29\uC911\uC778 \uBB34\uAD6C\uB97C \uC81C\uC678\uD55C
      \uB2E4\uB978 \uBB34\uAD6C\uB294 \uB2F9\uC2E0\uC758 \uACC1\uC744 \uB5A0\uB2E4\uB2D9\uB2C8\uB2E4.\n\uC804\uD22C\uC2DC
      \uBB34\uAE30\uB4E4\uC758 \uACF5\uACA9\uC18D\uB3C4\uC5D0 \uBE44\uB840\uD558\uC5EC
      \uD50C\uB808\uC774\uC5B4\uAC00 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uD0C0\uACA9\uD55C
      \uC801\uC758\uBC29\uD5A5\uC73C\uB85C {b:OrbitInterval:all}\uCD08\uB9C8\uB2E4
      \uACF5\uACA9\uD558\uC5EC {b:OrbitCoef:all} + \uBB34\uAD6C \uACF5\uACA9\uB825\uC758
      {b:WeaponAtkPct:all}%\uB9CC\uD07C \uD53C\uD574\uB97C \uAC00\uD569\uB2C8\uB2E4.\n"
    DetailedInfo: "\uCD5C\uB300 \uC0AC\uAC70\uB9AC\uB294 {b:OrbitRange:all}m \uC774\uBA70,
      \uCD1D\uAE30\uB958\uB294 \uBB34\uAD6C\uC758 \uB2EC\uC778\uC73C\uB85C \uC870\uC885\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\n\uD65C \uBC0F \uC9C0\uD321\uC774\uB958\uB294
      100% \uCC28\uC9D5 \uC2DC\uAC04 \uAE30\uC900\uC785\uB2C8\uB2E4.\n\n\uD574\uB2F9
      \uBB34\uAE30\uC758 \uD2B9\uC218 \uC778\uCCB8\uD2B8\uB294 \uD655\uB960\uC774
      \uC808\uBC18\uC73C\uB85C \uBC1C\uB3D9\uD558\uBA70, \uC218\uCE58 \uBC0F \uC9C0\uC18D
      \uC2DC\uAC04\uB3C4 \uC808\uBC18\uC774 \uB429\uB2C8\uB2E4.( \uD761\uD608\uC740
      \uC801\uC6A9\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. )\n\n"
    Tip: 
    DevNote: 
    MaxLevel: 3
    Vars: []
    Effects: []
  - Name: "\uC218\uC9D1\uAC00"
    Icon: {fileID: 0}
    Description: "\uD68D\uB4DD\uD558\uB294 \uC778\uCCB8\uD2B8 \uC2A4\uD1A4 \uB7C9\uC774
      {b:StoneGain:all}\uBC30 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    DetailedInfo: 
    Tip: 
    DevNote: 
    MaxLevel: 1
    Vars: []
    Effects: []
