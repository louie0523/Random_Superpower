  - m_Id: 15224945322340449
    m_Localized: "\u0422\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u043D\u0430\u0437\u0430\u0434, \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F
      \u043A\u0430\u0440\u0442\u0443 \u0414\u0436\u043E\u043A\u0435\u0440\u0430 \u0432
      \u0438\u0441\u0445\u043E\u0434\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u043E\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0438.
      \u0415\u0441\u043B\u0438 \u043D\u0430 \u043D\u0435\u0451 \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u0442\u044C,
      \u043A\u0430\u0440\u0442\u0430 \u0432\u0437\u043E\u0440\u0432\u0451\u0442\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0443\u044E
      \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0443, \u043D\u0430\u043D\u0435\u0441\u044F
      {dmg:BlastCoef+BlastFlat} \u0443\u0440\u043E\u043D\u0430 \u0438 \u0437\u0430\u043C\u0435\u0434\u043B\u0438\u0432
      \u043D\u0430 {b:BlastSlowPct:all}% \u043D\u0430 2 \u0441\u0435\u043A\u0443\u043D\u0434\u044B."
