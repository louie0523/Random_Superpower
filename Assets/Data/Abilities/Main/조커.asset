  Skills:
  - Name: "\uC870\uCEE4 \uBF51\uAE30"
    Icon: {fileID: 0}
    Description: "\uB4A4\uB85C \uC21C\uAC04\uC774\uB3D9\uD558\uBA70, \uC790\uC2E0\uC774
      \uC6D0\uB798 \uC788\uB358 \uC704\uCE58\uC5D0 \uC870\uCEE4 \uCE74\uB4DC\uB97C
      \uB0A8\uAE41\uB2C8\uB2E4. \uCE74\uB4DC\uB294 \uB204\uAD70\uAC00 \uBC1F\uC744\uC2DC
      \uC7A0\uC2DC\uB4A4 \uD3ED\uBC1C\uD558\uC5EC {dmg:BlastCoef+BlastFlat}\uD53C\uD574\uB97C
      \uC785\uD788\uACE0, 2\uCD08\uAC04 \uB454\uD654 {b:BlastSlowPct:all}%\uB97C
      \uB0A8\uAE41\uB2C8\uB2E4."
    DetailedInfo: "\uCE74\uB4DC\uB294 \uD55C\uBC88\uC5D0 \uCD5C\uB300 {b:CardMax:all}\uC7A5
      \uAE4C\uC9C0 \uC874\uC7AC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
