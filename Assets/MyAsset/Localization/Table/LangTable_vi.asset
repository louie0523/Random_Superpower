  - m_Id: 70844526592
    m_Localized: "[ESC] \u0110\xF3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 19732001042432
    m_Localized: "Chi ti\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 442167485640704
    m_Localized: "N\u1EBFp g\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 442167552749568
    m_Localized: "Linh h\u1ED3n"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943872
    m_Localized: "Trong chi\u1EBFn \u0111\u1EA5u"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943873
    m_Localized: "Nh\u1EA5p chu\u1ED9t \u0111\u1EC3 xem th\xEAm chi ti\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943874
    m_Localized: "m\u1EDF c\u1EEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943875
    m_Localized: "H\u1ED9p th\xF4ng th\u01B0\u1EDDng"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943876
    m_Localized: "H\u1ED9p hi\u1EBFm"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943877
    m_Localized: "R\u01B0\u01A1ng Anh H\xF9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943878
    m_Localized: "H\u1ED9p Ph\xE9p Thu\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943879
    m_Localized: "l\u1EDBp h\u1ECDc"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943880
    m_Localized: "Kh\u1EA3 n\u0103ng ng\u1EABu nhi\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943881
    m_Localized: "kh\xF4ng t\u1ED3n t\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943882
    m_Localized: "Th\u1EE5 \u0111\u1ED9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943883
    m_Localized: "Th\u1EDDi gian h\u1ED3i chi\xEAu {0} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943884
    m_Localized: "Linh h\u1ED3n {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943885
    m_Localized: "Th\u01B0\u1EDBc \u0111o t\u1ED1i \u01B0u {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943886
    m_Localized: "Khu v\u1EF1c ph\xEDa tr\u01B0\u1EDBc {0}\xB0"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943887
    m_Localized: "To\xE0n b\u1ED9 khu v\u1EF1c xung quanh"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943888
    m_Localized: "{0}, ph\u1EA1m vi {1}m, t\u1ED1i \u0111a {2} ng\u01B0\u1EDDi"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943889
    m_Localized: "H\xE3y \xE1p d\u1EE5ng cho ch\xEDnh m\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943890
    m_Localized: "V\u0169 kh\xED c\u1EA7n thi\u1EBFt: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943891
    m_Localized: "m\u1EB9o:"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943892
    m_Localized: "tay kh\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943893
    m_Localized: "v\u0169 kh\xED c\u1EADn chi\u1EBFn"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943894
    m_Localized: "c\xE2y cung"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943895
    m_Localized: "g\u1EADy"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943896
    m_Localized: "v\u0169 kh\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943897
    m_Localized: "N\xE9m \u0111\u1ED3 v\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943898
    m_Localized: "V\u0169 kh\xED t\u1EA7m xa"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943899
    m_Localized: "T\u1EA5t c\u1EA3 v\u0169 kh\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943900
    m_Localized: "c\u1EEDa h\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943901
    m_Localized: "[B] C\u1EEDa h\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943902
    m_Localized: "Trong th\u1EDDi gian giao tranh \u2014 C\u1EEDa h\xE0ng kh\xF4ng
      kh\u1EA3 d\u1EE5ng"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943903
    m_Localized: chung
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943904
    m_Localized: "M\xEA ho\u1EB7c"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943905
    m_Localized: "Lo\u1EA1i tr\u1EEB"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943906
    m_Localized: mua
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943907
    m_Localized: "Kh\xF4ng c\xF3 s\u1EA3n ph\u1EA9m \u0111\u1ED9c quy\u1EC1n n\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943908
    m_Localized: "Ph\u1EE5c h\u1ED3i th\u1EC3 l\u1EF1c {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943909
    m_Localized: "N\u1EA1p {0}% \u0111\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943910
    m_Localized: "Kh\xF4ng c\xF3 s\u1EB5n \u0111\u1EC3 mua"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943911
    m_Localized: "M\u1EE9c t\u1ED1i \u0111a"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943912
    m_Localized: "s\u1EF1 thi\u1EBFu h\u1EE5t linh h\u1ED3n"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943913
    m_Localized: "Ch\u1EC9 \u0111\u01B0\u1EE3c ph\xE9p s\u1EED d\u1EE5ng s\xFAng"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943914
    m_Localized: "\u0110\u1EA7y \u0111\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943915
    m_Localized: "Kh\u1EA3 n\u0103ng c\u1EA7n thi\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943916
    m_Localized: "Kh\xF4ng c\xF3 b\xF9a ch\xFA"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943917
    m_Localized: "\u0110\xE1 Ph\xE9p Thu\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943918
    m_Localized: "M\xEA ho\u1EB7c"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943919
    m_Localized: "Tr\u1ED1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943920
    m_Localized: "Kh\xF4ng c\xF3 v\u0169 kh\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943921
    m_Localized: "Ph\xE9p thu\u1EADt l\xEAn \u0111\xE1 +{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943922
    m_Localized: "Kh\xF4ng c\xF3 v\u0169 kh\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943923
    m_Localized: "Kh\xF4ng th\u1EC3 b\u1ECB y\u1EC3m b\xF9a"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943924
    m_Localized: "S\xFAng \u0111\xF2i h\u1ECFi kh\u1EA3 n\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943925
    m_Localized: "M\u1EE9c t\u1ED1i \u0111a"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943926
    m_Localized: "Thi\u1EBFu \u0111\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943927
    m_Localized: "H\xE0ng t\u1ED3n kho"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943928
    m_Localized: "v\u0169 kh\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943929
    m_Localized: "thi\u1EBFt b\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943930
    m_Localized: "Tr\u1ED1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 442167556943931
    m_Localized: "G \u2014 Lo\u1EA1i b\u1ECF v\u0169 kh\xED \u0111ang ho\u1EA1t \u0111\u1ED9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138176
    m_Localized: "Giao l\u1ED9 {0}m"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138177
    m_Localized: "G\xF3c ph\xE1n \u0111o\xE1n {0} \u0111\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138178
    m_Localized: "S\u1ED1 \u0111\u1EA1n t\u1ED1i \u0111a {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138179
    m_Localized: "{0} ph\xE1t b\u1EAFn m\u1ED7i ph\xFAt"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138180
    m_Localized: "\u0110ang s\u1EA1c {0}~{1} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138181
    m_Localized: "S\xE1t th\u01B0\u01A1ng {0}~{1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138182
    m_Localized: "M\xEA ho\u1EB7c"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138183
    m_Localized: "Kh\xF4ng c\xF3 b\xF9a ch\xFA"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138184
    m_Localized: "Kh\xF4ng th\u1EC3 b\u1ECB y\u1EC3m b\xF9a"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138185
    m_Localized: "c\xE2y cung"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138186
    m_Localized: "g\u1EADy"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138187
    m_Localized: "v\u0169 kh\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138188
    m_Localized: "N\xE9m \u0111\u1ED3 v\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138189
    m_Localized: "B\xE0n th\u1EAFng {0} \xB7 V\u1ECB tr\xED th\u1EE9 nh\u1EA5t {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138190
    m_Localized: "V\u1ECB tr\xED th\u1EE9 nh\u1EA5t {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138191
    m_Localized: "{0} Chi\u1EBFn th\u1EAFng!"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138192
    m_Localized: "V\xF2ng \u0111\u1EA5u m\u1EDBi s\u1EBD s\u1EDBm b\u1EAFt \u0111\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138193
    m_Localized: "C\xF4ng su\u1EA5t t\u1ED1i \u0111a"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138194
    m_Localized: "S\u1EE9c t\u1EA5n c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138195
    m_Localized: "Ph\xF2ng th\u1EE7"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138196
    m_Localized: "T\u1ED1c \u0111\u1ED9 di chuy\u1EC3n"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138197
    m_Localized: "T\u1ED1c \u0111\u1ED9 t\u1EA5n c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138198
    m_Localized: "T\u1EF7 l\u1EC7 ch\xED m\u1EA1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138199
    m_Localized: "Thi\u1EC7t h\u1EA1i nghi\xEAm tr\u1ECDng"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138200
    m_Localized: "Gi\u1EA3m th\u1EDDi gian h\u1ED3i chi\xEAu"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138201
    m_Localized: "H\xFAt m\xE1u"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138202
    m_Localized: "h\u01B0 h\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138203
    m_Localized: "Thi\u1EC7t h\u1EA1i \u0111\xE3 nh\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138204
    m_Localized: "S\xE1t th\u01B0\u01A1ng c\u1EADn chi\u1EBFn"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138205
    m_Localized: "S\xE1t th\u01B0\u01A1ng t\u1EA7m xa"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138206
    m_Localized: "S\xE1t th\u01B0\u01A1ng k\u1EF9 n\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 442167561138207
    m_Localized: "S\xE1t th\u01B0\u01A1ng t\u1ED1i th\u01B0\u1EE3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 3001745419120640
    m_Localized: "K\u1EF9 n\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 3001745490423808
    m_Localized: "\u0110\u1EB7c bi\u1EC7t"
    m_Metadata:
      m_Items: []
  - m_Id: 3001745490423809
    m_Localized: "T\u1ED1i \u0111a {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 3001745490423811
    m_Localized: "B\u1EADc th\u1EA7y c\u1EE7a nh\u1EEFng c\xFA \u0111\xE1nh m\u1ED9t
      ph\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 3001745490423812
    m_Localized: "B\u1EA1n l\xE0 b\u1EADc th\u1EA7y c\u1EE7a chi\xEAu th\u1EE9c \"M\u1ED9t
      \u0110\xF2n \u0110\xE1nh\".\n\nL\xE0 m\u1ED9t l\u1EDBp nh\xE2n v\u1EADt s\u1EED
      d\u1EE5ng v\u0169 kh\xED c\u1EADn chi\u1EBFn, b\u1EA1n s\u1EBD qu\xE9t s\u1EA1ch
      k\u1EBB th\xF9 b\u1EB1ng k\u1EF9 n\u0103ng t\xEDch l\u1EF1c m\u1EA1nh m\u1EBD
      \"M\u1ED9t \u0110\xF2n \u0110\xE1nh\"."
    m_Metadata:
      m_Items: []
  - m_Id: 3004699647782912
    m_Localized: "th\u1ED5i"
    m_Metadata:
      m_Items: []
  - m_Id: 3004699710697472
    m_Localized: "th\u1ED5i"
    m_Metadata:
      m_Items: []
  - m_Id: 3004699710697473
    m_Localized: "Khi th\u1EF1c hi\u1EC7n \u0111\xF2n t\u1EA5n c\xF4ng c\u01A1 b\u1EA3n
      b\u1EB1ng v\u0169 kh\xED c\u1EADn chi\u1EBFn, b\u1EA1n lao v\u1EC1 ph\xEDa
      tr\u01B0\u1EDBc \u0111\u1ED3ng th\u1EDDi ch\xE9m li\xEAn t\u1EE5c.\n\nS\xE1t
      th\u01B0\u01A1ng c\u1EE7a \u0111\xF2n t\u1EA5n c\xF4ng c\u01A1 b\u1EA3n b\u1EB1ng
      v\u0169 kh\xED c\u1EADn chi\u1EBFn t\u0103ng l\xEAn 400%.\n\nB\u1EA1n ph\u1EA3i
      l\u1EA5p \u0111\u1EA7y thanh \"One-Shot\" sau khi s\u1EED d\u1EE5ng m\u1ED9t
      \u0111\xF2n t\u1EA5n c\xF4ng \u0111\u1EC3 c\xF3 th\u1EC3 t\u1EA5n c\xF4ng l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 3004699710697474
    m_Localized: "Thanh n\u0103ng l\u01B0\u1EE3ng 'One-Shot' t\u0103ng 3% m\u1ED7i
      gi\xE2y khi di chuy\u1EC3n v\xE0 5% khi t\u1EA5n c\xF4ng k\u1EBB \u0111\u1ECBch
      b\u1EB1ng \u0111\xF2n t\u1EA5n c\xF4ng c\u01A1 b\u1EA3n."
    m_Metadata:
      m_Items: []
  - m_Id: 3004699710697475
    m_Localized: "ch\xE2n nhanh"
    m_Metadata:
      m_Items: []
  - m_Id: 3004699714891776
    m_Localized: "T\u1ED1c \u0111\u1ED9 di chuy\u1EC3n t\u0103ng th\xEAm 1."
    m_Metadata:
      m_Items: []
  - m_Id: 3004699714891778
    m_Localized: "H\xEDt th\u1EDF s\xE2u n\xE0o!"
    m_Metadata:
      m_Items: []
  - m_Id: 3004699714891779
    m_Localized: "T\u0103ng ngay l\u1EADp t\u1EE9c 50% thanh \u0111o One-Hit Gauge."
    m_Metadata:
      m_Items: []
  - m_Id: 3004699714891780
    m_Localized: "B\u1EADc th\u1EA7y c\u1EE7a nh\u1EEFng c\xFA \u0111\xE1nh m\u1ED9t
      ph\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 3004699714891781
    m_Localized: "Khi s\u1EED d\u1EE5ng, b\u1EA1n s\u1EBD b\u01B0\u1EDBc v\xE0o tr\u1EA1ng
      th\xE1i 'B\u1EADc th\u1EA7y m\u1ED9t \u0111\xF2n' trong 8 gi\xE2y.\n\nL\u01B0\u1EE3ng
      n\u0103ng l\u01B0\u1EE3ng 'M\u1ED9t \u0111\xF2n' nh\u1EADn \u0111\u01B0\u1EE3c
      t\u1EEB di chuy\u1EC3n v\xE0 c\xE1c \u0111\xF2n t\u1EA5n c\xF4ng c\u01A1 b\u1EA3n
      \u0111\u01B0\u1EE3c t\u0103ng l\xEAn 300%.\n\nTrong tr\u1EA1ng th\xE1i 'B\u1EADc
      th\u1EA7y m\u1ED9t \u0111\xF2n', m\u1ED7i l\u1EA7n t\u1EA5n c\xF4ng b\u1EB1ng
      'M\u1ED9t \u0111\xF2n' s\u1EBD l\u1EADp t\u1EE9c l\u1EA5p \u0111\u1EA7y thanh
      n\u0103ng l\u01B0\u1EE3ng 'M\u1ED9t \u0111\xF2n' l\xEAn 100%."
    m_Metadata:
      m_Items: []
  - m_Id: 3004699714891782
    m_Localized: "T\u1ED1c \u0111\u1ED9 di chuy\u1EC3n t\u0103ng th\xEAm 2 trong
      su\u1ED1t th\u1EDDi gian \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 4030871831687168
    m_Localized: "khu v\u1EF1c l\xE2n c\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 4030871894601728
    m_Localized: "C\xF3 th\u1EC3 m\xEA ho\u1EB7c"
    m_Metadata:
      m_Items: []
  - m_Id: 4030871894601729
    m_Localized: "Kh\xF4ng th\u1EC3 b\u1ECB y\u1EC3m b\xF9a"
    m_Metadata:
      m_Items: []
  - m_Id: 4030871894601730
    m_Localized: "\xE1o gi\xE1p"
    m_Metadata:
      m_Items: []
  - m_Id: 4030871894601731
    m_Localized: "n\xE9m b\xF3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4030871894601732
    m_Localized: "\u0111\xF4i gi\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 4030871894601733
    m_Localized: "C\u1EA3 hai tay"
    m_Metadata:
      m_Items: []
  - m_Id: 4030871894601734
    m_Localized: "s\u1EF1 n\u1EB7ng n\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 4031231723941888
    m_Localized: "n\u1EC1n t\u1EA3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4071974098284544
    m_Localized: "M\xEA ho\u1EB7c"
    m_Metadata:
      m_Items: []
  - m_Id: 4071974161199104
    m_Localized: "Kh\xF4ng c\xF3 ph\xE9p thu\u1EADt n\xE0o \u0111\u01B0\u1EE3c \xE1p
      d\u1EE5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 5221716563963904
    m_Localized: "\u0110i\u1EC3m k\u1EF9 n\u0103ng {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072768
    m_Localized: "C\u1EA5p \u0111\u1ED9 {0} / {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072769
    m_Localized: "Mua +1 \u0110i\u1EC3m K\u1EF9 n\u0103ng \u2014 B\u1EA1n c\xF3 th\u1EC3
      n\xE2ng c\u1EA5p b\u1EA5t k\u1EF3 k\u1EF9 n\u0103ng n\xE0o trong B\u1EA3ng
      K\u1EF9 n\u0103ng (F1)."
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072770
    m_Localized: "Lo\u1EA1i b\u1ECF t\u1EA5t c\u1EA3 c\xE1c hi\u1EC7u \u1EE9ng c\u01B0\u1EDDng
      h\xF3a v\u0169 kh\xED hi\u1EC7n t\u1EA1i (Linh h\u1ED3n +{0} m\u1ED7i c\u1EA5p
      \u0111\u1ED9)"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072771
    m_Localized: "Ph\xE9p thu\u1EADt \u0111\u1EB7c bi\u1EC7t"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072772
    m_Localized: "Ch\u1ECDn Ph\xE9p Thu\u1EADt \u0110\u1EB7c Bi\u1EC7t"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072773
    m_Localized: "Chuy\u1EC3n sang ch\u1EBF \u0111\u1ED9 ph\xF9 ph\xE9p th\xF4ng
      th\u01B0\u1EDDng"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072774
    m_Localized: "Ch\u1ECDn m\u1ED9t ph\xE9p thu\u1EADt \u0111\u1EB7c bi\u1EC7t"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072775
    m_Localized: "{0} {1} ({2} gi\xE2y) khi ch\u1EA1m"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072776
    m_Localized: "G\xE2y th\xEAm s\xE1t th\u01B0\u01A1ng b\u1EB1ng {0}% m\xE1u t\u1ED1i
      \u0111a c\u1EE7a m\u1EE5c ti\xEAu khi tr\xFAng \u0111\xEDch."
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072777
    m_Localized: "Thay v\xEC kh\xF4ng th\u1EC3 h\xFAt sinh l\u1EF1c, h\xE3y chuy\u1EC3n
      \u0111\u1ED5i {0}% l\u01B0\u1EE3ng sinh l\u1EF1c \u0111\xE3 h\xFAt th\xE0nh
      s\xE1t th\u01B0\u01A1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072778
    m_Localized: "s\u1EF1 ch\u1EC9 \u0111\u1ECBnh"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072779
    m_Localized: Next Enchant Designation
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072780
    m_Localized: "Ph\xE9p thu\u1EADt \u0111\u1EB7c bi\u1EC7t"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716631072781
    m_Localized: "Ph\xE9p thu\u1EADt th\xF4ng th\u01B0\u1EDDng"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267075
    m_Localized: "tay kh\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267076
    m_Localized: "V\u1EDBi th\u1EE9 n\xE0y, b\u1EA1n c\xF3 th\u1EC3 l\xE0m \u0111\u01B0\u1EE3c
      m\u1ECDi th\u1EE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267077
    m_Localized: "dao g\u0103m"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267078
    m_Localized: "\u0110\xE2y l\xE0 m\u1ED9t thanh ki\u1EBFm r\u1EA5t \u0111\u01A1n
      gi\u1EA3n."
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267079
    m_Localized: "cung g\u1ED7"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267080
    m_Localized: "C\u0169ng t\u1EA1m \u0111\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267081
    m_Localized: "g\u1EADy \u0111i b\u1ED9 b\u1EB1ng g\u1ED7"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267082
    m_Localized: "\u0110\xE1ng s\u1EE3 qu\xE1!"
    m_Metadata:
      m_Items: []
  - m_Id: 5221716635267083
    m_Localized: AK47
    m_Metadata:
      m_Items: []
  - m_Id: 5221716639461376
    m_Localized: "Ch\u1EC9 v\u1EDBi \u0111i\u1EC1u n\xE0y th\xF4i, b\xE0 t\xF4i c\u0169ng
      \u0111\xE3 c\xF3 th\u1EC3 tr\u1EDF th\xE0nh m\u1ED9t huy\u1EC1n tho\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 5227191309283328
    m_Localized: "s\u1EF1 ch\u1EADm l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837760
    m_Localized: "L\xE0m ch\u1EADm t\u1ED1c \u0111\u1ED9 di chuy\u1EC3n c\u1EE7a
      m\u1EE5c ti\xEAu \u0111i {v0}% trong {d0} gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837761
    m_Localized: "ch\xE1y"
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837762
    m_Localized: "G\xE2y hi\u1EC7u \u1EE9ng <color=orange>Burn</color> l\xEAn m\u1EE5c
      ti\xEAu trong {d0} gi\xE2y, g\xE2y s\xE1t th\u01B0\u01A1ng c\u1ED1 \u0111\u1ECBnh
      b\u1EB1ng {v0}% m\xE1u t\u1ED1i \u0111a m\u1ED7i gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837763
    m_Localized: "b\u1EE9c t\u01B0\u1EE3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837764
    m_Localized: "G\xE2y hi\u1EC7u \u1EE9ng <color=#00BBFF>B\u1ECFng l\u1EA1nh</color>
      l\xEAn m\u1EE5c ti\xEAu trong {d0} gi\xE2y, gi\u1EA3m t\u1ED1c \u0111\u1ED9
      t\u1EA5n c\xF4ng c\u1EE7a m\u1EE5c ti\xEAu \u0111i {v1}%."
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837765
    m_Localized: "ph\xE1n quy\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837766
    m_Localized: "Khi t\u1EA5n c\xF4ng, g\xE2y th\xEAm <b>s\xE1t th\u01B0\u01A1ng
      c\u1ED1 \u0111\u1ECBnh b\u1EB1ng {v0}% HP t\u1ED1i \u0111a c\u1EE7a m\u1EE5c
      ti\xEAu</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837767
    m_Localized: "Tham \u0103n"
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837768
    m_Localized: "H\u1ED3i ph\u1EE5c {v0}% s\xE1t th\u01B0\u01A1ng g\xE2y ra b\u1EDFi
      v\u0169 kh\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 5448237727723520
    m_Localized: "ng\u1ED9 \u0111\u1ED9c"
    m_Metadata:
      m_Items: []
  - m_Id: 5448237761277952
    m_Localized: "V\u1EDBi x\xE1c su\u1EA5t {0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 5448237761277953
    m_Localized: "H\xFAt m\xE1u {0}% s\xE1t th\u01B0\u01A1ng g\xE2y ra khi tr\xFAng
      \u0111\xF2n"
    m_Metadata:
      m_Items: []
  - m_Id: 5448237761277954
    m_Localized: "G\xE2y th\xEAm {1}% s\xE1t th\u01B0\u01A1ng cho m\u1EE5c ti\xEAu
      c\xF3 l\u01B0\u1EE3ng m\xE1u {0}% tr\u1EDF xu\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 5448237761277955
    m_Localized: "Xuy\xEAn th\u1EE7ng {0}% h\xE0ng ph\xF2ng th\u1EE7 c\u1EE7a m\u1EE5c
      ti\xEAu"
    m_Metadata:
      m_Items: []
  - m_Id: 5452611497603072
    m_Localized: Seohwasang
    m_Metadata:
      m_Items: []
  - m_Id: 5452611497603073
    m_Localized: "G\xE2y hi\u1EC7u \u1EE9ng thi\xEAu \u0111\u1ED1t m\u1EE5c ti\xEAu
      trong {d0} gi\xE2y, g\xE2y s\xE1t th\u01B0\u01A1ng c\u1ED1 \u0111\u1ECBnh b\u1EB1ng
      {v0}% m\xE1u t\u1ED1i \u0111a c\u1EE7a m\u1EE5c ti\xEAu m\u1ED7i gi\xE2y v\xE0
      gi\u1EA3m t\u1ED1c \u0111\u1ED9 t\u1EA5n c\xF4ng c\u1EE7a m\u1EE5c ti\xEAu
      \u0111i {v1}%."
    m_Metadata:
      m_Items: []
  - m_Id: 5452611497603074
    m_Localized: "ng\u1ED9 \u0111\u1ED9c"
    m_Metadata:
      m_Items: []
  - m_Id: 5452611497603075
    m_Localized: "G\xE2y \u0111\u1ED9c cho m\u1EE5c ti\xEAu trong {d0} gi\xE2y, g\xE2y
      s\xE1t th\u01B0\u01A1ng b\u1EB1ng {v0}% m\xE1u t\u1ED1i \u0111a m\u1ED7i gi\xE2y
      cho m\u1ED7i c\u1ED9ng d\u1ED3n. (T\u1ED1i \u0111a {s0} c\u1ED9ng d\u1ED3n)"
    m_Metadata:
      m_Items: []
  - m_Id: 5452611497603076
    m_Localized: "v\u1EBFt r\xE1ch"
    m_Metadata:
      m_Items: []
  - m_Id: 5452611497603077
    m_Localized: "T\u1EA5t c\u1EA3 hi\u1EC7u \u1EE9ng h\u1ED3i ph\u1EE5c m\xE0 m\u1EE5c
      ti\xEAu nh\u1EADn \u0111\u01B0\u1EE3c s\u1EBD b\u1ECB gi\u1EA3m \u0111i {v0}%
      trong {d0} gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 5452611497603078
    m_Localized: "s\u1EA5m s\xE9t"
    m_Metadata:
      m_Items: []
  - m_Id: 5452611497603079
    m_Localized: "Khi tr\xFAng \u0111\xEDch, c\xF3 {c0}% kh\u1EA3 n\u0103ng m\u1EE5c
      ti\xEAu s\u1EBD b\u1ECB <color=yellow>cho\xE1ng</color> trong {d0} gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 5452611497603080
    m_Localized: "D\xF2ng m\xE1u"
    m_Metadata:
      m_Items: []
  - m_Id: 5452611497603081
    m_Localized: "B\u1EA1n kh\xF4ng th\u1EC3 h\xFAt m\xE1u b\u1EB1ng v\u0169 kh\xED
      n\xE0y. Thay v\xE0o \u0111\xF3, n\xF3 g\xE2y th\xEAm s\xE1t th\u01B0\u01A1ng
      b\u1EB1ng {v0}% l\u01B0\u1EE3ng h\xFAt m\xE1u."
    m_Metadata:
      m_Items: []
  - m_Id: 5887265010724864
    m_Localized: "Ng\u01B0\u1EDDi ch\u01A1i {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 5887265069445120
    m_Localized: "Ng\u01B0\u1EDDi ch\u01A1i {0} Chi\u1EBFn th\u1EAFng!"
    m_Metadata:
      m_Items: []
  - m_Id: 5887265069445121
    m_Localized: "{0} Linh h\u1ED3n"
    m_Metadata:
      m_Items: []
  - m_Id: 5887265069445122
    m_Localized: "V\xF2ng m\u1EDBi sau {0} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183884423168
    m_Localized: C
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171904
    m_Localized: B
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171905
    m_Localized: A
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171906
    m_Localized: S
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171907
    m_Localized: "\u0110i\u1EC1u tr\u1ECB {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171908
    m_Localized: "s\u1EF1 ti\u1EBFn h\xF3a"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171909
    m_Localized: "\u0110i\u1EC1u tr\u1ECB {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171910
    m_Localized: "T\u0103ng c\u01B0\u1EDDng {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171911
    m_Localized: "T\u1EEB B\xE0i h\u1ECDc 0"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171912
    m_Localized: "L\u1EF1a ch\u1ECDn l\u1EDBp h\u1ECDc"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171913
    m_Localized: "Th\u1EDDi gian c\xF2n l\u1EA1i {0} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171914
    m_Localized: "\u21BB L\xE0m m\u1EDBi ({0})"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171915
    m_Localized: "S\u1ED0 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171917
    m_Localized: "M\u1ED9t ng\u01B0\u1EDDi ch\u01A1i kh\xE1c \u0111ang l\u1EF1a ch\u1ECDn"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171918
    m_Localized: "C\xF2n l\u1EA1i {0} ng\u01B0\u1EDDi"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171919
    m_Localized: "Th\u1EDDi kh\u1EAFc b\xE1o th\xF9"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171920
    m_Localized: "H\xE3y ti\xEAu di\u1EC7t {0} k\u1EBB \u0111\xE3 gi\u1EBFt b\u1EA1n
      trong v\xF2ng {1} gi\xE2y!"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171921
    m_Localized: "Tr\u1EA3 th\xF9 th\xE0nh c\xF4ng! T\u1ED1c \u0111\u1ED9 di chuy\u1EC3n,
      m\xE1u t\u1ED1i \u0111a v\xE0 s\u1EE9c t\u1EA5n c\xF4ng t\u0103ng {0}% cho
      \u0111\u1EBFn khi b\u1EA1n ch\u1EBFt l\u1EA7n ti\u1EBFp theo!"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171922
    m_Localized: "Cu\u1ED1n s\u1ED5 t\u1EED th\u1EA7n"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171923
    m_Localized: "C\u01A1n \u0111au tim sau {0} \u2014 {1} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171924
    m_Localized: chung
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171925
    m_Localized: "\u0111\u1ED3 h\u1ECDa"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171926
    m_Localized: "\xE2m thanh"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171927
    m_Localized: "ho\u1EA1t \u0111\u1ED9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171928
    m_Localized: "\u0110i\u1EC3m ng\u1EAFm"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171929
    m_Localized: "Tr\xF2 chuy\u1EC7n \xB7 Tho\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171930
    m_Localized: "HUD \xB7 Kh\u1EA3 n\u0103ng ti\u1EBFp c\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171931
    m_Localized: "ng\xF4n ng\u1EEF"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171932
    m_Localized: "K\u1EF9 n\u0103ng \u2014 S\u1EED d\u1EE5ng khi t\xE1ch r\u1EDDi"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171933
    m_Localized: "N\u1EBFu b\u1EA1n t\u1EAFt n\xF3 \u0111i, n\xF3 s\u1EBD \u0111\u01B0\u1EE3c
      s\u1EED d\u1EE5ng ngay khi b\u1EA1n nh\u1EA5n n\xFAt."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171934
    m_Localized: "G\u1EA1ch ngang \u2014 Theo h\u01B0\u1EDBng b\u1EA1n \u0111ang
      nh\xECn"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171935
    m_Localized: "T\u1EAFt ch\u1EE9c n\u0103ng n\xE0y s\u1EBD khi\u1EBFn b\u1EA1n
      lao nhanh theo h\u01B0\u1EDBng di chuy\u1EC3n (ch\u1EC9 lao nhanh theo h\u01B0\u1EDBng
      di chuy\u1EC3n)."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171936
    m_Localized: "T\u1EF1 \u0111\u1ED9ng nh\u1EB7t v\u0169 kh\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171937
    m_Localized: "N\u1EBFu b\u1EA1n t\u1EAFt n\xF3 \u0111i, h\xE3y nh\u1EB7t n\xF3
      l\xEAn b\u1EB1ng ph\xEDm t\u01B0\u01A1ng t\xE1c (Linh h\u1ED3n v\xE0 \u0110\xE1
      lu\xF4n \u0111\u01B0\u1EE3c nh\u1EB7t t\u1EF1 \u0111\u1ED9ng)."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171938
    m_Localized: "Ch\u1EBF \u0111\u1ED9 m\xE0n h\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171939
    m_Localized: "\u0110i\u1EC1u n\xE0y kh\xF4ng \xE1p d\u1EE5ng trong tr\xECnh ch\u1EC9nh
      s\u1EEDa (ch\u1EC9 \xE1p d\u1EE5ng trong qu\xE1 tr\xECnh bi\xEAn d\u1ECBch)."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171940
    m_Localized: "Ngh\u1ECB quy\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171941
    m_Localized: "\u0110i\u1EC1u n\xE0y kh\xF4ng \xE1p d\u1EE5ng trong tr\xECnh ch\u1EC9nh
      s\u1EEDa (ch\u1EC9 \xE1p d\u1EE5ng trong qu\xE1 tr\xECnh bi\xEAn d\u1ECBch)."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171942
    m_Localized: "\u0110\u1ED3ng b\u1ED9 h\xF3a theo chi\u1EC1u d\u1ECDc"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171943
    m_Localized: "N\u1EBFu b\u1EA1n b\u1EADt ch\u1EE9c n\u0103ng n\xE0y, gi\u1EDBi
      h\u1EA1n FPS s\u1EBD b\u1ECB b\u1ECF qua."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171944
    m_Localized: "Gi\u1EDBi h\u1EA1n FPS"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171945
    m_Localized: "ch\u1EA5t l\u01B0\u1EE3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171946
    m_Localized: "Hi\u1EC3n th\u1ECB t\u1EF7 l\u1EC7"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171947
    m_Localized: "N\u1EBFu b\u1EA1n gi\u1EA3m \u0111\u1ED9 ph\xE2n gi\u1EA3i xu\u1ED1ng,
      h\xECnh \u1EA3nh s\u1EBD m\u1EDD h\u01A1n nh\u01B0ng nhanh h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171948
    m_Localized: "bo\u0301ng t\xF4\u0301i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171949
    m_Localized: "G\xF3c nh\xECn (FOV)"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183922171950
    m_Localized: "K\xEDch th\u01B0\u1EDBc chi\u1EC1u d\u1ECDc \u2014 M\u1EB7c \u0111\u1ECBnh
      75"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366208
    m_Localized: "to\xE0n b\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366209
    m_Localized: "hi\u1EC7u \u1EE9ng \xE2m thanh"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366210
    m_Localized: "\xE2m nh\u1EA1c"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366211
    m_Localized: "Ti\u1EBFng n\xF3i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366212
    m_Localized: "\xE2m thanh giao di\u1EC7n ng\u01B0\u1EDDi d\xF9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366213
    m_Localized: "\u0110\u1ED9 nh\u1EA1y c\u1EE7a chu\u1ED9t"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366214
    m_Localized: "\u0110\u1EA3o ng\u01B0\u1EE3c chu\u1ED9t l\xEAn v\xE0 xu\u1ED1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366215
    m_Localized: "\u0110\u1EB7t t\u1EA5t c\u1EA3 c\xE1c kh\xF3a v\u1EC1 gi\xE1 tr\u1ECB
      m\u1EB7c \u0111\u1ECBnh."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366216
    m_Localized: "m\u1EB7c \u0111\u1ECBnh"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366217
    m_Localized: "C\xE1c ph\xEDm tho\u1EA1i (Chat \xB7 Tab Tho\u1EA1i) c\u0169ng
      \u0111\u01B0\u1EE3c \u0111\u1EB7t l\u1EA1i. N\u1EBFu c\xF9ng m\u1ED9t ph\xEDm
      \u0111\u01B0\u1EE3c nh\u1EADp, c\xE1c ph\xEDm cho hai h\xE0nh \u0111\u1ED9ng
      s\u1EBD \u0111\u01B0\u1EE3c ho\xE1n \u0111\u1ED5i v\u1ECB tr\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366218
    m_Localized: "Hi\u1EC3n th\u1ECB \u0111i\u1EC3m ng\u1EAFm"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366219
    m_Localized: "\u0110i\u1EC3m ng\u1EAFm b\u1EAFn gi\u1ED1ng nhau tr\xEAn t\u1EA5t
      c\u1EA3 c\xE1c lo\u1EA1i v\u0169 kh\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366220
    m_Localized: "m\xE0u s\u1EAFc"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366221
    m_Localized: "ph\xE1c th\u1EA3o"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366222
    m_Localized: "\u0110\u1ED9 d\xE0y c\u1EE7a vi\u1EC1n"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366223
    m_Localized: "\u0110\u1ED9 d\xE0y vi\u1EC1n"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366224
    m_Localized: "d\u1EA5u ch\u1EA5m gi\u1EEFa"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366225
    m_Localized: "K\xEDch th\u01B0\u1EDBc ch\u1EA5m"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366226
    m_Localized: "\u0110\u1ED9 d\xE0y ch\u1EA5m"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366227
    m_Localized: "\u0111\u01B0\u1EDDng b\xEAn trong"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366228
    m_Localized: "chi\u1EC1u d\xE0i \u0111\u01B0\u1EDDng b\xEAn trong"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366229
    m_Localized: "\u0111\u1ED9 d\xE0y \u0111\u01B0\u1EDDng k\u1EBB b\xEAn trong"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366230
    m_Localized: "Kho\u1EA3ng c\xE1ch d\xF2ng b\xEAn trong"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366231
    m_Localized: "\u0110\u1ED9 d\xE0y \u0111\u01B0\u1EDDng k\u1EBB b\xEAn trong"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366232
    m_Localized: "\u0110\u01B0\u1EDDng vi\u1EC1n b\xEAn trong \u2014 lan r\u1ED9ng
      khi di chuy\u1EC3n"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366233
    m_Localized: "\u0110\u01B0\u1EDDng vi\u1EC1n b\xEAn trong \u2014 lan r\u1ED9ng
      khi b\u1ECB b\u1EAFn"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366234
    m_Localized: "\u0111\u01B0\u1EDDng ngo\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366235
    m_Localized: "Chi\u1EC1u d\xE0i \u0111\u01B0\u1EDDng vi\u1EC1n ngo\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366236
    m_Localized: "\u0110\u1ED9 d\xE0y \u0111\u01B0\u1EDDng vi\u1EC1n ngo\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366237
    m_Localized: "Kho\u1EA3ng c\xE1ch d\xF2ng ngo\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366238
    m_Localized: "\u0110\u1ED9 d\xE0y \u0111\u01B0\u1EDDng vi\u1EC1n ngo\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366239
    m_Localized: "\u0110\u01B0\u1EDDng vi\u1EC1n ngo\xE0i \u2014 lan r\u1ED9ng khi
      di chuy\u1EC3n"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366240
    m_Localized: "\u0110\u01B0\u1EDDng vi\u1EC1n ngo\xE0i \u2014 lan r\u1ED9ng khi
      b\u1ECB b\u1EAFn"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366241
    m_Localized: "m\u1ED9t"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366242
    m_Localized: "K\xEDch th\u01B0\u1EDBc h\xECnh tr\xF2n"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366243
    m_Localized: "\u0110\u1ED9 d\xE0y v\xF2ng tr\xF2n"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366244
    m_Localized: "C\u01B0\u1EDDng \u0111\u1ED9 v\xF2ng tr\xF2n"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366245
    m_Localized: "H\xECnh tr\xF2n \u2014 lan r\u1ED9ng khi di chuy\u1EC3n"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366246
    m_Localized: "H\xECnh tr\xF2n \u2014 Lan r\u1ED9ng khi b\u1ECB b\u1EAFn"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366247
    m_Localized: "H\xECnh ch\u1EEF T (kh\xF4ng c\xF3 \u0111\u01B0\u1EDDng tr\xEAn
      c\xF9ng)"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366248
    m_Localized: "Th\u1EBF k\u1EF7 \u0111ang m\u1EDF ra"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366249
    m_Localized: "Hi\u1EC3n th\u1ECB c\u1EEDa s\u1ED5 tr\xF2 chuy\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366250
    m_Localized: "Ngay c\u1EA3 khi b\u1EA1n t\u1EAFt n\xF3 \u0111i, b\u1EA1n v\u1EABn
      c\xF3 th\u1EC3 nh\xECn th\u1EA5y n\xF3 n\u1EBFu m\u1EDF b\u1EB1ng ph\xEDm Enter."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366251
    m_Localized: "Ph\u01B0\u01A1ng ph\xE1p micro"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366252
    m_Localized: "B\u1EA5m v\xE0 n\xF3i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366253
    m_Localized: "M\u1EDF mic"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366254
    m_Localized: "\u0110\u1ED9 nh\u1EA1y ph\xE1t hi\u1EC7n gi\u1ECDng n\xF3i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366255
    m_Localized: "C\xE0ng v\u1EC1 ph\xEDa b\xEAn tr\xE1i, \u0111\u1ED9 nh\u1EA1y
      c\xE0ng cao."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366256
    m_Localized: mike
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366257
    m_Localized: "T\u1EAFt micr\xF4 tr\xF2 ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366258
    m_Localized: "T\u1EAFt micr\xF4 nh\xF3m"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366259
    m_Localized: "K\xEDch th\u01B0\u1EDBc gi\u1ECDng n\xF3i trong tr\xF2 ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366260
    m_Localized: "K\xEDch th\u01B0\u1EDBc gi\u1ECDng n\xF3i c\u1EE7a nh\xF3m"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366261
    m_Localized: "Tr\xF2 ch\u01A1i \u2014 Nh\u1EA5n v\xE0 n\xF3i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366262
    m_Localized: "ph\xEDm t\u1EAFt ti\u1EBFng micr\xF4 tr\xF2 ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366263
    m_Localized: "\u0110\u1ED9i \u2014 B\xE1o ch\xED v\xE0 ph\xE1t bi\u1EC3u"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366264
    m_Localized: "ph\xEDm t\u1EAFt ti\u1EBFng micr\xF4 nh\xF3m"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366265
    m_Localized: "M\u1EDF c\xE0i \u0111\u1EB7t gi\u1ECDng n\xF3i nhanh ch\xF3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366266
    m_Localized: "Ph\xEDm tho\u1EA1i m\u1EB7c \u0111\u1ECBnh"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366267
    m_Localized: "m\u1EB7c \u0111\u1ECBnh"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366268
    m_Localized: "Quay l\u1EA1i T \xB7 Y \xB7 K \xB7 L"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366269
    m_Localized: "K\xEDch th\u01B0\u1EDBc HUD"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366270
    m_Localized: "S\u1ED1 l\u01B0\u1EE3ng thi\u1EC7t h\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366271
    m_Localized: "T\xEAn \u1EDF ph\xEDa tr\xEAn \u0111\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366272
    m_Localized: "Thanh m\xE1u hi\u1EC3n th\u1ECB ph\xEDa tr\xEAn \u0111\u1EA7u b\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366273
    m_Localized: "M\xE0n h\xECnh rung l\u1EAFc (khi b\u1ECB va ch\u1EA1m \xB7 n\u1ED5)"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366274
    m_Localized: "M\xE0n h\xECnh rung l\u1EAFc khi \u0111i b\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366275
    m_Localized: "N\u1EBFu b\u1EA1n d\u1EC5 b\u1ECB say t\xE0u xe, h\xE3y gi\u1EA3m
      l\u01B0\u1EE3ng r\u01B0\u1EE3u."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366276
    m_Localized: "M\xE0n h\xECnh nh\u1EA5p nh\xE1y"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366277
    m_Localized: "Nh\u1EA5n n\xFAt d\u1EEBng"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366278
    m_Localized: "m\xE0u vi\u1EC1n \u0111\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366279
    m_Localized: "N\u1EBFu b\u1EA1n g\u1EB7p kh\xF3 kh\u0103n trong vi\u1EC7c ph\xE2n
      bi\u1EC7t m\xE0u s\u1EAFc, vui l\xF2ng thay \u0111\u1ED5i c\xE0i \u0111\u1EB7t."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366280
    m_Localized: "t\u1EEB b\xE2y gi\u1EDD tr\u1EDF \u0111i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366281
    m_Localized: "m\u1EB7t sau"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366282
    m_Localized: "b\xEAn tr\xE1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366283
    m_Localized: "Ph\u1EA3i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366284
    m_Localized: "Nh\u1EA3y"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366285
    m_Localized: "T\u1EA5n c\xF4ng c\u01A1 b\u1EA3n"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366286
    m_Localized: "K\u1EF9 n\u0103ng 1"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366287
    m_Localized: "K\u1EF9 n\u0103ng 2"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366288
    m_Localized: "K\u1EF9 n\u0103ng 3"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366289
    m_Localized: "T\u1ED1i th\u01B0\u1EE3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366290
    m_Localized: "Kh\u1EA3 n\u0103ng ng\u1EABu nhi\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183926366291
    m_Localized: "Kh\u1EA3 n\u0103ng ng\u1EABu nhi\xEAn 2 (Joker)"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560512
    m_Localized: "T\u01B0\u01A1ng t\xE1c (B\xE0n th\u1EDD \xB7 R\u01B0\u01A1ng \xB7
      Nh\u1EB7t \u0111\u1ED3)"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560513
    m_Localized: "V\u1EE9t b\u1ECF v\u0169 kh\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560514
    m_Localized: "V\u0169 kh\xED s\u1ED1 1"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560515
    m_Localized: "V\u0169 kh\xED s\u1ED1 2"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560516
    m_Localized: "V\u0169 kh\xED s\u1ED1 3"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560517
    m_Localized: "V\u0169 kh\xED s\u1ED1 4"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560518
    m_Localized: "V\u0169 kh\xED s\u1ED1 5"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560519
    m_Localized: "V\u0169 kh\xED s\u1ED1 6"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560520
    m_Localized: "V\u0169 kh\xED s\u1ED1 7"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560521
    m_Localized: "H\xE0ng t\u1ED3n kho"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560522
    m_Localized: "c\u1EEDa h\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560523
    m_Localized: "C\u1EEDa s\u1ED5 kh\u1EA3 n\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560524
    m_Localized: "Tr\xF2 chuy\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560525
    m_Localized: "\u0111\u1EE9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560526
    m_Localized: "Nh\u1EA5p chu\u1ED9t tr\xE1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560527
    m_Localized: "Nh\u1EA5p chu\u1ED9t ph\u1EA3i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560528
    m_Localized: "Nh\u1EA5p chu\u1ED9t v\xE0o b\xE1nh xe"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560529
    m_Localized: "M\u1EB7t chu\u1ED9t 1"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560530
    m_Localized: "M\u1EB7t chu\u1ED9t 2"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560531
    m_Localized: "D\u1ECBch chuy\u1EC3n sang tr\xE1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560532
    m_Localized: "D\u1ECBch chuy\u1EC3n sang ph\u1EA3i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560533
    m_Localized: "Ctrl tr\xE1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560534
    m_Localized: "Alt tr\xE1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560535
    m_Localized: "Ch\u1EBF \u0111\u1ED9 to\xE0n m\xE0n h\xECnh (kh\xF4ng vi\u1EC1n)"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560536
    m_Localized: "Ch\u1EBF \u0111\u1ED9 to\xE0n m\xE0n h\xECnh (\u0111\u1ED9c quy\u1EC1n)"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560537
    m_Localized: "Ch\u1EBF \u0111\u1ED9 c\u1EEDa s\u1ED5"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560538
    m_Localized: "N\u1ED7i s\u1EE3"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560539
    m_Localized: "th\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560540
    m_Localized: "\u1EDF gi\u1EEFa"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560541
    m_Localized: "chi\u1EC1u cao"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560542
    m_Localized: "M\xE0u \u0111\u1ECF (m\u1EB7c \u0111\u1ECBnh)"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560543
    m_Localized: "m\xE0u v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560544
    m_Localized: Jahong
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560545
    m_Localized: "m\xE0u xanh ng\u1ECDc"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560546
    m_Localized: "tr\u1EAFng"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560547
    m_Localized: "t\xF3m t\u1EAFt"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560548
    m_Localized: "xanh l\xE1 nh\u1EA1t"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560549
    m_Localized: "m\xE0u v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560550
    m_Localized: "m\xE0u xanh ng\u1ECDc"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560551
    m_Localized: "h\u1ED3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560552
    m_Localized: "m\xE0u \u0111\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560553
    m_Localized: "\u0111en"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560554
    m_Localized: "T\xF4i \u0111\xE3 sao ch\xE9p \u0111o\u1EA1n m\xE3 v\xE0o clipboard."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560555
    m_Localized: "T\xF4i \u0111\xE3 d\xE1n n\xF3 v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560556
    m_Localized: "Kh\xF4ng c\xF3 m\xE3 t\xE2m ng\u1EAFm n\xE0o tr\xEAn clipboard"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560557
    m_Localized: "T\xF4i \u0111\xE3 kh\xF4i ph\u1EE5c l\u1EA1i c\xE0i \u0111\u1EB7t
      m\u1EB7c \u0111\u1ECBnh."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560558
    m_Localized: "T\xF4i c\u0169ng \xE1p d\u1EE5ng ph\u01B0\u01A1ng ph\xE1p t\u01B0\u01A1ng
      t\u1EF1 cho c\xE1c lo\u1EA1i v\u0169 kh\xED kh\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560559
    m_Localized: "Kh\xF4ng c\xF3 h\u1EA1n ch\u1EBF"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560560
    m_Localized: "\u0110ang t\u1EA3i..."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560561
    m_Localized: "B\xE0n ph\xEDm s\u1ED1 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560562
    m_Localized: "chu\u1EA9n b\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560563
    m_Localized: "Nh\u1EA5n ph\xEDm\u2026 (Esc Cancel)"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560564
    m_Localized: "(tr\u1EF1c ti\u1EBFp)"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560565
    m_Localized: "ho\xE0n th\xE0nh!"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560566
    m_Localized: "Nh\u1EA5n th\xEAm m\u1ED9t l\u1EA7n n\u1EEFa \u0111\u1EC3 thi\u1EBFt
      l\u1EADp l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560567
    m_Localized: "C\xE1c nguy\xEAn t\u1EAFc c\u01A1 b\u1EA3n c\u1EE7a h\u1EC7 th\u1ED1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560568
    m_Localized: "c\xE0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560569
    m_Localized: "\u0110\xF3ng (Esc)"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560570
    m_Localized: "Ph\xEDm tho\u1EA1i n\u1EB1m trong tab 'Tr\xF2 chuy\u1EC7n \xB7
      Tho\u1EA1i'."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560571
    m_Localized: "s\xFAng"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560572
    m_Localized: "Cung t\xEAn \xB7 G\u1EADy"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560573
    m_Localized: "khu v\u1EF1c l\xE2n c\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560574
    m_Localized: "[Ch\u1EBF \u0111\u1ED9 t\xE2m ng\u1EAFm chung cho t\u1EA5t c\u1EA3
      v\u0169 kh\xED] \u0111\xE3 \u0111\u01B0\u1EE3c b\u1EADt, v\xEC v\u1EADy t\u1EA5t
      c\u1EA3 v\u0169 kh\xED \u0111\u1EC1u s\u1EED d\u1EE5ng t\xE2m ng\u1EAFm c\u1EE7a
      s\xFAng."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560575
    m_Localized: "Thay \u0111\u1ED5i h\xECnh n\u1EC1n xem tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560576
    m_Localized: "Xem phong tr\xE0o lan r\u1ED9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560577
    m_Localized: "Sao ch\xE9p m\xE3"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560578
    m_Localized: "D\xE1n m\xE3"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560579
    m_Localized: "V\u1EDBi v\u0169 kh\xED n\xE0y l\xE0m v\u0169 kh\xED m\u1EB7c \u0111\u1ECBnh."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560580
    m_Localized: "\u0110i\u1EC1u t\u01B0\u01A1ng t\u1EF1 c\u0169ng \xE1p d\u1EE5ng
      cho c\xE1c lo\u1EA1i v\u0169 kh\xED kh\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560581
    m_Localized: "th\u1EF1c \u0111\u01A1n"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560582
    m_Localized: "Ti\u1EBFp t\u1EE5c"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560583
    m_Localized: "c\xE0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560584
    m_Localized: "R\u1EDDi kh\u1ECFi ph\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560585
    m_Localized: "Tr\xF2 ch\u01A1i k\u1EBFt th\xFAc"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945284591616
    m_Localized: "TR\xCAN"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340352
    m_Localized: "T\u1EAFt"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340379
    m_Localized: "Hi\u1EC7p s\u0129 T\u1EED th\u1EA7n"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340388
    m_Localized: '{x:slash}'
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340401
    m_Localized: "Tham \u0103n"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340414
    m_Localized: "bo\u0301ng t\xF4\u0301i"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340418
    m_Localized: "K\u1EBB \u0111\u1ECBch b\u1ECB tr\xFAng \u0111\xF2n t\u1EEB V\u0169
      kh\xED B\xF3ng t\u1ED1i s\u1EBD b\u1ECB l\xE0m ch\u1EADm 10% trong 1 gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340427
    m_Localized: "B\u1EADc th\u1EA7y v\u0169 kh\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340431
    m_Localized: "B\u1EADc th\u1EA7y v\u0169 kh\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534726
    m_Localized: "Ng\u1EA1c nhi\xEAn thay, anh ta l\u1EA1i r\u1EA5t b\xECnh th\u01B0\u1EDDng
      v\xE0 thi\u1EBFu n\u0103ng l\u1EF1c."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340353
    m_Localized: "th\u1EE3 r\xE8n"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340354
    m_Localized: "B\u1EA1n l\xE0 th\u1EE3 r\xE8n.\n\nGi\u1EDBi h\u1EA1n c\u01B0\u1EDDng
      h\xF3a cho v\u0169 kh\xED t\u0103ng l\xEAn 100.\n\nB\u1EA1n c\xF3 th\u1EC3
      d\xF9ng Linh h\u1ED3n \u0111\u1EC3 thi\u1EBFt l\u1EADp c\u01B0\u1EDDng h\xF3a
      ti\u1EBFp theo theo gi\xE1 tr\u1ECB mong mu\u1ED1n."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340355
    m_Localized: "th\u1EE3 r\xE8n"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340357
    m_Localized: "m\u1ED9t c\u01A1 th\u1EC3 \u0111\u01B0\u1EE3c r\xE8n luy\u1EC7n
      t\u1ED1t"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340358
    m_Localized: "C\u01A1 th\u1EC3 b\u1EA1n ph\xF9 h\u1EE3p v\u1EDBi c\xF4ng vi\u1EC7c
      th\u1ED5i h\u01A1i.\n\nHP + {0:all}"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340360
    m_Localized: "Vung b\xFAa v\u1EC1 ph\xEDa tr\u01B0\u1EDBc \u0111\u1EC3 g\xE2y
      s\xE1t th\u01B0\u01A1ng {dmg:SmashCoef+SmashFlat} v\xE0 l\xE0m cho\xE1ng k\u1EBB
      \u0111\u1ECBch tr\xFAng \u0111\xF2n trong 0.25 gi\xE2y. Ngo\xE0i ra, gi\xE1p
      c\u1EE7a k\u1EBB \u0111\u1ECBch tr\xFAng \u0111\xF2n s\u1EBD b\u1ECB gi\u1EA3m
      {b:ArmorBreakPct}% trong 5 gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340361
    m_Localized: "v\u1EE5 phun tr\xE0o l\xF2 cao"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340362
    m_Localized: "Ph\xF3ng n\u1ED5 dung nham trong ph\u1EA1m vi {b:FurnaceRadius}m
      xung quanh, g\xE2y s\xE1t th\u01B0\u01A1ng {dmg:FurnaceCoef+FurnaceFlat}.\n\nM\xE1u
      c\xE0ng th\u1EA5p, s\u1EE9c m\u1EA1nh c\xE0ng t\u0103ng, t\u1ED1i \u0111a {b:FurnaceMaxMul}
      l\u1EA7n, v\xE0 c\xF3 {b:BurnChance:pct}% kh\u1EA3 n\u0103ng g\xE2y b\u1ECFng."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340363
    m_Localized: "N\xF3 \u0111\u1EA1t c\xF4ng su\u1EA5t t\u1ED1i \u0111a khi HP gi\u1EA3m
      xu\u1ED1ng c\xF2n 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340364
    m_Localized: "H\u1EADu du\u1EC7 c\u1EE7a l\u1EEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340365
    m_Localized: "Trong {b:UltDuration} gi\xE2y, to\xE0n th\xE2n b\u1EA1n \u0111\u01B0\u1EE3c
      bao ph\u1EE7 b\u1EDFi l\u1EEDa, tr\u1EDF th\xE0nh 'H\u1EADu du\u1EC7 c\u1EE7a
      L\u1EEDa'.\n\nK\u1EBB \u0111\u1ECBch t\u1EA5n c\xF4ng b\u1EA1n b\u1EB1ng \u0111\xF2n
      c\u1EADn chi\u1EBFn s\u1EBD ch\u1ECBu hi\u1EC7u \u1EE9ng Thi\xEAu \u0111\u1ED1t,
      v\xE0 t\u1EA5t c\u1EA3 hi\u1EC7u \u1EE9ng trang b\u1ECB \u0111\u01B0\u1EE3c
      t\u0103ng 25%. Ngo\xE0i ra, th\u1EDDi gian h\u1ED3i chi\xEAu c\u1EE7a 'V\u1EE5
      n\u1ED5 L\xF2 l\u1EEDa' \u0111\u01B0\u1EE3c \u0111\u1EB7t l\u1EA1i m\u1ED7i
      khi m\xE1u c\u1EE7a b\u1EA1n gi\u1EA3m 15%, v\xED d\u1EE5 nh\u01B0 \u1EDF m\u1EE9c
      85%, 70%, 55%, v.v."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340367
    m_Localized: "B\u1EADc th\u1EA7y s\xFAng"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340368
    m_Localized: "B\u1EA1n l\xE0 B\u1EADc th\u1EA7y c\u1EE7a m\u1ECDi lo\u1EA1i v\u0169
      kh\xED. M\u1ED9t B\u1EADc th\u1EA7y v\u0169 kh\xED c\xF3 th\u1EC3 ph\xF9 ph\xE9p
      t\u1EA5t c\u1EA3 c\xE1c lo\u1EA1i v\u0169 kh\xED v\xE0 nh\u1EADn \u0111\u01B0\u1EE3c
      c\xE1c thi\u1EBFt l\u1EADp hi\u1EC7u ch\u1EC9nh cho ch\xFAng."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340369
    m_Localized: "Ph\xE9p thu\u1EADt s\xFAng"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340370
    m_Localized: "B\u1EA1n c\xF3 th\u1EC3 ph\xF9 ph\xE9p cho s\xFAng."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340371
    m_Localized: "B\u1EADc th\u1EA7y v\u1EC1 v\u0169 kh\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340372
    m_Localized: "Khi trang b\u1ECB s\xFAng, T\u1ED1c \u0111\u1ED9 t\u1EA5n c\xF4ng
      t\u0103ng {0}% v\xE0 T\u1ED1c \u0111\u1ED9 di chuy\u1EC3n t\u0103ng {1}, \u0111\u1ED3ng
      th\u1EDDi S\xE1t th\u01B0\u01A1ng ch\xED m\u1EA1ng t\u0103ng th\xEAm {2}%.\n\nV\u0169
      kh\xED m\u1EB7c \u0111\u1ECBnh l\xE0 'Glock'."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340373
    m_Localized: "cu\u1ED9n"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340374
    m_Localized: "L\u0103n ng\u01B0\u1EDDi v\u1EC1 ph\xEDa tr\u01B0\u1EDBc \u0111\u1EC3
      k\xEDch ho\u1EA1t ch\u1EBF \u0111\u1ED9 N\xE9 tr\xE1nh trong 1 gi\xE2y.\n\nH\u1ED3i
      ph\u1EE5c 20% \u0111\u1EA1n d\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340375
    m_Localized: "b\u1EAFn ch\xEDnh x\xE1c"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340378
    m_Localized: "K\xEDch ho\u1EA1t 'Spray' trong 12 gi\xE2y, t\u0103ng t\u1ED1c
      \u0111\u1ED9 t\u1EA5n c\xF4ng c\u1EE7a b\u1EA1n l\xEAn {b:UltAtkSpeedPct:all}%
      v\xE0 nh\u1EADn \u0111\u01B0\u1EE3c 20% h\xFAt m\xE1u. Trong th\u1EDDi gian
      n\xE0y, thay v\xEC \u0111\u1EA1n b\u1EADt n\u1EA3y {b:UltRicochets:all} l\u1EA7n
      khi ch\u1EA1m t\u01B0\u1EDDng, \u0111\u1ED9 ph\xE2n t\xE1n c\u1EE7a \u0111\u1EA1n
      s\u1EBD t\u0103ng 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340380
    m_Localized: "B\u1EA1n l\xE0 ng\u01B0\u1EDDi \u0111\xE3 ch\u1EBFt t\u1EEB l\xE2u
      nh\u01B0ng v\xEC l\xFD do n\xE0o \u0111\xF3 \u0111\xE3 tr\u1EDF l\u1EA1i.\n\nKh\u1EA3
      n\u0103ng c\u1EE7a m\u1ED9t Hi\u1EC7p s\u0129 T\u1EED th\u1EA7n thay \u0111\u1ED5i
      t\xF9y thu\u1ED9c v\xE0o 't\xEAn' \u0111\u01B0\u1EE3c g\xE1n cho h\u1ECD.\n\nB\u1EA1n
      c\xF3 th\u1EC3 ch\u1EC9 l\xE0 m\u1ED9t ng\u01B0\u1EDDi n\xF4ng d\xE2n b\xECnh
      th\u01B0\u1EDDng, ho\u1EB7c b\u1EA1n c\xF3 th\u1EC3 l\xE0 m\u1ED9t ng\u01B0\u1EDDi
      v\u0129 \u0111\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340381
    m_Localized: "b\xF3ng r\xE2m"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340382
    m_Localized: "M\u1ED9t 'T\xEAn' ng\u1EABu nhi\xEAn \u0111\u01B0\u1EE3c g\xE1n.\n\nC\xE1c
      ch\u1EC9 s\u1ED1 v\xE0 hi\u1EC7u \u1EE9ng k\u1EF9 n\u0103ng b\u1ED5 sung s\u1EBD
      thay \u0111\u1ED5i t\xF9y thu\u1ED9c v\xE0o 'T\xEAn'.\n\nT\xEAn hi\u1EC7n t\u1EA1i:
      {x:nametag}"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340383
    m_Localized: "T\xEAn hi\u1EC7n t\u1EA1i: {x:nametag}\n\nTh\xF4ng tin b\u1ED5
      sung: {x:stats}"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340385
    m_Localized: "Khi m\xE1u c\u1EE7a b\u1EA1n \u0111\u1EA1t 50%, b\u1EA1n s\u1EBD
      chuy\u1EC3n sang tr\u1EA1ng th\xE1i 'Ma' trong {b:GhostTime} gi\xE2y v\xE0
      b\u1ECF qua t\u1EA5t c\u1EA3 c\xE1c v\xF9ng va ch\u1EA1m v\u1EADt l\xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340386
    m_Localized: "Thanh ki\u1EBFm c\u1EE7a th\u1EBF gi\u1EDBi ng\u1EA7m"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340387
    m_Localized: "T\u1EA5n c\xF4ng v\u1EC1 ph\xEDa tr\u01B0\u1EDBc v\u1EDBi s\u1EE9c
      m\u1EA1nh t\xE0 \xE1c, g\xE2y ra s\xE1t th\u01B0\u01A1ng {dmg:SlashCoef+SlashFlat}."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340389
    m_Localized: "c\u01B0\u1EE1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340390
    m_Localized: "C\u01B0\u1EE1i m\u1ED9t con ng\u1EF1a b\u1EA5t t\u1EED trong {b:MountDuration}
      gi\xE2y. Khi c\u01B0\u1EE1i ng\u1EF1a, t\u1ED1c \u0111\u1ED9 di chuy\u1EC3n
      c\u1EE7a b\u1EA1n t\u0103ng l\xEAn {b:MountSpeed} v\xE0 s\xE1t th\u01B0\u01A1ng
      nh\u1EADn v\xE0o gi\u1EA3m \u0111i {b:MountDamageReduce}%.\n\nS\u1EED d\u1EE5ng
      l\u1EA1i khi \u0111ang c\u01B0\u1EE1i ng\u1EF1a \u0111\u1EC3 lao v\u1EC1 ph\xEDa
      tr\u01B0\u1EDBc nhanh ch\xF3ng, g\xE2y ra {dmg:ChargeCoef} s\xE1t th\u01B0\u01A1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340391
    m_Localized: '{x:mount}'
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340392
    m_Localized: "M\xF9i t\u1EED th\u1EA7n"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340393
    m_Localized: "H\xE3y gi\xE1ng m\u1EA1nh thanh ki\u1EBFm b\u1ECB nguy\u1EC1n r\u1EE7a
      b\u1EB1ng ma thu\u1EADt h\u1EAFc \xE1m \u0111\u1EC3 g\xE2y s\xE1t th\u01B0\u01A1ng
      v\u0169 kh\xED {dmg:FinisherCoef+FinisherFlat} l\xEAn k\u1EBB \u0111\u1ECBch
      ph\xEDa tr\u01B0\u1EDBc, \u0111\u1ED3ng th\u1EDDi k\xEDch ho\u1EA1t m\u1ED9t
      v\u1EE5 n\u1ED5 ma thu\u1EADt h\u1EAFc \xE1m ph\xEDa tr\u01B0\u1EDBc, g\xE2y
      ra hi\u1EC7u \u1EE9ng \u0111\u1ED9c c\u1EF1c m\u1EA1nh."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340395
    m_Localized: "k\u1EBB h\xE1u \u0103n"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340397
    m_Localized: "ti\xEAu h\xF3a"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340398
    m_Localized: "k\u1EBB h\xE1u \u0103n"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340399
    m_Localized: "\u0102n m\u1ED9t v\u0169 kh\xED \u0111\u1EC3 nh\u1EADn \u0111\u01B0\u1EE3c
      {b:AbsorbRatio:pct}% \u0111i\u1EC3m thu\u1ED9c t\xEDnh v\u0129nh vi\u1EC5n.\n\n{x:digest}\n\n{x:absorbed}\n\n{x:specials}"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340400
    m_Localized: "B\u1EA1n nh\u1EADn \u0111\u01B0\u1EE3c d\u1EF1a tr\xEAn Ch\u1EC9
      s\u1ED1 c\u01A1 b\u1EA3n c\u1EE7a v\u0169 kh\xED \xD7 T\u1EF7 l\u1EC7 h\u1EA5p
      th\u1EE5 {b:AbsorbRatio*100:all}% \xD7 H\u1EC7 s\u1ED1 nh\xE2n c\u1EA5p \u0111\u1ED9.\n\nB\u1EA1n
      c\xF3 th\u1EC3 nh\u1EADn \u0111\u01B0\u1EE3c t\u1ED1i \u0111a {b:AbsorbEnchants*100:all}%
      hi\u1EC7u \u1EE9ng c\u01B0\u1EDDng h\xF3a, v\xE0 s\u1EED d\u1EE5ng v\u0169
      kh\xED \u0111\u1EB7c bi\u1EC7t s\u1EBD mang l\u1EA1i hi\u1EC7u \u1EE9ng \u0111\u1EB7c
      bi\u1EC7t v\u0129nh vi\u1EC5n.\n\nTh\u1EDDi gian ti\xEAu h\xF3a \u0111\u01B0\u1EE3c
      gi\u1EA3m t\u1ED1i \u0111a {b:DigestMul*100}% t\xF9y thu\u1ED9c v\xE0o c\u1EA5p
      \u0111\u1ED9 k\u1EF9 n\u0103ng."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340403
    m_Localized: "H\u1ED3i ph\u1EE5c l\u01B0\u1EE3ng m\xE1u b\u1EB1ng {b:DevourHealPct}%
      s\xE1t th\u01B0\u01A1ng g\xE2y ra."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340404
    m_Localized: "nh\u1ED5 ra"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340405
    m_Localized: "C\xF3 th\u1EC3 s\u1EED d\u1EE5ng khi b\u1EA1n v\u1EEBa ti\xEAu
      di\u1EC7t k\u1EBB th\xF9 ho\u1EB7c s\u1EED d\u1EE5ng v\u0169 kh\xED c\xF3 thu\u1ED9c
      t\xEDnh 'Tham lam'. Phun ch\u1EA5t n\xF4n v\u1EC1 ph\xEDa tr\u01B0\u1EDBc,
      g\xE2y s\xE1t th\u01B0\u01A1ng {dmg:SpitCoef+SpitFlat}."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340406
    m_Localized: "S\xE1t th\u01B0\u01A1ng c\u01A1 b\u1EA3n l\xE0 {dmg:SpitCoef+SpitFlat},
      v\xE0 g\xE2y th\xEAm s\xE1t th\u01B0\u01A1ng b\u1EB1ng {b:InheritKillAtkPct}%
      s\u1EE9c t\u1EA5n c\xF4ng c\u1EE7a m\u1EE5c ti\xEAu n\u1EBFu m\u1EE5c ti\xEAu
      l\xE0 ng\u01B0\u1EDDi ch\u01A1i, ho\u1EB7c {b:InheritWeaponAtkPct}% n\u1EBFu
      m\u1EE5c ti\xEAu l\xE0 v\u0169 kh\xED.\n\nS\xE1t th\u01B0\u01A1ng n\xE0y c\xF3
      th\u1EC3 b\u1ECB \u1EA3nh h\u01B0\u1EDFng b\u1EDFi c\xE1c kh\u1EA3 n\u0103ng
      ng\u1EABu nhi\xEAn c\u1EE7a k\u1EBB \u0111\u1ECBch ho\u1EB7c hi\u1EC7u \u1EE9ng
      c\u01B0\u1EDDng h\xF3a v\u0169 kh\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340407
    m_Localized: "Vi\u1EC7c \u0103n ph\u1EA3i nh\u1EEFng th\u1EF1c ph\u1EA9m kh\xF4ng
      t\u1ED1t cho s\u1EE9c kh\u1ECFe"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340408
    m_Localized: "H\xE3y h\u1EA5p th\u1EE5 v\u0169 kh\xED \u0111ang c\u1EA7m trong
      tay."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340413
    m_Localized: "B\u1EA1n lu\xF4n h\xE0nh \u0111\u1ED9ng theo b\u1EA3n n\u0103ng
      c\u1EE7a ch\xEDnh m\xECnh.\n\nH\xE3y t\u1EADn d\u1EE5ng b\u1EA3n n\u0103ng
      \u0111\xF3 \u0111\u1EC3 h\xE0nh \u0111\u1ED9ng quy\u1EBFt li\u1EC7t, \u0111\xF4i
      khi nhanh nh\u1EB9n, v\xE0 lan t\u1ECFa n\xF3 \u0111\u1EC3 th\u1ED1ng tr\u1ECB
      l\xE3nh th\u1ED5."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340416
    m_Localized: "V\u0169 kh\xED b\xF3ng t\u1ED1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340417
    m_Localized: "K\xEDch ho\u1EA1t V\u0169 kh\xED B\xF3ng t\u1ED1i trong {b:WeaponDuration:all}
      gi\xE2y.\n\nKhi t\u1EA5n c\xF4ng b\u1EB1ng v\u0169 kh\xED n\xE0y, \u1EA3o \u1EA3nh
      c\u1EE7a b\u1EA1n s\u1EBD t\u1EA5n c\xF4ng theo c\xF9ng h\u01B0\u1EDBng v\u1EDBi
      c\xF9ng v\u0169 kh\xED \u0111\xF3 sau m\u1ED9t kho\u1EA3ng th\u1EDDi gian ng\u1EAFn,
      g\xE2y s\xE1t th\u01B0\u01A1ng b\u1EB1ng {b:EchoPct:all}% s\u1EE9c m\u1EA1nh
      c\u01A1 b\u1EA3n."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340419
    m_Localized: "chuy\u1EC3n \u0111\u1ED9ng b\xF3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340420
    m_Localized: "Ho\xE1n \u0111\u1ED5i v\u1ECB tr\xED v\u1EDBi b\xF3ng c\u1EE7a
      b\u1EA1n \u0111\u1EC3 d\u1ECBch chuy\u1EC3n t\u1EE9c th\u1EDDi \u0111\u1EBFn
      v\u1ECB tr\xED b\u1EA1n \u0111ang nh\xECn.\n\nB\u1EA1n c\xF3 th\u1EC3 di chuy\u1EC3n
      t\u1ED1i \u0111a {b:MoveRange:all}m."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340421
    m_Localized: "B\xE0n Tay B\xF3ng T\u1ED1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340422
    m_Localized: "\u0110\u1EC3 l\u1EA1i m\u1ED9t <b>B\xE0n Tay B\xF3ng T\u1ED1i</b>
      t\u1EA1i v\u1ECB tr\xED b\u1EA1n \u0111ang nh\xECn. N\u1EBFu c\xF3 k\u1EBB
      \u0111\u1ECBch trong ph\u1EA1m vi {b:HandRadius:all}m c\u1EE7a <b>B\xE0n Tay
      B\xF3ng T\u1ED1i</b>, b\xE0n tay s\u1EBD v\u01B0\u01A1n ra ngo\xE0i.\n\nKhi
      tr\xFAng m\u1EE5c ti\xEAu, n\xF3 g\xE2y ra {dmg:HandCoef+HandFlat} s\xE1t th\u01B0\u01A1ng
      v\xE0 tr\xF3i ch\xE2n k\u1EBB \u0111\u1ECBch trong {b:HandRoot:all} gi\xE2y.\n\nB\u1EA1n
      c\xF3 th\u1EC3 \u0111\u1EC3 l\u1EA1i t\u1ED1i \u0111a {b:HandMax:all} B\xE0n
      Tay B\xF3ng T\u1ED1i tr\xEAn b\u1EA3n \u0111\u1ED3 c\xF9ng m\u1ED9t l\xFAc."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340424
    m_Localized: "B\xF3ng t\u1ED1i ho\xE0n to\xE0n"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340425
    m_Localized: "Ch\u1EC9 \u0111\u1ECBnh khu v\u1EF1c xung quanh l\xE0 <b>V\xF9ng
      B\xF3ng T\u1ED1i</b>, l\xE0m gi\u1EA3m \u0111\xE1ng k\u1EC3 t\u1EA7m nh\xECn
      c\u1EE7a k\u1EBB \u0111\u1ECBch b\xEAn trong v\xF9ng, ngo\u1EA1i tr\u1EEB ch\xEDnh
      b\u1EA1n.\n\nK\u1EBB \u0111\u1ECBch b\xEAn ngo\xE0i V\xF9ng B\xF3ng T\u1ED1i
      kh\xF4ng th\u1EC3 nh\xECn th\u1EA5y b\xEAn trong.\n\nB\xEAn trong V\xF9ng B\xF3ng
      T\u1ED1i, th\u1EDDi gian h\u1ED3i chi\xEAu c\u1EE7a K\u1EF9 n\u0103ng Di chuy\u1EC3n
      B\xF3ng T\u1ED1i c\u1EE7a Ng\u01B0\u1EDDi \u0110i B\u1ED9 B\xF3ng T\u1ED1i
      tr\u1EDF th\xE0nh {b:ZoneMoveCooldown:all} gi\xE2y, v\xE0 t\u1ED1c \u0111\u1ED9
      di chuy\u1EC3n c\u1EE7a h\u1ECD t\u0103ng l\xEAn {b:ZoneMoveSpeedPct:all}%."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340426
    m_Localized: "Ng\u01B0\u1EDDi \u0111i trong b\xF3ng t\u1ED1i c\xF3 th\u1EC3 x\xE1c
      \u0111\u1ECBnh v\u1ECB tr\xED t\u1EA5t c\u1EA3 k\u1EBB th\xF9 trong khu v\u1EF1c
      b\xF3ng t\u1ED1i."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340428
    m_Localized: "B\u1EA1n l\xE0 b\u1EADc th\u1EA7y v\u0169 kh\xED.\n\nKh\xF4ng gi\u1ED1ng
      nh\u01B0 nh\u1EEFng ng\u01B0\u1EDDi ch\u01A1i kh\xE1c, b\u1EA1n c\xF3 th\u1EC3
      mang theo t\u1ED1i \u0111a 8 v\u0169 kh\xED.\n\nNgay c\u1EA3 khi b\u1EA1n kh\xF4ng
      c\u1EA7m ch\xFAng, v\u0169 kh\xED v\u1EABn l\u01A1 l\u1EEDng b\xEAn c\u1EA1nh
      b\u1EA1n v\xE0 chi\u1EBFn \u0111\u1EA5u."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340430
    m_Localized: "S\u1ED1 l\u01B0\u1EE3ng v\u0169 kh\xED t\u1ED1i \u0111a b\u1EA1n
      c\xF3 th\u1EC3 mang theo t\u0103ng l\xEAn {b:SlotCount:all}."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340432
    m_Localized: "C\xE1c v\u0169 kh\xED kh\xE1c ngo\xE0i v\u0169 kh\xED \u0111ang
      trang b\u1ECB s\u1EBD l\u01A1 l\u1EEDng b\xEAn c\u1EA1nh b\u1EA1n.\n\nTrong
      khi chi\u1EBFn \u0111\u1EA5u, t\u1EA5n c\xF4ng theo h\u01B0\u1EDBng k\u1EBB
      \u0111\u1ECBch cu\u1ED1i c\xF9ng m\xE0 ng\u01B0\u1EDDi ch\u01A1i t\u1EA5n c\xF4ng
      m\u1ED7i {b:OrbitInterval:all} gi\xE2y, t\u1EF7 l\u1EC7 thu\u1EADn v\u1EDBi
      t\u1ED1c \u0111\u1ED9 t\u1EA5n c\xF4ng c\u1EE7a v\u0169 kh\xED, g\xE2y s\xE1t
      th\u01B0\u01A1ng b\u1EB1ng {b:OrbitCoef:all} + {b:WeaponAtkPct:all}% s\xE1t
      th\u01B0\u01A1ng c\u1EE7a v\u0169 kh\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340433
    m_Localized: "T\u1EA7m b\u1EAFn t\u1ED1i \u0111a l\xE0 {b:OrbitRange:all}m, v\xE0
      v\u0169 kh\xED t\u1EA7m xa kh\xF4ng th\u1EC3 \u0111\u01B0\u1EE3c \u0111i\u1EC1u
      khi\u1EC3n b\u1EDFi B\u1EADc th\u1EA7y v\u0169 kh\xED.\n\nCung t\xEAn v\xE0
      tr\u01B0\u1EE3ng d\u1EF1a tr\xEAn th\u1EDDi gian n\u1EA1p n\u0103ng l\u01B0\u1EE3ng
      100%.\n\nC\xE1c hi\u1EC7u \u1EE9ng \u0111\u1EB7c bi\u1EC7t tr\xEAn v\u0169
      kh\xED t\u01B0\u01A1ng \u1EE9ng c\xF3 50% c\u01A1 h\u1ED9i k\xEDch ho\u1EA1t,
      v\xE0 gi\xE1 tr\u1ECB c\u0169ng nh\u01B0 th\u1EDDi gian hi\u1EC7u l\u1EF1c
      c\u1EE7a ch\xFAng b\u1ECB gi\u1EA3m m\u1ED9t n\u1EEDa. (H\xFAt m\xE1u kh\xF4ng
      \xE1p d\u1EE5ng.)"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340435
    m_Localized: "S\u1ED1 l\u01B0\u1EE3ng \u0110\xE1 Ph\xE9p Thu\u1EADt nh\u1EADn
      \u0111\u01B0\u1EE3c s\u1EBD \u0111\u01B0\u1EE3c nh\xE2n v\u1EDBi {b:StoneGain:all}."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340436
    m_Localized: "y\xEAu c\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340437
    m_Localized: "C\xE1c v\u0169 kh\xED bay l\u01A1 l\u1EEDng lao v\u1EC1 h\u01B0\u1EDBng
      ch\xFAng \u0111ang \u0111\u1ED1i m\u1EB7t, g\xE2y s\xE1t th\u01B0\u01A1ng b\u1EB1ng
      s\u1ED1 l\u01B0\u1EE3ng v\u0169 kh\xED \xD7 {dmg:CommandCoef}."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340438
    m_Localized: "gia t\u1ED1c"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340439
    m_Localized: "Trong {b:HasteDuration:all} gi\xE2y, kho\u1EA3ng th\u1EDDi gian
      t\u1EA5n c\xF4ng c\u01A1 b\u1EA3n c\u1EE7a B\u1EADc th\u1EA7y v\u0169 kh\xED
      gi\u1EA3m \u0111i {b:HasteIntervalPct:all}%, v\xE0 t\u1ED1c \u0111\u1ED9 ra
      l\u1EC7nh t\u0103ng l\xEAn 50%."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340440
    m_Localized: "v\u0169 c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340441
    m_Localized: "B\u1EAFn t\u1EA5t c\u1EA3 v\u0169 kh\xED hi\u1EC7n \u0111ang l\u01A1
      l\u1EEDng t\u1EA1i \u0111i\u1EC3m b\u1EA1n \u0111ang nh\u1EAFm t\u1EDBi trong
      {b:DancerDuration:all} gi\xE2y.\n\nS\xE1t th\u01B0\u01A1ng c\u1EE7a v\u0169
      kh\xED b\u1ECB gi\u1EA3m t\u1ED1i \u0111a {b:DancerCoef:all}% trong th\u1EDDi
      gian n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340442
    m_Localized: "k\u1EBB h\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340443
    m_Localized: "B\u1EA1n l\xE0 qu\xE2n Joker c\u1EE7a tr\xF2 ch\u01A1i.\n\nB\u1EA1n
      lu\xF4n t\u1EA1o ra nh\u1EEFng bi\u1EBFn s\u1ED1 quan tr\u1ECDng v\xE0 s\u1EDF
      h\u1EEFu nh\u1EEFng kh\u1EA3 n\u0103ng kh\xF3 l\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340444
    m_Localized: "k\u1EBB h\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340445
    m_Localized: "B\u1EA1n lu\xF4n c\xF3 2 kh\u1EA3 n\u0103ng ng\u1EABu nhi\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340446
    m_Localized: "ni\u1EC1m vui"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340448
    m_Localized: "L\xE1 b\xE0i Joker"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340449
    m_Localized: "D\u1ECBch chuy\u1EC3n ng\u01B0\u1EE3c v\u1EC1 ph\xEDa sau, \u0111\u1EC3
      l\u1EA1i m\u1ED9t l\xE1 b\xE0i Joker \u1EDF v\u1ECB tr\xED ban \u0111\u1EA7u.
      N\u1EBFu ai \u0111\xF3 gi\u1EABm l\xEAn l\xE1 b\xE0i, n\xF3 s\u1EBD ph\xE1t
      n\u1ED5 sau m\u1ED9t th\u1EDDi gian ng\u1EAFn, g\xE2y ra s\xE1t th\u01B0\u01A1ng
      {dmg:BlastCoef+BlastFlat} v\xE0 l\xE0m ch\u1EADm h\u1ECD \u0111i {b:BlastSlowPct:all}%
      trong 2 gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340452
    m_Localized: "Th\xEAm {b:OneCardSeconds:all} gi\xE2y v\xE0o th\u1EDDi gian h\u1ED3i
      chi\xEAu c\u1EE7a t\u1EA5t c\u1EA3 k\u1EF9 n\u0103ng th\xF4ng th\u01B0\u1EDDng,
      ngo\u1EA1i tr\u1EEB chi\xEAu cu\u1ED1i v\xE0 c\xE1c k\u1EF9 n\u0103ng ng\u1EABu
      nhi\xEAn, cho t\u1EA5t c\u1EA3 k\u1EBB \u0111\u1ECBch trong ph\u1EA1m vi {b:OneCardRadius:all}m."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340453
    m_Localized: "Th\u1EBB thay th\u1EBF"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340454
    m_Localized: "Thay \u0111\u1ED5i th\u1EDDi gian h\u1ED3i chi\xEAu c\u1EE7a m\u1ED9t
      trong nh\u1EEFng k\u1EF9 n\u0103ng ng\u1EABu nhi\xEAn hi\u1EC7n \u0111ang trong
      th\u1EDDi gian h\u1ED3i chi\xEAu th\xE0nh th\u1EDDi gian h\u1ED3i chi\xEAu
      c\u1EE7a k\u1EF9 n\u0103ng th\u1EBB thay th\u1EBF, v\xE0 \u0111\u1EB7t l\u1EA1i
      th\u1EDDi gian h\u1ED3i chi\xEAu c\u1EE7a k\u1EF9 n\u0103ng ng\u1EABu nhi\xEAn
      \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340455
    m_Localized: "m\xF3n qu\xE0 b\u1EA5t ng\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340459
    m_Localized: "B\u1EA1n r\u1EA5t nhanh! Nh\u01B0ng \u0111\u1EEBng bao gi\u1EDD
      d\u1EEBng l\u1EA1i!"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340460
    m_Localized: "Ph\u1EA9m ch\u1EA5t c\u1EE7a ng\u01B0\u1EDDi ch\u1EA1y b\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340462
    m_Localized: cua xanh
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340463
    m_Localized: "T\u1ED1c \u0111\u1ED9 di chuy\u1EC3n v\xE0 m\xE1u \u0111\u01B0\u1EE3c
      t\u0103ng l\xEAn, s\xE1t th\u01B0\u01A1ng c\u1EE7a v\u0169 kh\xED c\u1EADn
      chi\u1EBFn c\u0169ng t\u0103ng \u0111\xE1ng k\u1EC3, nh\u01B0ng b\u1EA1n ch\u1EC9
      c\xF3 th\u1EC3 di chuy\u1EC3n sang ngang."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340464
    m_Localized: "S\u1EE9c m\u1EA1nh c\u1EE7a cua xanh"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340465
    m_Localized: "M\xE1u v\xE0 t\u1ED1c \u0111\u1ED9 di chuy\u1EC3n t\u0103ng 60%,
      s\xE1t th\u01B0\u01A1ng v\u0169 kh\xED c\u1EADn chi\u1EBFn t\u0103ng 100%."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340466
    m_Localized: "ch\u1EE9ng s\u1EE3 x\xE3 h\u1ED9i"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340467
    m_Localized: "N\u1EBFu t\xF4i \u1EDF g\u1EA7n ai \u0111\xF3 trong v\xF2ng 5 m\xE9t
      qu\xE1 3 gi\xE2y, t\xF4i s\u1EBD x\u1EA5u h\u1ED5 \u0111\u1EBFn m\u1EE9c ph\xE1t
      \u0111i\xEAn!"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340468
    m_Localized: "D\xF9 t\xF4i c\xF3 ph\u1EA3i \u0111i \u0111i ch\u0103ng n\u1EEFa..."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534656
    m_Localized: "Khi ch\u1EBFt, m\u1ED7i l\u1EA7n ti\xEAu di\u1EC7t m\u1ED9t ng\u01B0\u1EDDi
      ch\u01A1i ng\u1EABu nhi\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534657
    m_Localized: "s\u1ED1 nhi\u1EC1u"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534658
    m_Localized: "Khi ch\u1EBFt, b\u1EA1n s\u1EBD b\u01B0\u1EDBc v\xE0o \"Th\u1EDDi
      kh\u1EAFc b\xE1o th\xF9\" trong 1 ph\xFAt.\n\nH\xE3y \u0111\xE1nh b\u1EA1i
      k\u1EBB \u0111\xE3 gi\u1EBFt b\u1EA1n trong \"Th\u1EDDi kh\u1EAFc b\xE1o th\xF9\"
      \u0111\u1EC3 nh\u1EADn \u0111\u01B0\u1EE3c hi\u1EC7u \u1EE9ng c\u1EF1c m\u1EA1nh!"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534659
    m_Localized: "c\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534662
    m_Localized: "Khi ch\u1EBFt, b\u1EA1n h\u1ED3i sinh ngay l\u1EADp t\u1EE9c v\xE0
      gi\u1EA3m l\u01B0\u1EE3ng Linh h\u1ED3n c\u1EE7a k\u1EBB \u0111\u1ECBch \u0111\xE3
      gi\u1EBFt b\u1EA1n.\n\nNgo\xE0i ra, t\u0103ng th\u1EDDi gian h\u1ED3i chi\xEAu
      k\u1EF9 n\u0103ng c\u1EE7a t\u1EA5t c\u1EA3 k\u1EBB \u0111\u1ECBch l\xEAn 8
      gi\xE2y!"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534663
    m_Localized: "S\u1ED5 tay T\u1EED th\u1EA7n"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534665
    m_Localized: "Ghi ch\xE9p"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534666
    m_Localized: "Ta s\u1EBD tr\u1EDF th\xE0nh Ch\xFAa t\u1EC3 c\u1EE7a T\xE2n Th\u1EBF
      gi\u1EDBi!!"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534667
    m_Localized: "B\xFAp b\xEA Voodoo"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534668
    m_Localized: "Ch\u1ECDn m\u1ED9t ng\u01B0\u1EDDi ch\u01A1i v\xE0 \xE1p \u0111\u1EB7t
      tr\u1EA1ng th\xE1i 'L\u1EDDi nguy\u1EC1n' l\xEAn h\u1ECD trong 20 gi\xE2y,
      ng\u0103n c\u1EA3n h\u1ECD giao ti\u1EBFp. Ngo\xE0i ra, h\u1ECD c\xF2n nh\u1EADn
      hi\u1EC7u \u1EE9ng 'Phong \u1EA5n' trong t\u1ED1i \u0111a 999 gi\xE2y khi c\xF2n
      s\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534669
    m_Localized: "B\xFAp b\xEA Voodoo"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534670
    m_Localized: "T\xF4i \u0111\xE3 gh\xE9t anh t\u1EEB l\xE2u r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534671
    m_Localized: "Di\u1EC5n xu\u1EA5t d\u1EC5 th\u01B0\u01A1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534672
    m_Localized: "S\u1EED d\u1EE5ng v\u1EBB ngo\xE0i d\u1EC5 th\u01B0\u01A1ng ch\u1EBFt
      ng\u01B0\u1EDDi \u0111\u1EC3 gi\u1EA3m 50% s\xE1t th\u01B0\u01A1ng g\xE2y ra
      b\u1EDFi m\u1EE5c ti\xEAu trong 8 gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534673
    m_Localized: "Di\u1EC5n xu\u1EA5t d\u1EC5 th\u01B0\u01A1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534674
    m_Localized: Ppuing ppuing
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534675
    m_Localized: "C\u01A1n b\xE3o th\u1EDDi gian"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534676
    m_Localized: "Khi s\u1EED d\u1EE5ng, n\xF3 s\u1EBD d\u1ECBch chuy\u1EC3n m\u1ED9t
      k\u1EBB \u0111\u1ECBch trong ph\u1EA1m vi \u0111\u1EBFn m\u1ED9t v\u1ECB tr\xED
      ng\u1EABu nhi\xEAn!"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534677
    m_Localized: "Ch\xFAng ta c\u1EA7n th\xEAm nhi\u1EC1u anh h\xF9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534678
    m_Localized: "\u0110\u01B0a m\u1ED9t m\u1EE5c ti\xEAu v\xE0o c\u01A1n b\xE3o
      th\u1EDDi gian v\xE0 kh\xF4ng gian."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534679
    m_Localized: "Ng\u01B0\u1EDDi kh\u1ED5ng l\u1ED3 c\u1EE7a c\u1EDD vua"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534680
    m_Localized: "Nh\u1EADn 1 qu\xE2n T\u1ED1t khi \u0111\xE1nh b\u1EA1i m\u1ED9t
      ng\u01B0\u1EDDi ch\u01A1i.\n\nThu th\u1EADp 6 qu\xE2n T\u1ED1t tr\u1EDF l\xEAn
      \u0111\u1EC3 tr\u1EDF th\xE0nh \"Ng\u01B0\u1EDDi kh\u1ED5ng l\u1ED3 c\u1EDD
      vua\".\n\n(S\u1ED1 qu\xE2n T\u1ED1t hi\u1EC7n t\u1EA1i {x:pawns} / {x:pawnsneed})"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534681
    m_Localized: "Khuy\u1EBFn m\xE3i"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534683
    m_Localized: "Ph\u01B0\u01A1ng ph\xE1p di chuy\u1EC3n c\u1EE7a qu\xE2n M\xE3"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534684
    m_Localized: "Nh\u1EA3y v\u1EC1 ph\xEDa tr\u01B0\u1EDBc hai l\u1EA7n b\u1EB1ng
      \u0111\u1ED9ng t\xE1c c\u1EE7a Hi\u1EC7p s\u0129, v\xE0 n\u1EBFu s\u1EED d\u1EE5ng
      l\u1EA1i trong v\xF2ng 3 gi\xE2y, h\xE3y nh\u1EA3y ch\xE9o sang tr\xE1i/ph\u1EA3i."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534685
    m_Localized: "s\u1EF1 t\u1ED3n t\u1EA1i t\u1EA5t y\u1EBFu"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534686
    m_Localized: "Th\u1EDDi gian h\u1ED3i chi\xEAu chi\xEAu cu\u1ED1i gi\u1EA3m nhanh
      h\u01A1n 40%.\n\nS\u1EED d\u1EE5ng chi\xEAu cu\u1ED1i 5 l\u1EA7n s\u1EBD ti\xEAu
      di\u1EC7t m\u1ED9t n\u1EEDa s\u1ED1 ng\u01B0\u1EDDi ch\u01A1i c\xF2n s\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534687
    m_Localized: "Th\u1EDDi gian h\u1ED3i chi\xEAu chi\xEAu cu\u1ED1i gi\u1EA3m nhanh
      h\u01A1n 40%.\n\nS\u1EED d\u1EE5ng chi\xEAu cu\u1ED1i 5 l\u1EA7n s\u1EBD ti\xEAu
      di\u1EC7t m\u1ED9t n\u1EEDa s\u1ED1 ng\u01B0\u1EDDi ch\u01A1i c\xF2n s\u1ED1ng.
      (Hi\u1EC7n t\u1EA1i: {x:stack})"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534688
    m_Localized: "B\xFAng ng\xF3n tay"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534690
    m_Localized: "Di ch\xFAc c\u1EE7a Beomgol"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534691
    m_Localized: "Khi m\xE1u c\u1EE7a b\u1EA1n gi\u1EA3m xu\u1ED1ng c\xF2n 1 ho\u1EB7c
      th\u1EA5p h\u01A1n, b\u1EA1n s\u1EBD nh\u1EADn \u0111\u01B0\u1EE3c m\u1ED9t
      l\u01B0\u1EE3ng ch\u1EC9 s\u1ED1 kh\u1ED5ng l\u1ED3 trong m\u1ED9t th\u1EDDi
      gian ng\u1EAFn v\xE0 kh\xF4ng ch\u1EBFt."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534692
    m_Localized: "Khi m\xE1u c\u1EE7a b\u1EA1n gi\u1EA3m xu\u1ED1ng c\xF2n 1 ho\u1EB7c
      th\u1EA5p h\u01A1n, b\u1EA1n s\u1EBD nh\u1EADn \u0111\u01B0\u1EE3c m\u1ED9t
      l\u01B0\u1EE3ng ch\u1EC9 s\u1ED1 kh\u1ED5ng l\u1ED3 trong m\u1ED9t th\u1EDDi
      gian ng\u1EAFn v\xE0 kh\xF4ng ch\u1EBFt."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534693
    m_Localized: "s\xE1t th\u1EE7"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534695
    m_Localized: "\xE1o cho\xE0ng t\xE0ng h\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534696
    m_Localized: "B\u1EA1n c\xF3 th\u1EC3 quy\u1EBFt \u0111\u1ECBnh s\u1EED d\u1EE5ng
      \xC1o Cho\xE0ng T\xE0ng H\xECnh b\u1EB1ng c\xE1ch s\u1EED d\u1EE5ng m\u1ED9t
      k\u1EF9 n\u0103ng.\n\nKhi s\u1EED d\u1EE5ng \xC1o Cho\xE0ng T\xE0ng H\xECnh,
      b\u1EA1n tr\u1EDF n\xEAn 'v\xF4 h\xECnh', v\xEC v\u1EADy c\u01A1 th\u1EC3 b\u1EA1n
      (ngo\u1EA1i tr\u1EEB v\u0169 kh\xED) s\u1EBD v\xF4 h\xECnh, nh\u01B0ng s\xE1t
      th\u01B0\u01A1ng g\xE2y ra s\u1EBD gi\u1EA3m 50%."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534697
    m_Localized: "Kho\xE1c \xE1o cho\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534698
    m_Localized: "T\xF4i hy v\u1ECDng kh\xF4ng ai t\xECm th\u1EA5y t\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534699
    m_Localized: "v\u1EBD tranh"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534700
    m_Localized: "Ch\u1ECDn m\u1ED9t m\u1EE5c ti\xEAu trong ph\u1EA1m vi, v\xE0 c\xF3
      50% kh\u1EA3 n\u0103ng l\u01B0\u1EE3ng Linh h\u1ED3n c\u1EE7a b\u1EA1n s\u1EBD
      b\u1EB1ng v\u1EDBi l\u01B0\u1EE3ng Linh h\u1ED3n c\u1EE7a m\u1EE5c ti\xEAu
      \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534702
    m_Localized: "H\xE3y \u0111\u1EB7t c\u01B0\u1EE3c v\u1EDBi m\u1EE5c ti\xEAu m\xE0
      b\u1EA1n \u0111ang nh\u1EAFm t\u1EDBi, v\xE0 c\xF3 50% kh\u1EA3 n\u0103ng linh
      h\u1ED3n c\u1EE7a b\u1EA1n s\u1EBD gi\u1ED1ng h\u1EC7t v\u1EDBi linh h\u1ED3n
      c\u1EE7a m\u1EE5c ti\xEAu \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534703
    m_Localized: "n\xE9m \u0111\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534705
    m_Localized: "n\xE9m \u0111\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534706
    m_Localized: "Ch\u1ECDn m\u1ED9t \u0111i\u1EC3m ph\xEDa tr\u01B0\u1EDBc, bay
      l\xEAn cao v\xE0 n\xE9m m\u1ED9t qu\u1EA3 b\xF3ng Tr\xE1i \u0110\u1EA5t v\xE0o
      v\u1ECB tr\xED \u0111\xF3.\n\nQuay tr\u1EDF l\u1EA1i v\u1ECB tr\xED n\xE9m
      sau khi s\u1EED d\u1EE5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534707
    m_Localized: "Tia r\u1EE5ng t\xF3c"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534708
    m_Localized: "Khi s\u1EED d\u1EE5ng, n\xF3 s\u1EBD b\u1EAFn m\u1ED9t ch\xF9m
      tia v\u1EC1 ph\xEDa tr\u01B0\u1EDBc \u0111\u1EC3 bi\u1EBFn m\u1EE5c ti\xEAu
      th\xE0nh \"\u0111\u1ED3ng \u0111\u1ED9i\"."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534709
    m_Localized: "Tia r\u1EE5ng t\xF3c"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534710
    m_Localized: "Bi\u1EBFn m\u1EE5c ti\xEAu th\xE0nh m\u1ED9t '\u0111\u1ED3ng ch\xED'."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534711
    m_Localized: "C\xE1c \"\u0111\u1ED3ng minh\" kh\xF4ng th\u1EC3 l\xE0m h\u1EA1i
      l\u1EABn nhau, v\xE0 m\u1ED9t s\u1EF1 ki\u1EC7n \u0111\u1EB7c bi\u1EC7t s\u1EBD
      x\u1EA3y ra khi t\u1EA5t c\u1EA3 ng\u01B0\u1EDDi ch\u01A1i tr\u1EDF th\xE0nh
      \"\u0111\u1ED3ng minh\"."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534712
    m_Localized: "H\xE3y c\xF9ng h\u01B0\u1EDBng t\u1EDBi t\u01B0\u01A1ng lai!"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534713
    m_Localized: "Khi s\u1EED d\u1EE5ng, n\xF3 s\u1EBD t\xF3m l\u1EA5y m\u1ED9t m\u1EE5c
      ti\xEAu v\xE0 lao t\u1EDBi.\n\nKh\xF4ng ai bi\u1EBFt \u0111i\u1EC3m \u0111\u1EBFn
      l\xE0 \u1EDF \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534715
    m_Localized: "Khi \u0111\u01B0\u1EE3c s\u1EED d\u1EE5ng, n\xF3 nh\u1EAFm \u0111\u1EBFn
      m\u1ED9t m\u1EE5c ti\xEAu duy nh\u1EA5t v\xE0 h\u01B0\u1EDBng t\u1EDBi t\u01B0\u01A1ng
      lai."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534717
    m_Localized: "Khi s\u1EED d\u1EE5ng k\u1EF9 n\u0103ng, b\u1EA1n s\u1EBD h\xE9t
      l\xEAn Ng\xF4n ng\u1EEF R\u1ED3ng Huy\u1EC1n Tho\u1EA1i.\n\nN\u1EBFu b\u1EA1n
      h\xE9t l\xEAn 30 l\u1EA7n, b\u1EA1n s\u1EBD bi\u1EBFn th\xE0nh m\u1ED9t con
      r\u1ED3ng huy\u1EC1n tho\u1EA1i.\n\nN\u1EBFu b\u1EA1n s\u1ED1ng s\xF3t \u0111\u01B0\u1EE3c
      3 ph\xFAt, b\u1EA1n s\u1EBD th\u1EAFng ngay l\u1EADp t\u1EE9c."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534720
    m_Localized: "l\u01B0\u1EDBt"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534721
    m_Localized: Fus Ro Da
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534722
    m_Localized: "H\u01A1i th\u1EDF c\u1EE7a k\u1EBFt th\xFAc"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340356
    m_Localized: "Gi\u1EDBi h\u1EA1n c\u01B0\u1EDDng h\xF3a t\u0103ng l\xEAn 100.\n\nB\u1EA1n
      c\xF3 th\u1EC3 ch\u1EC9 \u0111\u1ECBnh gi\xE1 tr\u1ECB c\u1EE7a l\u1EA7n c\u01B0\u1EDDng
      h\xF3a ti\u1EBFp theo b\u1EB1ng c\xE1ch ti\xEAu hao Linh h\u1ED3n."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340359
    m_Localized: "Nghi\u1EC1n n\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340366
    m_Localized: "Khi \u1EDF tr\u1EA1ng th\xE1i 'H\u1EADu du\u1EC7 c\u1EE7a L\u1EEDa',
      s\u1ED1 l\u01B0\u1EE3ng \u0110\xE1 Ph\xE9p c\u1EA7n thi\u1EBFt \u0111\u1EC3
      c\u01B0\u1EDDng h\xF3a s\u1EBD gi\u1EA3m \u0111i m\u1ED9t n\u1EEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340376
    m_Localized: "Ph\xF3ng to h\xECnh \u1EA3nh trong {b:AimTimeout} gi\xE2y v\xE0
      gi\u1EA3m t\u1ED1c \u0111\u1ED9 di chuy\u1EC3n.\n\nThay v\xE0o \u0111\xF3,
      vi\xEAn \u0111\u1EA1n ti\u1EBFp theo g\xE2y th\xEAm {b:AimBonusPct:all}% s\xE1t
      th\u01B0\u01A1ng khi tr\xFAng \u0111\xEDch v\xE0 lu\xF4n g\xE2y s\xE1t th\u01B0\u01A1ng
      ch\xED m\u1EA1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340377
    m_Localized: "V\xE0o ph\xF2ng t\u1EAFm"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340384
    m_Localized: "Thi th\u1EC3 c\u1EE7a ng\u01B0\u1EDDi \u0111\xE3 khu\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340394
    m_Localized: '{x:ult}'
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340396
    m_Localized: "B\u1EA1n \u0111ang \u0111\xF3i.\n\nV\xE0 b\u1EA1n c\xF3 m\u1ED9t
      c\xE1i d\u1EA1 d\xE0y c\xF3 th\u1EC3 nu\u1ED1t ch\u1EEDng b\u1EA5t c\u1EE9
      th\u1EE9 g\xEC.\n\nB\u1EA1n c\xF3 th\u1EC3 nu\u1ED1t ch\u1EEDng b\u1EA5t c\u1EE9
      th\u1EE9 g\xEC v\xE0 tr\u1EDF th\xE0nh m\u1ED9t sinh v\u1EADt kh\u1ED5ng l\u1ED3."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340402
    m_Localized: "C\u1EAFn v\u1EC1 ph\xEDa tr\u01B0\u1EDBc \u0111\u1EC3 g\xE2y s\xE1t
      th\u01B0\u01A1ng {dmg:DevourCoef+DevourFlat}. N\u1EBFu m\u1EE5c ti\xEAu b\u1ECB
      tr\xFAng \u0111\xF2n ch\u1EBFt trong v\xF2ng 1 gi\xE2y, nh\u1EADn th\xEAm m\u1ED9t
      linh h\u1ED3n v\xE0 chu\u1EA9n b\u1ECB <b>Spit Out</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340409
    m_Localized: "qu\xE1i v\u1EADt \u0111\xF3i kh\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340410
    m_Localized: "Gi\u1EA3i ph\xF3ng {b:MonsterCount:all} qu\xE1i th\xFA \u0111\xF3i
      kh\xE1t \u0111\u1EC3 ch\xFAng t\u1EF1 \u0111\u1ED9ng c\u1EAFn k\u1EBB th\xF9
      trong b\xE1n k\xEDnh {b:MonsterRadius:all}m trong {b:UltDuration:all} gi\xE2y,
      g\xE2y s\xE1t th\u01B0\u01A1ng Tham lam v\u1EDBi hi\u1EC7u \u1EE9ng {b:MonsterPowerMul*100}%.\n\nN\u1EBFu
      b\u1EA1n ti\xEAu di\u1EC7t \u0111\u01B0\u1EE3c ng\u01B0\u1EDDi ch\u01A1i b\u1EB1ng
      \u0111\xF2n t\u1EA5n c\xF4ng Tham lam, th\u1EDDi gian hi\u1EC7u l\u1EF1c s\u1EBD
      t\u0103ng th\xEAm {b:UltKillExtend} gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340411
    m_Localized: "Qu\xE1i v\u1EADt c\xF3 th\u1EDDi gian h\u1ED3i chi\xEAu t\u1EA5n
      c\xF4ng 3 gi\xE2y cho m\u1ED7i m\u1EE5c ti\xEAu v\xE0 g\xE2y th\xEAm {b:MonsterLowHpBonus:all}%
      s\xE1t th\u01B0\u01A1ng cho c\xE1c m\u1EE5c ti\xEAu c\xF3 l\u01B0\u1EE3ng m\xE1u
      t\u1EEB 30% tr\u1EDF xu\u1ED1ng.\n\nTrong th\u1EDDi gian hi\u1EC7u l\u1EF1c,
      S\u1EE9c t\u1EA5n c\xF4ng, T\u1ED1c \u0111\u1ED9 t\u1EA5n c\xF4ng v\xE0 T\u1ED1c
      \u0111\u1ED9 di chuy\u1EC3n \u0111\u01B0\u1EE3c t\u0103ng nh\u1EB9."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340412
    m_Localized: "Ng\u01B0\u1EDDi \u0111i b\u1ED9 trong b\xF3ng t\u1ED1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340415
    m_Localized: "M\u1ED9t c\xE1i b\xF3ng lu\xF4n b\xE1m theo K\u1EBB \u0110i Trong
      B\xF3ng T\u1ED1i.\n\nKhi kh\xF4ng trong tr\u1EA1ng th\xE1i chi\u1EBFn \u0111\u1EA5u,
      h\xE3y t\xEDch t\u1EE5 <b>B\xF3ng T\u1ED1i</b> trong {b:DarkChargeTime:all}
      gi\xE2y.\n\nKhi t\u1EA5n c\xF4ng k\u1EBB \u0111\u1ECBch, n\u1EBFu <b>B\xF3ng
      T\u1ED1i</b> \u0111\xE3 \u0111\u01B0\u1EE3c t\xEDch t\u1EE5, h\xE3y l\xE0m
      m\xF9 m\u1EE5c ti\xEAu trong {b:BlindTime:all} gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340423
    m_Localized: "M\u1ED9t k\u1EBB \u0111\u1ECBch b\u1ECB tr\xF3i b\u1EB1ng m\u1ED9t
      <b>b\xE0n tay b\xF3ng t\u1ED1i</b> trong v\xF2ng {b:HandImmune:all} gi\xE2y
      s\u1EBD kh\xF4ng th\u1EC3 b\u1ECB tr\xF3i b\u1EB1ng m\u1ED9t <b>b\xE0n tay
      b\xF3ng t\u1ED1i</b> kh\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340429
    m_Localized: "Kho ch\u1EE9a Mugu"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340434
    m_Localized: "nh\xE0 s\u01B0u t\u1EADp"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340447
    m_Localized: "L\u01B0\u1EE3ng linh h\u1ED3n nh\u1EADn \u0111\u01B0\u1EE3c t\u0103ng
      l\xEAn {b:SoulGain:all} l\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340450
    m_Localized: "B\u1EA1n c\xF3 th\u1EC3 c\xF3 t\u1ED1i \u0111a {b:CardMax:all}
      th\u1EBB c\xF9ng m\u1ED9t l\xFAc."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340451
    m_Localized: "M\u1ED9t t\u1EA5m th\u1EBB!"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340456
    m_Localized: "Tri\u1EC7u h\u1ED3i m\u1ED9t b\u1EA3n sao gi\u1ED1ng h\u1EC7t b\u1EA1n
      v\u1EDBi c\xE1c k\u1EF9 n\u0103ng v\xE0 v\u1EADt ph\u1EA9m ng\u1EABu nhi\xEAn
      tr\u01B0\u1EDBc m\u1EB7t b\u1EA1n trong {b:CloneDuration:all} gi\xE2y.\n\nB\u1EA3n
      sao s\u1EBD t\u1EF1 \u0111\u1ED9ng \u0111i theo k\u1EBB \u0111\u1ECBch g\u1EA7n
      nh\u1EA5t.\n\nKhi b\u1EA3n sao ch\u1EBFt ho\u1EB7c b\u1EA1n nh\u1EA5n ph\xEDm
      Chi\xEAu cu\u1ED1i m\u1ED9t l\u1EA7n n\u1EEFa, n\xF3 s\u1EBD ph\xE1t n\u1ED5,
      g\xE2y s\xE1t th\u01B0\u01A1ng {b:CloneBlastMul*100:all}% s\xE1t th\u01B0\u01A1ng
      v\u1EE5 n\u1ED5 Joker Draw l\xEAn k\u1EBB \u0111\u1ECBch xung quanh.\n\nB\u1EA3n
      sao t\u1EA5n c\xF4ng k\u1EBB \u0111\u1ECBch trong ph\u1EA1m vi 10m b\u1EB1ng
      v\u0169 kh\xED hi\u1EC7n t\u1EA1i c\u1EE7a n\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340457
    m_Localized: "Nh\xE2n b\u1EA3n gi\u1EA3m s\xE1t th\u01B0\u01A1ng v\u0169 kh\xED
      \u0111i 50%."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340458
    m_Localized: "C\u1EA3m gi\xE1c h\u01B0ng ph\u1EA5n khi ch\u1EA1y b\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945322340461
    m_Localized: "Thay v\xEC t\u0103ng t\u1ED1c \u0111\xE1ng k\u1EC3, b\u1EA1n s\u1EBD
      b\u1ECB m\u1EA5t m\xE1u m\u1ED7i khi d\u1EEBng l\u1EA1i!"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534660
    m_Localized: "V\u1ED7 v\u1ED7 v\u1ED7."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534661
    m_Localized: "H\u1ED3i quy t\u1EED vong"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534664
    m_Localized: "Ch\u1ECDn m\u1ED9t ng\u01B0\u1EDDi ch\u01A1i m\xE0 b\u1EA1n mu\u1ED1n
      \"t\u1EF1 s\xE1t\" sau 60 gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534682
    m_Localized: "Qu\xE2n t\u1ED1t \u0111\u01B0\u1EE3c phong c\u1EA5p tr\u1EDF th\xE0nh
      m\u1ED9t <b>ng\u01B0\u1EDDi kh\u1ED5ng l\u1ED3</b> trong c\u1EDD vua."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534689
    m_Localized: "50% c\u1EE7a to\xE0n b\u1ED9 cu\u1ED9c s\u1ED1ng...."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534694
    m_Localized: "S\xE1t th\u01B0\u01A1ng g\xE2y ra khi m\u1EE5c ti\xEAu kh\xF4ng
      nh\xECn v\xE0o b\u1EA1n t\u0103ng 100%.\n\nTr\u1EDF n\xEAn v\xF4 h\xECnh trong
      3 gi\xE2y khi s\u1EED d\u1EE5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534701
    m_Localized: "Ch\xFAng ta coi nh\u01B0 h\xF2a nh\xE9...?"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534704
    m_Localized: "Khi s\u1EED d\u1EE5ng, b\u1EA1n s\u1EBD bay l\xEAn trong gi\xE2y
      l\xE1t, sau \u0111\xF3 n\xE9m \"\u0110\u1EA5t\" v\xE0o v\u1ECB tr\xED b\u1EA1n
      v\u1EEBa nh\xECn v\xE0o tr\u01B0\u1EDBc khi s\u1EED d\u1EE5ng k\u1EF9 n\u0103ng."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534714
    m_Localized: "H\xE3y c\xF9ng nhau h\u01B0\u1EDBng t\u1EDBi t\u01B0\u01A1ng lai!"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534716
    m_Localized: "Ng\xF4n ng\u1EEF R\u1ED3ng Huy\u1EC1n Tho\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534718
    m_Localized: "Ng\xF4n ng\u1EEF R\u1ED3ng Huy\u1EC1n Tho\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534719
    m_Localized: "T\xEAn anh \u1EA5y l\xE0..."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534723
    m_Localized: "S\u1EF1 b\u1EA5t t\xE0i \u0111a n\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534724
    m_Localized: "\xD4i kh\xF4ng! Kh\u1EA3 n\u0103ng n\xE0y kh\xF4ng c\xF3 t\xE1c
      d\u1EE5ng.\n\nH\xE3y th\u1EED ch\u1EC9 s\u1EED d\u1EE5ng kh\u1EA3 n\u0103ng
      c\u1EE7a ri\xEAng b\u1EA1n!"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534725
    m_Localized: "S\u1EF1 b\u1EA5t t\xE0i \u0111a n\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15311903037960192
    m_Localized: William
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903232
    m_Localized: "v\xF9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903233
    m_Localized: Thomas
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903234
    m_Localized: Henry
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903235
    m_Localized: Robert
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903236
    m_Localized: "S\xF3i"
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903237
    m_Localized: Hakon
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903238
    m_Localized: Eric
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903239
    m_Localized: Arthur
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903240
    m_Localized: "<b>Th\u1EA7n Ki\u1EBFm Tr\xF3i Bu\u1ED9c</b> \u2014 {b:ArthurTrueRatio:pct}%
      s\xE1t th\u01B0\u01A1ng b\u1ECF qua gi\xE1p."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903241
    m_Localized: "<b>T\u1EA5n c\xF4ng</b> \u2014 T\u1ED1c \u0111\u1ED9 t\u1EA5n c\xF4ng
      t\u0103ng l\xEAn, v\xE0 k\u1EBB \u0111\u1ECBch tr\xFAng \u0111\xF2n s\u1EBD
      b\u1ECB cho\xE1ng trong {b:ArthurStun} gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903242
    m_Localized: "<b>Seonghwi</b> \u2014 G\xE2y th\xEAm {dmg:ArthurBlastCoef} s\xE1t
      th\u01B0\u01A1ng trong ph\u1EA1m vi v\u1EE5 n\u1ED5."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903243
    m_Localized: Roland
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903244
    m_Localized: "<b>Durandal</b> \u2014 S\u1EE9c m\u1EA1nh t\u0103ng th\xEAm {b:RolandBonusPct}%
      v\xE0 g\xE2y th\xEAm s\xE1t th\u01B0\u01A1ng b\u1EB1ng {b:RolandMissingPct}%
      l\u01B0\u1EE3ng m\xE1u \u0111\xE3 m\u1EA5t c\u1EE7a m\u1EE5c ti\xEAu."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903245
    m_Localized: "<b>Nh\u1EA3y</b> \u2014 Nh\u1EA5n l\u1EA1i khi \u0111ang c\u01B0\u1EE1i
      th\xFA \u0111\u1EC3 nh\u1EA3y thay v\xEC lao t\u1EDBi, \u0111\u1EA9y l\xF9i
      k\u1EBB th\xF9 trong ph\u1EA1m vi {b:RolandPushRadius}m v\xE0 h\u1ED3i ph\u1EE5c
      {b:RolandHealMissingPct}% l\u01B0\u1EE3ng m\xE1u \u0111\xE3 m\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903246
    m_Localized: "<b>Ph\xE1n x\xE9t</b> \u2014 S\xE1t th\u01B0\u01A1ng tr\u1EF1c
      di\u1EC7n t\u0103ng th\xEAm {b:RolandFinisherCoef}% S\u1EE9c m\u1EA1nh t\u1EA5n
      c\xF4ng, v\xE0 k\u1EBB \u0111\u1ECBch tr\xFAng \u0111\xF2n s\u1EBD b\u1ECB
      cho\xE1ng trong {b:RolandStun} gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903079903247
    m_Localized: Bernhard
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097536
    m_Localized: "<b>K\u1EBFt th\xFAc</b> \u2014 S\u1EE9c m\u1EA1nh t\u0103ng th\xEAm
      {b:BernhardBonusPct}%, v\xE0 m\u1EE5c ti\xEAu tr\xFAng \u0111\xF2n s\u1EBD
      b\u1ECB th\u01B0\u01A1ng n\u1EB7ng {b:BernhardWoundPct}% trong {b:BernhardWoundTime}
      gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097537
    m_Localized: "<b>T\xEDch \u0111i\u1EC7n Ma</b> \u2014 Nh\u1EA5n l\u1EA1i khi
      \u0111ang c\u01B0\u1EE1i th\xFA \u0111\u1EC3 t\xEDch \u0111i\u1EC7n \u1EDF
      d\u1EA1ng Ma, t\u0103ng s\u1EE9c m\u1EA1nh c\u1EE7a \u0111\xF2n t\xEDch \u0111i\u1EC7n
      l\xEAn {b:BernhardChargePct}%."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097538
    m_Localized: "<b>Ng\u1ECDn L\u1EEDa T\u1EED Th\u1EA7n</b> \u2014 G\xE2y b\u1ECFng
      n\u1EB7ng cho k\u1EBB \u0111\u1ECBch tr\xFAng ph\u1EA3i v\u1EE5 n\u1ED5, g\xE2y
      s\xE1t th\u01B0\u01A1ng b\u1EB1ng {b:DeathFlameTime}% m\xE1u t\u1ED1i \u0111a
      c\u1EE7a ch\xFAng m\u1ED7i gi\xE2y trong {b:DeathFlamePct} gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097539
    m_Localized: "n\xF4ng d\xE2n"
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097540
    m_Localized: "<b>C\xE2y tr\u1ED3ng</b> \u2014 H\u1ED3i ph\u1EE5c {b:FarmHealPct}%
      s\xE1t th\u01B0\u01A1ng g\xE2y ra"
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097541
    m_Localized: "<b>K\u1EF5 s\u0129 kh\xF4ng chuy\xEAn</b> \u2014 T\u1ED1c \u0111\u1ED9
      di chuy\u1EC3n t\u0103ng l\xEAn -{b:UnkilledPenalty}"
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097542
    m_Localized: "l\xEDnh \u0111\xE1nh thu\xEA"
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097543
    m_Localized: "<b>Farm</b> \u2014 H\u1ED3i ph\u1EE5c {b:FarmHealPct}% s\xE1t th\u01B0\u01A1ng
      g\xE2y ra\n<b>Combat Sense</b> \u2014 Ngay sau \u0111\xF3, ch\xE9m th\xEAm
      m\u1ED9t nh\xE1t v\u1EDBi s\u1EE9c m\u1EA1nh {b:SecondMul:pct}%"
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097544
    m_Localized: "<b>K\u1EF5 s\u0129 kh\xF4ng chuy\xEAn</b> \u2014 T\u1ED1c \u0111\u1ED9
      di chuy\u1EC3n t\u0103ng l\xEAn -{b:UnkilledPenalty}"
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097545
    m_Localized: "\u0110\u01B0\u1EE3c \u0111\u1EB7t t\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097546
    m_Localized: "<b>Farm</b> \u2014 H\u1ED3i ph\u1EE5c {b:FarmHealPct}% s\xE1t th\u01B0\u01A1ng
      g\xE2y ra\n<b>Combat Sense</b> \u2014 Ngay sau \u0111\xF3, ch\xE9m th\xEAm
      m\u1ED9t nh\xE1t v\u1EDBi s\u1EE9c m\u1EA1nh {b:SecondMul:pct}%"
    m_Metadata:
      m_Items: []
  - m_Id: 15324686622240768
    m_Localized: "B\xE0n th\u1EDD \u0111\xE3 \u0111\u01B0\u1EE3c k\xEDch ho\u1EA1t"
    m_Metadata:
      m_Items: []
  - m_Id: 15328367992221696
    m_Localized: "Danh s\xE1ch ph\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581824
    m_Localized: "K\u1EBFt n\u1ED1i l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581825
    m_Localized: "bi\u1EC7t danh"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581826
    m_Localized: "T\xEAn ph\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581827
    m_Localized: "nh\xE2n vi\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581828
    m_Localized: "Kho\u0301a"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581829
    m_Localized: "B\u1EA3n \u0111\u1ED3"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581830
    m_Localized: "t\xECnh hu\u1ED1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581831
    m_Localized: "Hi\u1EC7n t\u1EA1i kh\xF4ng c\xF2n ph\xF2ng tr\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581832
    m_Localized: "N\u1EBFu \u0111\u1EC3 tr\u1ED1ng, n\xF3 s\u1EBD tr\u1EDF th\xE0nh
      \"ph\xF2ng \u0111\u1EB7t bi\u1EC7t danh\"."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581833
    m_Localized: "\u1EA8n (ch\u1EC9 m\xE3)"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581834
    m_Localized: "Trang tr\xED ph\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581835
    m_Localized: "M\xE3 ph\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581836
    m_Localized: "Tham gia b\u1EB1ng m\xE3"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581837
    m_Localized: "b\u1EA3n sao"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581838
    m_Localized: "R\u1EDDi kh\u1ECFi ph\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581839
    m_Localized: "tr\xF2 ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581840
    m_Localized: "S\u1ED1 l\u01B0\u1EE3ng ng\u01B0\u1EDDi t\u1ED1i \u0111a"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581841
    m_Localized: "Th\u1EDDi gian l\xE0m vi\u1EC7c"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581842
    m_Localized: "Kh\u1EDFi \u0111\u1EA7u t\xE2m h\u1ED3n"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581843
    m_Localized: "H\u1ED9p n\u1EA1p l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581844
    m_Localized: "R\u01A1i xu\u1ED1ng ch\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581845
    m_Localized: "ch\u1EBFt ngay l\u1EADp t\u1EE9c"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581846
    m_Localized: "\u0110\u1EBFn \u0111i\u1EC3m ph\u1EE5c sinh"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581847
    m_Localized: "Tr\u1EADn \u0111\u1EA5u \u0111\u1ED3ng \u0111\u1ED9i (\u0110ang
      chu\u1EA9n b\u1ECB)"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581848
    m_Localized: "Ph\xF2ng \u1EA9n (ch\u1EC9 tham gia b\u1EB1ng m\xE3 s\u1ED1)"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581849
    m_Localized: "B\xE0n th\u1EDD \u2014 N b\xE0n th\u1EDD ph\u1EE5 \u2192 B\xE0n
      th\u1EDD trung t\xE2m"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581850
    m_Localized: "Chi ph\xED b\xE0n th\u1EDD ph\u1EE5"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581851
    m_Localized: "Chi ph\xED b\xE0n th\u1EDD trung t\xE2m"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581852
    m_Localized: "B\u1EA1n ph\u1EA3i k\xEDch ho\u1EA1t t\u1EA5t c\u1EA3 c\xE1c b\xE0n
      th\u1EDD ph\u1EE5 th\xEC b\xE0n th\u1EDD ch\xEDnh m\u1EDBi m\u1EDF \u0111\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581853
    m_Localized: "B\xE0n th\u1EDD ph\u1EE5 c\u1EA7n thi\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581854
    m_Localized: "Th\u1EDDi gian k\xEAnh trung t\xE2m"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581855
    m_Localized: "N\u1EBFu s\u1ED1 l\u01B0\u1EE3ng b\xE0n th\u1EDD ph\u1EE5 tr\xEAn
      b\u1EA3n \u0111\u1ED3 \xEDt h\u01A1n s\u1ED1 l\u01B0\u1EE3ng c\u1EA7n thi\u1EBFt,
      b\u1EA1n c\xF3 th\u1EC3 k\xEDch ho\u1EA1t t\u1EA5t c\u1EA3 ch\xFAng."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581856
    m_Localized: "xe t\u1EA3i"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581857
    m_Localized: "Gi\u1EA3i quy\u1EBFt m\u1ECDi th\u1EE9"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581858
    m_Localized: "C\xE0i \u0111\u1EB7t s\u1EB5n"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581859
    m_Localized: "Sao ch\xE9p c\xE0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581860
    m_Localized: "D\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581861
    m_Localized: "T\xEAn c\xE0i \u0111\u1EB7t s\u1EB5n"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581862
    m_Localized: "L\u01B0u v\xE0o t\u1EC7p"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581863
    m_Localized: "M\u1EDF th\u01B0 m\u1EE5c c\xE0i \u0111\u1EB7t s\u1EB5n"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581864
    m_Localized: "Nh\u1EADp kh\u1EA9u"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368021581865
    m_Localized: "b\u1ECB \u0111u\u1ED5i ra ngo\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776128
    m_Localized: "\u0110ang nh\u1EADn th\xF4ng tin ph\xF2ng..."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776129
    m_Localized: "\u0110ang k\u1EBFt n\u1ED1i \u0111\u1EBFn m\xE1y ch\u1EE7..."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776130
    m_Localized: "\u0110ang v\xE0o..."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776131
    m_Localized: "T\xF4i \u0111ang tr\xEAn \u0111\u01B0\u1EDDng ra ngo\xE0i..."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776132
    m_Localized: "Kh\xF4ng k\u1EBFt n\u1ED1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776133
    m_Localized: "Trong su\u1ED1t tr\u1EADn \u0111\u1EA5u"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776134
    m_Localized: "Ch\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776135
    m_Localized: "\u0110ang xem"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776136
    m_Localized: "S\u1EF1 tham gia"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776137
    m_Localized: "Hi\u1EC7n kh\xF4ng c\xF2n ph\xF2ng tr\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776138
    m_Localized: "M\xE3 ph\xF2ng {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776139
    m_Localized: "ph\xF2ng ri\xEAng"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776140
    m_Localized: "ph\xF2ng c\xF4ng c\u1ED9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776141
    m_Localized: "ng\u01B0\u1EDDi {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776142
    m_Localized: "Qu\u1EA3n l\xFD ph\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776143
    m_Localized: "s\u1EF1 chu\u1EA9n b\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776144
    m_Localized: "b\u1EA7u kh\xF4ng kh\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776145
    m_Localized: "T\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776146
    m_Localized: "B\u1EAFt \u0111\u1EA7u tr\xF2 ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776147
    m_Localized: "H\u1EE7y b\u1ECF qu\xE1 tr\xECnh chu\u1EA9n b\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776148
    m_Localized: "T\xF4i \u0111ang ch\u1EDD m\xE1y ch\u1EE7 kh\u1EDFi \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776149
    m_Localized: "C\xE0i \u0111\u1EB7t ph\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776150
    m_Localized: "C\xE0i \u0111\u1EB7t ph\xF2ng (ch\u1EC9 d\xE0nh cho ch\u1EE7 nh\xE0)"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776151
    m_Localized: "kh\xF4ng bi\xEAn gi\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776152
    m_Localized: "{0} ng\u01B0\u1EDDi"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776153
    m_Localized: "{0} ph\xFAt"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776154
    m_Localized: "{0} Linh h\u1ED3n"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776155
    m_Localized: "{0} m\u1EE5c"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776156
    m_Localized: "{0} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776157
    m_Localized: "C\u1EA5m theo l\u1EDBp"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776158
    m_Localized: "C\u1EA5m kh\u1EA3 n\u0103ng ng\u1EABu nhi\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776159
    m_Localized: "T\xF4i \u0111\xE3 sao ch\xE9p m\xE3 ph\xF2ng."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776160
    m_Localized: "T\xF4i \u0111\xE3 sao ch\xE9p c\xE0i \u0111\u1EB7t ph\xF2ng v\xE0o
      clipboard."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776161
    m_Localized: "T\xF4i \u0111\xE3 \xE1p d\u1EE5ng c\xE1c thi\u1EBFt l\u1EADp \u0111\xE3
      d\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776162
    m_Localized: "Kh\xF4ng c\xF3 thi\u1EBFt l\u1EADp ph\xF2ng n\xE0o tr\xEAn clipboard."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776163
    m_Localized: "[{0}] \u0111\xE3 l\u01B0u"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776164
    m_Localized: "[{0}] \u0111\xE3 t\u1EA3i"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776165
    m_Localized: "[{0}] Kh\xF4ng th\u1EC3 t\u1EA3i"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776166
    m_Localized: "Ph\xF2ng {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776167
    m_Localized: "B\u1EA3n \u0111\u1ED3 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776168
    m_Localized: "Kh\xF4ng th\u1EC3 k\u1EBFt n\u1ED1i \u0111\u1EBFn m\xE1y ch\u1EE7
      ({0})"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776169
    m_Localized: "K\u1EBFt n\u1ED1i \u0111\xE3 b\u1ECB m\u1EA5t. ({0})"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776170
    m_Localized: "Kh\xF4ng c\xF3 ch\u1ED7 cho \u0111o\u1EA1n m\xE3 \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776171
    m_Localized: "Ph\xF2ng \u0111\xE3 k\xEDn ch\u1ED7."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776172
    m_Localized: "\u0110\xE2y l\xE0 ph\xF2ng m\xE0 b\u1EA1n kh\xF4ng th\u1EC3 tham
      gia."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776173
    m_Localized: "Kh\xF4ng th\u1EC3 tham gia ({0})"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776174
    m_Localized: "Ch\u1EE7 ph\xF2ng \u0111\xE3 \u0111u\u1ED5i b\u1EA1n ra ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776175
    m_Localized: "Ch\u1EC9 m\xE1y ch\u1EE7 m\u1EDBi c\xF3 th\u1EC3 kh\u1EDFi \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776176
    m_Localized: "chu\u1EA9n b\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776177
    m_Localized: "C\u1EA3nh b\u1EA3n \u0111\u1ED3 kh\xF4ng c\xF3 trong c\xE0i \u0111\u1EB7t
      x\xE2y d\u1EF1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776178
    m_Localized: "Hi\u1EC7n c\xF3 {0} ng\u01B0\u1EDDi ch\u01B0a chu\u1EA9n b\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776179
    m_Localized: mike
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776180
    m_Localized: "Microphone d\xE0nh cho kh\xE1n gi\u1EA3"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776181
    m_Localized: "Nh\u1EA5n v\xE0 n\xF3i ({0})"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776182
    m_Localized: "M\u1EDF mic"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776183
    m_Localized: "T\u1EAFt ti\u1EBFng"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776184
    m_Localized: "\u0110\u1ED9i c\xE2m"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776185
    m_Localized: "N\xF3i"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776186
    m_Localized: "tr\xF2 ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776187
    m_Localized: "\u0111\u1ED9i"
    m_Metadata:
      m_Items: []
  - m_Id: 15328368025776188
    m_Localized: "\u0110ang xem"
    m_Metadata:
      m_Items: []
  - m_Id: 15336411908124672
    m_Localized: "Hi\u1EC3n th\u1ECB m\xE3"
    m_Metadata:
      m_Items: []
  - m_Id: 15336411941679104
    m_Localized: "\u1EA8n m\xE3"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805591465984
    m_Localized: "T\xEDch \u0111i\u1EC7n L\xE1 ch\u1EAFn Linh h\u1ED3n (Gi\u1EEF)"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020416
    m_Localized: "ch\u1EE3 \u0111en"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020417
    m_Localized: '[{0}] {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020418
    m_Localized: "T\xF4i \u0111\xE3 mua {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020419
    m_Localized: "\u0111\xF3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020420
    m_Localized: "Hi\u1EC7n ch\u01B0a c\xF3 m\u1EE5c n\xE0o \u0111\u01B0\u1EE3c ch\u1ECDn."
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020421
    m_Localized: "B\u1EA1n kh\xF4ng th\u1EC3 giao d\u1ECBch trong khi \u0111ang chi\u1EBFn
      \u0111\u1EA5u."
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020422
    m_Localized: "B\u1EA1n kh\xF4ng th\u1EC3 s\u1ED1ng khi \u0111\xE3 ch\u1EBFt."
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020423
    m_Localized: "T\xF4i kh\xF4ng th\u1EC3 mua n\xF3 ngay b\xE2y gi\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020424
    m_Localized: "Xa qu\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020425
    m_Localized: "B\u1EA1n kh\xF4ng th\u1EC3 thay \u0111\u1ED5i trang b\u1ECB trong
      khi \u0111ang bi\u1EBFn h\xECnh."
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020426
    m_Localized: "T\xF4i thi\u1EBFu \u0111i linh h\u1ED3n."
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020427
    m_Localized: "\xE1o gi\xE1p"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020428
    m_Localized: "v\u0169 kh\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020429
    m_Localized: "\u25C6 S\u1ED1 linh h\u1ED3n s\u1EDF h\u1EEFu {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020430
    m_Localized: "({0} gi\xE2y)"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020431
    m_Localized: "S\u1EE9c t\u1EA5n c\xF4ng {0}% s\xE1t th\u01B0\u01A1ng c\u1ED9ng
      th\xEAm"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020432
    m_Localized: "{0} Gi\u1EA3m th\u1EDDi gian h\u1ED3i chi\xEAu c\xF2n l\u1EA1i
      \u0111i {1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020433
    m_Localized: "{0} Gi\u1EA3m th\u1EDDi gian h\u1ED3i chi\xEAu c\xF2n l\u1EA1i
      \u0111i {1} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020434
    m_Localized: "Linh h\u1ED3n {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020435
    m_Localized: "Ph\xE9p thu\u1EADt l\xEAn \u0111\xE1 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020436
    m_Localized: "Ph\u1EE5c h\u1ED3i th\u1EC3 l\u1EF1c {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020437
    m_Localized: "H\u1ED3i ph\u1EE5c {0}% HP t\u1ED1i \u0111a"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020438
    m_Localized: "L\xE1 ch\u1EAFn h\u1ED3i ph\u1EE5c, s\u1EA1c t\u1EE9c th\xEC."
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020439
    m_Localized: "Kh\xF4i ph\u1EE5c {0} vi\xEAn \u0111\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020440
    m_Localized: "\u0110\u1ED1i v\u1EDBi ch\xEDnh b\u1EA1n {0} {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020441
    m_Localized: "{0} {1} t\u1EDBi m\u1EE5c ti\xEAu"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020442
    m_Localized: "L\xE1 ch\u1EAFn {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020443
    m_Localized: "Gi\xE1p b\u1EB1ng {0}% s\u1EE9c kh\u1ECFe t\u1ED1i \u0111a"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020444
    m_Localized: "T\u1EA5t c\u1EA3 c\xE1c k\u1EF9 n\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020445
    m_Localized: "Kh\u1EA3 n\u0103ng ng\u1EABu nhi\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020446
    m_Localized: "K\u1EF9 n\u0103ng th\xF4ng th\u01B0\u1EDDng"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020447
    m_Localized: "K\u1EF9 n\u0103ng \xB7 Tuy\u1EC7t \u0111\u1EC9nh"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020448
    m_Localized: "T\u1ED1i th\u01B0\u1EE3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805625020449
    m_Localized: "L\u1ED3ng t\u1ED1i \u0111a {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214720
    m_Localized: "X\xE1c su\u1EA5t {0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214721
    m_Localized: "T\xE1i s\u1EED d\u1EE5ng {0} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214722
    m_Localized: "{0} Khi nghe th\u1EA5y"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214723
    m_Localized: "C\xE0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214724
    m_Localized: "H\u1ED7 tr\u1EE3"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214725
    m_Localized: "Khi b\u1EAFn v\xE0o \u0111\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214726
    m_Localized: "N\u1EBFu b\u1EA1n b\u1ECB thi\u1EC7t h\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214727
    m_Localized: "Khi \u0111i\u1EC1u tr\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214728
    m_Localized: "N\u1EBFu s\u1EE9c kh\u1ECFe gi\u1EA3m xu\u1ED1ng d\u01B0\u1EDBi
      {0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214729
    m_Localized: "Khi s\u1EED d\u1EE5ng c\xE1c kh\u1EA3 n\u0103ng ng\u1EABu nhi\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214730
    m_Localized: "V\xE0o th\u1EDDi \u0111i\u1EC3m ph\u1EE5c sinh"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214731
    m_Localized: "N\u1EBFu t\u1EA5m ch\u1EAFn b\u1ECB v\u1EE1"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214732
    m_Localized: "Khi s\u1EED d\u1EE5ng m\u1ED9t k\u1EF9 n\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214733
    m_Localized: "Khi tham gia \u0111i\u1EC1u tr\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214734
    m_Localized: "Khi s\u1EED d\u1EE5ng chi\xEAu cu\u1ED1i"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214735
    m_Localized: "Khi t\u1EA5n c\xF4ng b\u1EB1ng v\u0169 kh\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214736
    m_Localized: "M\u1ED7i {0} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214737
    m_Localized: "Trong chi\u1EBFn \u0111\u1EA5u"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214738
    m_Localized: "Khi HP l\xE0 {0}% ho\u1EB7c th\u1EA5p h\u01A1n"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214739
    m_Localized: "Kh\xF4ng chi\u1EBFn \u0111\u1EA5u"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214740
    m_Localized: "Trong khi l\xE1 ch\u1EAFn \u0111ang ho\u1EA1t \u0111\u1ED9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214741
    m_Localized: "\u25C7 Kh\xF4ng c\xF3 b\xF9a ch\xFA \u0111\u1EB7c bi\u1EC7t"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214742
    m_Localized: "\u0110\u1EB7c \u0111i\u1EC3m n\u1ED9i t\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214743
    m_Localized: "[{0}] Nh\u1EADn \u2014 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214744
    m_Localized: "[{0}] M\u1EB7c \u2014 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214745
    m_Localized: "Khi\xEAn {0} (cho \u0111\u1EBFn khi b\u1ECB ph\xE1 v\u1EE1)"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214746
    m_Localized: "L\xE1 ch\u1EAFn {0} ({1} gi\xE2y)"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214747
    m_Localized: "\u0111\u1EE9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214748
    m_Localized: "x\u1EBFp h\u1EA1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214749
    m_Localized: "t\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214750
    m_Localized: "l\u1EDBp h\u1ECDc"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214751
    m_Localized: "b\xE0n th\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214752
    m_Localized: "Ch\u1ECDn m\u1ED9t lo\u1EA1i v\u0169 kh\xED \u0111\u1EC3 n\xE2ng
      c\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214753
    m_Localized: "S\xE1t th\u01B0\u01A1ng b\u1EAFn tr\xFAng \u0111\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214754
    m_Localized: "Gi\u1EA3m s\xE1t th\u01B0\u01A1ng nh\u1EADn v\xE0o khi b\u1ECB
      b\u1EAFn tr\xFAng \u0111\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214755
    m_Localized: "Khi\xEAn T\xE1i T\u1EA1o"
    m_Metadata:
      m_Items: []
  - m_Id: 16007805629214756
    m_Localized: "Khi\xEAn Linh H\u1ED3n"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278020640768
    m_Localized: "{0} gi\xE2y trong khi ti\xEAu h\xF3a"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389504
    m_Localized: "Qu\xE1 tr\xECnh ti\xEAu h\xF3a ho\xE0n t\u1EA5t \u2014 B\u1EA1n
      c\xF3 th\u1EC3 \u0103n"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389505
    m_Localized: "B\u1EA1n c\xF3 th\u1EC3 phun ra s\u1EE9c m\u1EA1nh c\u1EE7a nh\u1EEFng
      k\u1EBB th\xF9 \u0111\xE3 b\u1ECB \u0111\xE1nh b\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389506
    m_Localized: "B\u1EA1n c\xF3 th\u1EC3 nh\u1ED5 ra {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389507
    m_Localized: "X\xE1c s\u1ED1ng \u2014 V\u1EABn \u0111ang c\u1EA7m c\u1EF1"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389508
    m_Localized: "Cu\u1ED9c gi\u1EB1ng co tuy\u1EC7t v\u1ECDng cu\u1ED1i c\xF9ng
      {0} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389509
    m_Localized: "T\xF4i \u0111\xE3 s\u1EED d\u1EE5ng t\u1EA5t c\u1EA3 m\u1ECDi th\u1EE9."
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389510
    m_Localized: "T\xF4i \u0111\xE3 \u0111\u01B0\u1EE3c th\u0103ng ch\u1EE9c."
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389511
    m_Localized: "\u0110i\u1EC7n tho\u1EA1i {0} / {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389512
    m_Localized: "\u0110ang c\xF3 ch\u01B0\u01A1ng tr\xECnh khuy\u1EBFn m\xE3i!"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389513
    m_Localized: "V\u0169 kh\xED n\u1ED5i {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389514
    m_Localized: "Khe v\u0169 kh\xED {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389515
    m_Localized: "<b>T\xEDch \u0111i\u1EC7n b\xF3ng t\u1ED1i</b> \u2014 \u0110\xF2n
      t\u1EA5n c\xF4ng ti\u1EBFp theo c\u1EE7a v\u0169 kh\xED s\u1EBD l\xE0m t\u1ED1i
      m\u1EE5c ti\xEAu"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389516
    m_Localized: "B\xF3ng t\u1ED1i {0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389517
    m_Localized: "{0} tay \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389518
    m_Localized: "{0} l\xE1 b\xE0i \u0111\u01B0\u1EE3c \u0111\u1EB7t ra"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389519
    m_Localized: "Sao ch\xE9p {0} gi\xE2y \u2014 N\u1ED5 tung v\u1EDBi ch\xECa kh\xF3a
      t\u1ED1i th\u01B0\u1EE3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389520
    m_Localized: "r\u1ED3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389521
    m_Localized: "c\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389522
    m_Localized: "R\u1ED3ng huy\u1EC1n tho\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389523
    m_Localized: "{0} ph\xE1t b\u1EAFn m\u1ED7i gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389524
    m_Localized: "tr\xF2 ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389525
    m_Localized: "\u0111\u1ED9i"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389526
    m_Localized: "to\xE0n c\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389527
    m_Localized: "\u0110ang xem"
    m_Metadata:
      m_Items: []
  - m_Id: 16022278058389528
    m_Localized: "Nh\u1EADp tin nh\u1EAFn\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023742001152
    m_Localized: "Tr\u1EDF l\u1EA1i ti\xEAu \u0111\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749888
    m_Localized: "S\u1ED0 {0} - {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749889
    m_Localized: "Phi\xEAn b\u1EA3n gi\u1EDBi h\u1EA1n!"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749890
    m_Localized: "Phi\xEAn b\u1EA3n gi\u1EDBi h\u1EA1n! \u2014 Cho \u0111\u1EBFn
      khi c\xF3 s\u1EA3n ph\u1EA9m thay th\u1EBF ti\u1EBFp theo {0}:{1:00}"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749891
    m_Localized: "\u0110\u1EB7c bi\u1EC7t"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749892
    m_Localized: "\xE1o gi\xE1p"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749893
    m_Localized: "\xE1o gi\xE1p"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749894
    m_Localized: "to\xE0n b\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749895
    m_Localized: "Ch\u1EE3 \u0111en \u0111\xE3 m\u1EDF c\u1EEDa \u2014 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749896
    m_Localized: "Ch\u1EE3 \u0111en \u0111\xE3 \u0111\xF3ng c\u1EEDa v\xEC c\xF3
      ng\u01B0\u1EDDi \u0111\xE3 ho\xE0n t\u1EA5t giao d\u1ECBch."
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749897
    m_Localized: "M\u1ED9t giao d\u1ECBch duy nh\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749898
    m_Localized: "Ch\u1EE3 \u0111en \u0111\xE3 \u0111\xF3ng c\u1EEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749899
    m_Localized: "Ch\u1EE3 \u0111en \u2014 Hi\u1EC7n \u0111ang \u0111\xF3ng c\u1EEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749900
    m_Localized: "\u25C6 {0} Mua h\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749901
    m_Localized: "Hi\u1EC7n kh\xF4ng c\xF3 m\u1EB7t h\xE0ng n\xE0o \u0111\u01B0\u1EE3c
      b\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749902
    m_Localized: "B\xE1n h\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749903
    m_Localized: "m\u1EA5t t\xEDch"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749904
    m_Localized: "th\u1EF1c thi"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749905
    m_Localized: "H\xE0ng \u0111\u1ED9c quy\u1EC1n ch\u1EE3 \u0111en"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749906
    m_Localized: "ch\u1EE3 \u0111en"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749907
    m_Localized: "T\xF4i \u0111\xE3 mua phi\xEAn b\u1EA3n gi\u1EDBi h\u1EA1n n\xE0y
      r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749908
    m_Localized: "Th\xF4ng s\u1ED1 v\u0169 kh\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023779749909
    m_Localized: "Gi\u1EA3m thi\u1EC7t h\u1EA1i nh\u1EADn \u0111\u01B0\u1EE3c"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023788138496
    m_Localized: "s\u1EF1 ch\u1EADm l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023788138497
    m_Localized: "ch\xE1y"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023788138498
    m_Localized: "b\u1EE9c t\u01B0\u1EE3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023788138499
    m_Localized: "ni\xEAm phong"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023788138500
    m_Localized: "ng\u1EA5t x\u1EC9u"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023788138501
    m_Localized: "v\u1EBFt r\xE1ch"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023788138502
    m_Localized: "s\u1EF1 n\xE9 tr\xE1nh"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023788138503
    m_Localized: "Gi\u1EA3m qu\u1ED1c ph\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023788138504
    m_Localized: "b\xF3ng ma"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023788138505
    m_Localized: "M\u1EA5t \u0111i\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023788138506
    m_Localized: "s\u1EF1 tr\xF3i bu\u1ED9c"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023788138507
    m_Localized: "minh b\u1EA1ch"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023788138508
    m_Localized: "X\xE1c s\u1ED1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023788138509
    m_Localized: "l\u1EDDi nguy\u1EC1n"
    m_Metadata:
      m_Items: []
  - m_Id: 17144023788138510
    m_Localized: "suy y\u1EBFu"
    m_Metadata:
      m_Items: []
