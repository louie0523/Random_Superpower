      \uB3CC\uC9C4\uC758 \uC704\uB825\uC774 {b:BernhardChargePct}% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 15311903084097538
    m_Localized: "<b>\uC8FD\uC74C\uC758 \uBD88\uAE38</b> \u2014 \uD3ED\uBC1C\uC5D0
      \uB9DE\uC740 \uC801\uC5D0\uAC8C {b:DeathFlameTime}\uCD08\uAC04 \uB9E4\uCD08
      \uCD5C\uB300 \uCCB4\uB825\uC758 {b:DeathFlamePct}%\uC758 \uD53C\uD574\uB97C
      \uAC00\uD558\uB294 \uB9C9\uB300\uD55C \uD654\uC0C1\uC744 \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
