  - m_Id: 3001745490423812
    m_Localized: "\u0412\u044B \u2014 \u043C\u0430\u0441\u0442\u0435\u0440 \xAB\u041E\u0434\u0438\u043D
      \u0443\u0434\u0430\u0440\xBB.\n\n\u0411\u0443\u0434\u0443\u0447\u0438 \u043A\u043B\u0430\u0441\u0441\u043E\u043C,
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0449\u0438\u043C \u043E\u0440\u0443\u0436\u0438\u0435
      \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E \u0431\u043E\u044F, \u0432\u044B
      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0435\u0442\u0435 \u0432\u0440\u0430\u0433\u043E\u0432,
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F \u043C\u043E\u0449\u043D\u044B\u0439
      \u043D\u0430\u0432\u044B\u043A \xAB\u041E\u0434\u0438\u043D \u0443\u0434\u0430\u0440\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 3004699647782912
    m_Localized: "\u0434\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 3004699710697472
    m_Localized: "\u0434\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 3004699710697473
    m_Localized: "\u041F\u0440\u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0438
      \u0431\u0430\u0437\u043E\u0432\u043E\u0439 \u0430\u0442\u0430\u043A\u0438 \u043E\u0440\u0443\u0436\u0438\u0435\u043C
      \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E \u0431\u043E\u044F \u0432\u044B
      \u0441\u043E\u0432\u0435\u0440\u0448\u0430\u0435\u0442\u0435 \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0440\u044B\u0432\u043E\u043A \u0432\u043F\u0435\u0440\u0451\u0434, \u0431\u044B\u0441\u0442\u0440\u043E
      \u043D\u0430\u043D\u043E\u0441\u044F \u0443\u0434\u0430\u0440\u044B.\n\n\u0423\u0440\u043E\u043D
      \u043E\u0442 \u0431\u0430\u0437\u043E\u0432\u043E\u0439 \u0430\u0442\u0430\u043A\u0438
      \u043E\u0440\u0443\u0436\u0438\u0435\u043C \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E
      \u0431\u043E\u044F \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0434\u043E 400%.\n\n\u0414\u043B\u044F \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u0439
      \u0430\u0442\u0430\u043A\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u0448\u043A\u0430\u043B\u0443
      \xAB\u0423\u0431\u0438\u0439\u0441\u0442\u0432\u043E \u0441 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0443\u0434\u0430\u0440\u0430\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 3004699710697474
    m_Localized: "\u0428\u043A\u0430\u043B\u0430 \xAB\u041E\u0434\u043D\u043E\u0440\u0430\u0437\u043E\u0432\u044B\u0439
      \u0443\u0434\u0430\u0440\xBB \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442\u0441\u044F
      \u0441\u043E \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C\u044E 3% \u0432
      \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u0432\u043E \u0432\u0440\u0435\u043C\u044F
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0438 5% \u043F\u0440\u0438
      \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438 \u043F\u043E \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0443
