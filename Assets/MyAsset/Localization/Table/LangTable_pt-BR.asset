  - m_Id: 15217183930560554
    m_Localized: "Copiar c\xF3digo para a \xE1rea de transfer\xEAncia"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560555
    m_Localized: Colar
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560556
    m_Localized: "N\xE3o h\xE1 nenhum c\xF3digo de mira na \xE1rea de transfer\xEAncia."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560557
    m_Localized: "Restaurar para as configura\xE7\xF5es padr\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560558
    m_Localized: "Aplique o mesmo em outras armas tamb\xE9m."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560559
    m_Localized: "Sem restri\xE7\xF5es"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560560
    m_Localized: Carregando...
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560561
    m_Localized: "Teclado num\xE9rico {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560562
    m_Localized: preparando
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560563
    m_Localized: "Pressione a tecla\u2026 (Esc Cancelar)"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560564
    m_Localized: (diretamente)
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560565
    m_Localized: completo!
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560566
    m_Localized: Pressione mais uma vez para reiniciar
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560567
    m_Localized: "No\xE7\xF5es b\xE1sicas do sistema"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560568
    m_Localized: contexto
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560569
    m_Localized: Fechar (Esc)
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560570
    m_Localized: "A tecla de voz est\xE1 na aba 'Chat \xB7 Voz'."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560571
    m_Localized: pistola
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560572
    m_Localized: "Arco \xB7 Cajado"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560573
    m_Localized: "vizinhan\xE7a"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560574
    m_Localized: "A op\xE7\xE3o [Mesma mira em todas as armas] est\xE1 ativada, portanto
      todas as miras ser\xE3o usadas."
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560575
    m_Localized: "Alterar plano de fundo da pr\xE9-visualiza\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560576
    m_Localized: "Veja o movimento em expans\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560577
    m_Localized: "Copiar c\xF3digo"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560578
    m_Localized: "Cole o c\xF3digo"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560579
    m_Localized: "Com esta arma como padr\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560580
    m_Localized: O mesmo se aplica a outras armas.
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560581
    m_Localized: menu
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560582
    m_Localized: Continuar
    m_Metadata:
      m_Items: []
  - m_Id: 15217183930560583
    m_Localized: contexto
    m_Metadata:
      m_Items: []
