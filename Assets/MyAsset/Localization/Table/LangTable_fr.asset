    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837760
    m_Localized: "Ralentit la vitesse de d\xE9placement de la cible de {v0}% pendant
      {d0} secondes."
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837761
    m_Localized: "br\xFBler"
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837762
    m_Localized: "Inflige <color=orange>Br\xFBlure</color> \xE0 la cible pendant
      {d0} secondes, infligeant des d\xE9g\xE2ts fixes \xE9gaux \xE0 {v0}% de la
      sant\xE9 maximale chaque seconde."
    m_Metadata:
      m_Items: []
  - m_Id: 5227191342837763
