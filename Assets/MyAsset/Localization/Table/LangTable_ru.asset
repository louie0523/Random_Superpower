      m_Items: []
  - m_Id: 15224945326534690
    m_Localized: "\u0417\u0430\u0432\u0435\u0449\u0430\u043D\u0438\u0435 \u0411\u0435\u043E\u043C\u0433\u043E\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534691
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u0432\u0430\u0448\u0435\u0433\u043E \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
      \u043F\u0430\u0434\u0430\u0435\u0442 \u0434\u043E 1 \u0438\u043B\u0438 \u043C\u0435\u043D\u044C\u0448\u0435,
      \u0432\u044B \u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435
      \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0435 \u0431\u043E\u043D\u0443\u0441\u044B
      \u043A \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430\u043C
      \u0438 \u043D\u0435 \u0443\u043C\u0438\u0440\u0430\u0435\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534692
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u0432\u0430\u0448\u0435\u0433\u043E \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
      \u043F\u0430\u0434\u0430\u0435\u0442 \u0434\u043E 1 \u0438\u043B\u0438 \u043C\u0435\u043D\u044C\u0448\u0435,
      \u0432\u044B \u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435
      \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0435 \u0431\u043E\u043D\u0443\u0441\u044B
      \u043A \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430\u043C
      \u0438 \u043D\u0435 \u0443\u043C\u0438\u0440\u0430\u0435\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534693
    m_Localized: "\u0443\u0431\u0438\u0439\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534694
    m_Localized: "\u0423\u0440\u043E\u043D, \u043D\u0430\u043D\u043E\u0441\u0438\u043C\u044B\u0439
      \u0446\u0435\u043B\u044F\u043C, \u043A\u043E\u0433\u0434\u0430 \u043E\u043D\u0438
      \u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u043D\u0430 \u0432\u0430\u0441,
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 100%.\n\n\u041F\u0440\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u044B\u043C
      \u043D\u0430 3 \u0441\u0435\u043A\u0443\u043D\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534695
    m_Localized: "\u041D\u0435\u0432\u0438\u0434\u0438\u043C\u044B\u0439 \u043F\u043B\u0430\u0449"
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534696
    m_Localized: "\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0440\u0435\u0448\u0438\u0442\u044C,
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u043B\u0438
      \u041F\u043B\u0430\u0449-\u043D\u0435\u0432\u0438\u0434\u0438\u043C\u043A\u0443,
      \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043D\u0430\u0432\u044B\u043A\u0430.\n\n\u0412\u043E
      \u0432\u0440\u0435\u043C\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
      \u041F\u043B\u0430\u0449\u0430-\u043D\u0435\u0432\u0438\u0434\u0438\u043C\u043A\u0438
      \u0432\u044B \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C
      \xAB\u043D\u0435\u0432\u0438\u0434\u0438\u043C\u044B\u043C\xBB, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u0432\u0430\u0448\u0435 \u0442\u0435\u043B\u043E (\u0437\u0430 \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C
      \u043E\u0440\u0443\u0436\u0438\u044F) \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u043E,
      \u043D\u043E \u043D\u0430\u043D\u043E\u0441\u0438\u043C\u044B\u0439 \u0443\u0440\u043E\u043D
      \u0441\u043D\u0438\u0436\u0430\u0435\u0442\u0441\u044F \u043D\u0430 50%."
    m_Metadata:
      m_Items: []
  - m_Id: 15224945326534698
    m_Localized: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043C\u0435\u043D\u044F
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u0442."
